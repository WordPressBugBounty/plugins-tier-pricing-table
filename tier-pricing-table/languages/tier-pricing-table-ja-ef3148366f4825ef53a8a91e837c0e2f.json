67\u306e\u30d5\u30a1\u30a4\u30eb\u3092\u53d7\u3051\u4ed8\u3051\u307e\u3059\u3002"],"Leave blank for no limit of its own (the server's upload limit still applies).":["\u72ec\u81ea\u306e\u5236\u9650\u3092\u8a2d\u3051\u306a\u3044\u5834\u5408\u306f\u7a7a\u767d\u306b\u3057\u3066\u304f\u3060\u3055\u3044\uff08\u30b5\u30fc\u30d0\u30fc\u306e\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u5236\u9650\u306f\u5f15\u304d\u7d9a\u304d\u9069\u7528\u3055\u308c\u307e\u3059\uff09\u3002"],"Disable past dates":["\u904e\u53bb\u306e\u65e5\u4ed8\u3092\u7121\u52b9\u306b\u3059\u308b"],"Prevent customers from selecting dates in the past.":["\u9867\u5ba2\u304c\u904e\u53bb\u306e\u65e5\u4ed8\u3092\u9078\u629e\u3067\u304d\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3059\u3002"],"No fields added yet. Select a field type below to add one.":["\u307e\u3060\u30d5\u30a3\u30fc\u30eb\u30c9\u306f\u8ffd\u52a0\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002\u8ffd\u52a0\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u30d5\u30a3\u30fc\u30eb\u30c9 \u30bf\u30a4\u30d7\u3092\u9078\u629e\u3057\u307e\u3059\u3002"],"Drag to reorder":["\u30c9\u30e9\u30c3\u30b0\u3057\u3066\u4e26\u3079\u66ff\u3048\u307e\u3059"],"Close %s":["%s\u3092\u9589\u3058\u308b"],"Edit %s":["%s\u3092\u7de8\u96c6"],"More\u2026":["\u305d\u306e\u4ed6\u2026"],"\u201c%s\u201d removed.":["\u300c%s\u300d\u3092\u524a\u9664\u3057\u307e\u3057\u305f\u3002"],"Undo":["\u5143\u306b\u623b\u3059"],"Request a Quote on the frontend is a premium feature. You can preview it as an administrator, but upgrading is required for your customers to use it.":["\u30d5\u30ed\u30f3\u30c8\u30a8\u30f3\u30c9\u3067\u306e\u898b\u7a4d\u4f9d\u983c\u306f\u30d7\u30ec\u30df\u30a2\u30e0\u6a5f\u80fd\u3067\u3059\u3002\u7ba1\u7406\u8005\u3068\u3057\u3066\u30d7\u30ec\u30d3\u30e5\u30fc\u3067\u304d\u307e\u3059\u304c\u3001\u9867\u5ba2\u304c\u4f7f\u7528\u3059\u308b\u306b\u306f\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u304c\u5fc5\u8981\u3067\u3059\u3002"],"Back":["\u623b\u308b"],"Edit Form:":["\u30d5\u30a9\u30fc\u30e0\u3092\u7de8\u96c6:"],"Save Form":["\u30d5\u30a9\u30fc\u30e0\u3092\u4fdd\u5b58"],"Show this form on":["\u3053\u306e\u30d5\u30a9\u30fc\u30e0\u306e\u8868\u793a\u5148"],"Products and pricing rules that choose it":["\u3053\u306e\u30d5\u30a9\u30fc\u30e0\u3092\u9078\u629e\u3057\u3066\u3044\u308b\u5546\u54c1\u3068\u4fa1\u683c\u8a2d\u5b9a\u30eb\u30fc\u30eb"],"Choose this form on a product (General tab, \"Request a Quote Form\", below the tiered prices) or in a global pricing rule.":["\u3053\u306e\u30d5\u30a9\u30fc\u30e0\u306f\u3001\u5546\u54c1\uff08\u300c\u4e00\u822c\u300d\u30bf\u30d6\u306e\u3001\u6bb5\u968e\u4fa1\u683c\u306e\u4e0b\u306b\u3042\u308b\u300c\u898b\u7a4d\u3082\u308a\u30ea\u30af\u30a8\u30b9\u30c8\u30d5\u30a9\u30fc\u30e0\u300d\uff09\u307e\u305f\u306f\u30b0\u30ed\u30fc\u30d0\u30eb\u4fa1\u683c\u8a2d\u5b9a\u30eb\u30fc\u30eb\u3067\u9078\u629e\u3057\u307e\u3059\u3002"],"A form chosen on a product or in a global pricing rule still wins there. If several forms cover a product, the one that names the product wins, then the one for its category, then the one for all products.":["\u5546\u54c1\u307e\u305f\u306f\u30b0\u30ed\u30fc\u30d0\u30eb\u4fa1\u683c\u8a2d\u5b9a\u30eb\u30fc\u30eb\u3067\u9078\u629e\u3057\u305f\u30d5\u30a9\u30fc\u30e0\u304c\u3001\u5f15\u304d\u7d9a\u304d\u512a\u5148\u3055\u308c\u307e\u3059\u3002\u8907\u6570\u306e\u30d5\u30a9\u30fc\u30e0\u304c\u5546\u54c1\u306b\u8a72\u5f53\u3059\u308b\u5834\u5408\u306f\u3001\u5546\u54c1\u3092\u6307\u5b9a\u3057\u305f\u30d5\u30a9\u30fc\u30e0\u3001\u6b21\u306b\u30ab\u30c6\u30b4\u30ea\u30fc\u306e\u30d5\u30a9\u30fc\u30e0\u3001\u6700\u5f8c\u306b\u3059\u3079\u3066\u306e\u5546\u54c1\u306e\u30d5\u30a9\u30fc\u30e0\u306e\u9806\u306b\u512a\u5148\u3055\u308c\u307e\u3059\u3002"],"Chosen on %d product or pricing rule.":["%d\u500b\u306e\u5546\u54c1\u307e\u305f\u306f\u4fa1\u683c\u8a2d\u5b9a\u30eb\u30fc\u30eb\u3067\u9078\u629e\u3055\u308c\u3066\u3044\u307e\u3059\u3002"],"No product or pricing rule has chosen this form yet, so customers do not see it.":["\u3053\u306e\u30d5\u30a9\u30fc\u30e0\u3092\u9078\u629e\u3057\u3066\u3044\u308b\u5546\u54c1\u3084\u4fa1\u683c\u8a2d\u5b9a\u30eb\u30fc\u30eb\u304c\u307e\u3060\u306a\u3044\u305f\u3081\u3001\u9867\u5ba2\u306b\u306f\u8868\u793a\u3055\u308c\u307e\u305b\u3093\u3002"],"Search categories":["\u30ab\u30c6\u30b4\u30ea\u30fc\u3092\u691c\u7d22"],"Their subcategories are included.":["\u30b5\u30d6\u30ab\u30c6\u30b4\u30ea\u30fc\u3082\u542b\u307e\u308c\u307e\u3059\u3002"],"Search by name or SKU":["\u540d\u524d\u307e\u305f\u306fSKU\u3067\u691c\u7d22"],"A product with variations covers all of them.":["\u30d0\u30ea\u30a8\u30fc\u30b7\u30e7\u30f3\u306e\u3042\u308b\u5546\u54c1\u306f\u3001\u305d\u306e\u3059\u3079\u3066\u306e\u30d0\u30ea\u30a8\u30fc\u30b7\u30e7\u30f3\u304c\u5bfe\u8c61\u3067\u3059\u3002"],"Except these products":["\u3053\u308c\u3089\u306e\u5546\u54c1\u3092\u9664\u304f"],"Customer roles":["\u9867\u5ba2\u306e\u5f79\u5272"],"Leave empty to show the form to everyone.":["\u7a7a\u306e\u307e\u307e\u306b\u3059\u308b\u3068\u3001\u5168\u54e1\u306b\u30d5\u30a9\u30fc\u30e0\u3092\u8868\u793a\u3057\u307e\u3059\u3002"],"A product without a pricing layout (no price tiers, or no price at all) shows the button by itself under the price. So does the Tooltip layout.":["\u4fa1\u683c\u30ec\u30a4\u30a2\u30a6\u30c8\u306e\u306a\u3044\u5546\u54c1\uff08\u4fa1\u683c\u968e\u5c64\u304c\u306a\u3044\u3001\u307e\u305f\u306f\u4fa1\u683c\u304c\u306a\u3044\uff09\u3067\u306f\u3001\u4fa1\u683c\u306e\u4e0b\u306b\u30dc\u30bf\u30f3\u3060\u3051\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u30c4\u30fc\u30eb\u30c1\u30c3\u30d7\u30ec\u30a4\u30a2\u30a6\u30c8\u3082\u540c\u69d8\u3067\u3059\u3002"],"Quote requests":["\u898b\u7a4d\u3082\u308a\u30ea\u30af\u30a8\u30b9\u30c8"],"Customers request a quote for":["\u9867\u5ba2\u304c\u898b\u7a4d\u3082\u308a\u3092\u30ea\u30af\u30a8\u30b9\u30c8\u3059\u308b\u5bfe\u8c61"],"Individual products":["\u500b\u5225\u306e\u5546\u54c1"],"Quote buttons add the product to the quote list. Customers send one request for all of them from the quote list page.":["\u898b\u7a4d\u3082\u308a\u30dc\u30bf\u30f3\u3067\u5546\u54c1\u3092\u898b\u7a4d\u3082\u308a\u30ea\u30b9\u30c8\u306b\u8ffd\u52a0\u3057\u307e\u3059\u3002\u9867\u5ba2\u306f\u3001\u898b\u7a4d\u3082\u308a\u30ea\u30b9\u30c8\u306e\u30da\u30fc\u30b8\u304b\u3089\u3001\u307e\u3068\u3081\u30661\u4ef6\u306e\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u9001\u4fe1\u3057\u307e\u3059\u3002"],"Each quote button opens this form for its product.":["\u5404\u898b\u7a4d\u3082\u308a\u30dc\u30bf\u30f3\u306f\u3001\u305d\u306e\u5546\u54c1\u7528\u306b\u3053\u306e\u30d5\u30a9\u30fc\u30e0\u3092\u958b\u304d\u307e\u3059\u3002"],"The quote list needs a page first. Until it has one, the quote list stays off.":["\u898b\u7a4d\u3082\u308a\u30ea\u30b9\u30c8\u306b\u306f\u3001\u307e\u305a\u30da\u30fc\u30b8\u304c\u5fc5\u8981\u3067\u3059\u3002\u30da\u30fc\u30b8\u3092\u8a2d\u5b9a\u3059\u308b\u307e\u3067\u3001\u898b\u7a4d\u3082\u308a\u30ea\u30b9\u30c8\u306f\u30aa\u30d5\u306e\u307e\u307e\u3067\u3059\u3002"],"Appearance & Content":["\u5916\u89b3\u3068\u5185\u5bb9"],"The text of the button that opens this form.":["\u3053\u306e\u30d5\u30a9\u30fc\u30e0\u3092\u958b\u304f\u30dc\u30bf\u30f3\u306e\u30c6\u30ad\u30b9\u30c8\u3067\u3059\u3002"],"Where the button shows":["\u30dc\u30bf\u30f3\u306e\u8868\u793a\u5834\u6240"],"Inside means the last row of a table, one more block, option or line of text, or a strip under a horizontal table, depending on the pricing layout.":["\u300c\u5185\u5074\u300d\u306f\u3001\u4fa1\u683c\u30ec\u30a4\u30a2\u30a6\u30c8\u306b\u5fdc\u3058\u3066\u3001\u8868\u306e\u6700\u7d42\u884c\u3001\u8ffd\u52a0\u306e\u30d6\u30ed\u30c3\u30af\u3001\u30aa\u30d7\u30b7\u30e7\u30f3\u3001\u30c6\u30ad\u30b9\u30c8\u884c\u3001\u307e\u305f\u306f\u6a2a\u578b\u306e\u8868\u306e\u4e0b\u306e\u5e2f\u3092\u6307\u3057\u307e\u3059\u3002"],"Button style":["\u30dc\u30bf\u30f3\u306e\u30b9\u30bf\u30a4\u30eb"],"Outlined (secondary)":["\u30a2\u30a6\u30c8\u30e9\u30a4\u30f3\uff08\u30bb\u30ab\u30f3\u30c0\u30ea\uff09"],"Filled (like Add to cart)":["\u5857\u308a\u3064\u3076\u3057\uff08\u30ab\u30fc\u30c8\u306b\u8ffd\u52a0\u3068\u540c\u3058\uff09"],"Text link":["\u30c6\u30ad\u30b9\u30c8\u30ea\u30f3\u30af"],"Outlined keeps \"Add to cart\" the main action of the product page. Inside the Blocks layout the whole block is the button; inside the Plain text layout it is a text link.":["\u30a2\u30a6\u30c8\u30e9\u30a4\u30f3\u306b\u3059\u308b\u3068\u3001\u5546\u54c1\u30da\u30fc\u30b8\u306e\u4e3b\u306a\u64cd\u4f5c\u306f\u300c\u30ab\u30fc\u30c8\u306b\u8ffd\u52a0\u300d\u306e\u307e\u307e\u306b\u306a\u308a\u307e\u3059\u3002\u30d6\u30ed\u30c3\u30af\u30ec\u30a4\u30a2\u30a6\u30c8\u306e\u5185\u5074\u3067\u306f\u30d6\u30ed\u30c3\u30af\u5168\u4f53\u304c\u30dc\u30bf\u30f3\u306b\u306a\u308a\u3001\u30d7\u30ec\u30fc\u30f3\u30c6\u30ad\u30b9\u30c8\u30ec\u30a4\u30a2\u30a6\u30c8\u306e\u5185\u5074\u3067\u306f\u30c6\u30ad\u30b9\u30c8\u30ea\u30f3\u30af\u306b\u306a\u308a\u307e\u3059\u3002"],"Outlined keeps \"Add to cart\" the main action of the product page.":["\u30a2\u30a6\u30c8\u30e9\u30a4\u30f3\u306b\u3059\u308b\u3068\u3001\u5546\u54c1\u30da\u30fc\u30b8\u306e\u4e3b\u306a\u64cd\u4f5c\u306f\u300c\u30ab\u30fc\u30c8\u306b\u8ffd\u52a0\u300d\u306e\u307e\u307e\u306b\u306a\u308a\u307e\u3059\u3002"],"This form still uses the theme's main button, as before button styles existed. An outlined button stands out less than \"Add to cart\".":["\u3053\u306e\u30d5\u30a9\u30fc\u30e0\u306f\u3001\u30dc\u30bf\u30f3\u30b9\u30bf\u30a4\u30eb\u304c\u5c0e\u5165\u3055\u308c\u308b\u524d\u3068\u540c\u3058\u304f\u3001\u30c6\u30fc\u30de\u306e\u30e1\u30a4\u30f3\u30dc\u30bf\u30f3\u3092\u4f7f\u3063\u3066\u3044\u307e\u3059\u3002\u30a2\u30a6\u30c8\u30e9\u30a4\u30f3\u306e\u30dc\u30bf\u30f3\u306f\u300c\u30ab\u30fc\u30c8\u306b\u8ffd\u52a0\u300d\u307b\u3069\u76ee\u7acb\u3061\u307e\u305b\u3093\u3002"],"Use the outlined button":["\u30a2\u30a6\u30c8\u30e9\u30a4\u30f3\u306e\u30dc\u30bf\u30f3\u3092\u4f7f\u7528"],"Hide Add to Cart button":["\u300c\u30ab\u30fc\u30c8\u306b\u8ffd\u52a0\u300d\u30dc\u30bf\u30f3\u3092\u975e\u8868\u793a\u306b\u3059\u308b"],"The product is sold on request only: Add to cart is hidden and the product cannot be added to the cart from anywhere.":["\u3053\u306e\u5546\u54c1\u306f\u3054\u4f9d\u983c\u304c\u3042\u3063\u305f\u5834\u5408\u306e\u307f\u8ca9\u58f2\u3055\u308c\u307e\u3059\u3002\u30ab\u30fc\u30c8\u306b\u8ffd\u52a0\u306f\u975e\u8868\u793a\u306b\u306a\u308a\u3001\u3069\u3053\u304b\u3089\u3082\u3053\u306e\u5546\u54c1\u3092\u30ab\u30fc\u30c8\u306b\u8ffd\u52a0\u3067\u304d\u307e\u305b\u3093\u3002"],"Show for non-purchasable products":["\u8cfc\u5165\u3067\u304d\u306a\u3044\u5546\u54c1\u3092\u8868\u793a\u3059\u308b"],"Display the Quote button even if the product does not have a price or is out of stock.":["\u4fa1\u683c\u306e\u306a\u3044\u5546\u54c1\u3084\u5728\u5eab\u5207\u308c\u306e\u5546\u54c1\u3067\u3082\u898b\u7a4d\u30dc\u30bf\u30f3\u3092\u8868\u793a\u3057\u307e\u3059\u3002"],"Label in the pricing layout":["\u4fa1\u683c\u30ec\u30a4\u30a2\u30a6\u30c8\u5185\u306e\u30e9\u30d9\u30eb"],"The text of the quote entry, where the other rows, blocks or options show a quantity. Keep it short: blocks are narrow.":["\u898b\u7a4d\u3082\u308a\u9805\u76ee\u306e\u30c6\u30ad\u30b9\u30c8\u3067\u3059\u3002\u4ed6\u306e\u884c\u3001\u30d6\u30ed\u30c3\u30af\u3001\u30aa\u30d7\u30b7\u30e7\u30f3\u306b\u306f\u6570\u91cf\u304c\u8868\u793a\u3055\u308c\u308b\u5834\u6240\u306b\u3042\u305f\u308a\u307e\u3059\u3002\u30d6\u30ed\u30c3\u30af\u306f\u5e45\u304c\u72ed\u3044\u305f\u3081\u3001\u77ed\u304f\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Popup title":["\u30dd\u30c3\u30d7\u30a2\u30c3\u30d7\u306e\u30bf\u30a4\u30c8\u30eb"],"Send button text":["\u9001\u4fe1\u30dc\u30bf\u30f3\u306e\u30c6\u30ad\u30b9\u30c8"],"Note under the send button":["\u9001\u4fe1\u30dc\u30bf\u30f3\u306e\u4e0b\u306e\u6ce8\u8a18"],"A line that reassures: what happens next, how soon you reply. Leave blank for none.":["\u6b21\u306b\u4f55\u304c\u8d77\u3053\u308b\u304b\u3001\u3069\u306e\u304f\u3089\u3044\u3067\u8fd4\u4fe1\u3059\u308b\u304b\u306a\u3069\u3001\u5b89\u5fc3\u3057\u3066\u3044\u305f\u3060\u304f\u305f\u3081\u306e\u4e00\u6587\u3067\u3059\u3002\u4e0d\u8981\u306a\u5834\u5408\u306f\u7a7a\u767d\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Open the form from a quantity":["\u6570\u91cf\u306b\u5fdc\u3058\u3066\u30d5\u30a9\u30fc\u30e0\u3092\u958b\u304f"],"The form opens by itself when a customer chooses this quantity or more. Leave blank to switch this off.":["\u9867\u5ba2\u304c\u3053\u306e\u6570\u91cf\u4ee5\u4e0a\u3092\u9078\u3076\u3068\u3001\u30d5\u30a9\u30fc\u30e0\u304c\u81ea\u52d5\u7684\u306b\u958b\u304d\u307e\u3059\u3002\u30aa\u30d5\u306b\u3059\u308b\u306b\u306f\u7a7a\u767d\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Email Notifications":["\u96fb\u5b50\u30e1\u30fc\u30eb\u901a\u77e5"],"Enable Admin Email":["\u7ba1\u7406\u8005\u306e\u96fb\u5b50\u30e1\u30fc\u30eb\u3092\u6709\u52b9\u306b\u3059\u308b"],"Send an email to the store admin when this form is submitted.":["\u3053\u306e\u30d5\u30a9\u30fc\u30e0\u3092\u9001\u4fe1\u3057\u305f\u3089\u3001\u30b9\u30c8\u30a2\u7ba1\u7406\u8005\u306b\u30e1\u30fc\u30eb\u3092\u9001\u4fe1\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Enable Customer Email":["\u9867\u5ba2\u306e\u96fb\u5b50\u30e1\u30fc\u30eb\u3092\u6709\u52b9\u306b\u3059\u308b"],"Send an acknowledgment email to the customer.":["\u9867\u5ba2\u306b\u78ba\u8a8d\u30e1\u30fc\u30eb\u3092\u9001\u4fe1\u3057\u307e\u3059\u3002"],"Manage Email Templates \u2197":["\u30e1\u30fc\u30eb\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u306e\u7ba1\u7406 \u2197"],"Success Actions":["\u6210\u529f\u306e\u30a2\u30af\u30b7\u30e7\u30f3"],"After Submission":["\u63d0\u51fa\u5f8c"],"Show Message":["\u30e1\u30c3\u30bb\u30fc\u30b8\u3092\u8868\u793a"],"Redirect to URL":["URL\u306b\u30ea\u30c0\u30a4\u30ec\u30af\u30c8"],"Success Message":["\u6210\u529f\u30e1\u30c3\u30bb\u30fc\u30b8"],"Message shown after successful submission.":["\u9001\u4fe1\u304c\u6210\u529f\u3057\u305f\u5f8c\u306b\u8868\u793a\u3055\u308c\u308b\u30e1\u30c3\u30bb\u30fc\u30b8\u3002"],"Redirect URL":["\u30ea\u30c0\u30a4\u30ec\u30af\u30c8URL"],"Enter the full URL (e.g., https:\/\/example.com\/thank-you)":["\u5b8c\u5168\u306a URL \u3092\u5165\u529b\u3057\u307e\u3059 (\u4f8b: https:\/\/example.com\/thank-you)"],"Form name":["\u30d5\u30a9\u30fc\u30e0\u540d"],"Add form title":["\u30d5\u30a9\u30fc\u30e0\u306e\u30bf\u30a4\u30c8\u30eb\u3092\u8ffd\u52a0"],"Preview":["\u30d7\u30ec\u30d3\u30e5\u30fc"],"Give the form a name to save it. It is how you find the form in the list and on products.":["\u30d5\u30a9\u30fc\u30e0\u3092\u4fdd\u5b58\u3059\u308b\u306b\u306f\u540d\u524d\u3092\u4ed8\u3051\u3066\u304f\u3060\u3055\u3044\u3002\u4e00\u89a7\u3084\u5546\u54c1\u3067\u30d5\u30a9\u30fc\u30e0\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306e\u540d\u524d\u306b\u306a\u308a\u307e\u3059\u3002"],"Form Fields":["\u30d5\u30a9\u30fc\u30e0\u30d5\u30a3\u30fc\u30eb\u30c9"],"Customers collect several products with the quote buttons, then send one request for all of them from the quote list page.":["\u9867\u5ba2\u306f\u898b\u7a4d\u3082\u308a\u30dc\u30bf\u30f3\u3067\u8907\u6570\u306e\u5546\u54c1\u3092\u96c6\u3081\u3001\u898b\u7a4d\u3082\u308a\u30ea\u30b9\u30c8\u306e\u30da\u30fc\u30b8\u304b\u3089\u307e\u3068\u3081\u30661\u4ef6\u306e\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u9001\u4fe1\u3057\u307e\u3059\u3002"],"Forms for multiple products:":["\u8907\u6570\u306e\u5546\u54c1\u7528\u306e\u30d5\u30a9\u30fc\u30e0\uff1a"],"No form uses the quote list yet. Open a form and choose \"Multiple products\" under Quote requests; forms for individual products keep opening for one product.":["\u898b\u7a4d\u3082\u308a\u30ea\u30b9\u30c8\u3092\u4f7f\u3046\u30d5\u30a9\u30fc\u30e0\u306f\u307e\u3060\u3042\u308a\u307e\u305b\u3093\u3002\u30d5\u30a9\u30fc\u30e0\u3092\u958b\u304d\u3001\u898b\u7a4d\u3082\u308a\u30ea\u30af\u30a8\u30b9\u30c8\u306e\u300c\u8907\u6570\u306e\u5546\u54c1\u300d\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u500b\u5225\u306e\u5546\u54c1\u7528\u306e\u30d5\u30a9\u30fc\u30e0\u306f\u3001\u5f15\u304d\u7d9a\u304d1\u3064\u306e\u5546\u54c1\u7528\u306b\u958b\u304d\u307e\u3059\u3002"],"Quote list page":["\u898b\u7a4d\u3082\u308a\u30ea\u30b9\u30c8\u306e\u30da\u30fc\u30b8"],"Loading pages\u2026":["\u30da\u30fc\u30b8\u3092\u8aad\u307f\u8fbc\u307f\u4e2d\u2026"],"View the page":["\u30da\u30fc\u30b8\u3092\u8868\u793a"],"The page shows the list and the form. Any page with the [tiered_pricing_quote_list] shortcode works.":["\u3053\u306e\u30da\u30fc\u30b8\u306b\u306f\u30ea\u30b9\u30c8\u3068\u30d5\u30a9\u30fc\u30e0\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002[tiered_pricing_quote_list]\u30b7\u30e7\u30fc\u30c8\u30b3\u30fc\u30c9\u3092\u542b\u3080\u4efb\u610f\u306e\u30da\u30fc\u30b8\u3067\u3082\u52d5\u4f5c\u3057\u307e\u3059\u3002"],"This page has no quote list on it. Add the [tiered_pricing_quote_list] shortcode to the page, or choose another page.":["\u3053\u306e\u30da\u30fc\u30b8\u306b\u306f\u898b\u7a4d\u3082\u308a\u30ea\u30b9\u30c8\u304c\u3042\u308a\u307e\u305b\u3093\u3002\u30da\u30fc\u30b8\u306b [tiered_pricing_quote_list] \u30b7\u30e7\u30fc\u30c8\u30b3\u30fc\u30c9\u3092\u8ffd\u52a0\u3059\u308b\u304b\u3001\u5225\u306e\u30da\u30fc\u30b8\u3092\u9078\u3093\u3067\u304f\u3060\u3055\u3044\u3002"],"The quote list stays off until it has a page.":["\u30da\u30fc\u30b8\u304c\u8a2d\u5b9a\u3055\u308c\u308b\u307e\u3067\u3001\u898b\u7a4d\u3082\u308a\u30ea\u30b9\u30c8\u306f\u30aa\u30d5\u306e\u307e\u307e\u3067\u3059\u3002"],"Form on the quote list page":["\u898b\u7a4d\u3082\u308a\u30ea\u30b9\u30c8\u306e\u30da\u30fc\u30b8\u306e\u30d5\u30a9\u30fc\u30e0"],"The first form for multiple products":["\u8907\u6570\u306e\u5546\u54c1\u7528\u306e\u6700\u521d\u306e\u30d5\u30a9\u30fc\u30e0"],"Its quantity field is left out: each product in the list has its own quantity.":["\u6570\u91cf\u6b04\u306f\u542b\u307e\u308c\u307e\u305b\u3093\u3002\u30ea\u30b9\u30c8\u5185\u306e\u5404\u5546\u54c1\u306b\u72ec\u81ea\u306e\u6570\u91cf\u304c\u3042\u308b\u305f\u3081\u3067\u3059\u3002"],"Show estimated prices in the list":["\u30ea\u30b9\u30c8\u306b\u6982\u7b97\u4fa1\u683c\u3092\u8868\u793a"],"Each customer sees their own tier price for the quantity in the list. Never shown to visitors you hide prices from.":["\u5404\u9867\u5ba2\u306b\u3001\u30ea\u30b9\u30c8\u5185\u306e\u6570\u91cf\u306b\u5fdc\u3058\u305f\u305d\u306e\u9867\u5ba2\u306e\u968e\u5c64\u4fa1\u683c\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u4fa1\u683c\u3092\u975e\u8868\u793a\u306b\u3057\u3066\u3044\u308b\u8a2a\u554f\u8005\u306b\u306f\u8868\u793a\u3055\u308c\u307e\u305b\u3093\u3002"],"\"Add to quote\" on shop and category pages":["\u30b7\u30e7\u30c3\u30d7\u3068\u30ab\u30c6\u30b4\u30ea\u30fc\u30da\u30fc\u30b8\u306e\u300c\u898b\u7a4d\u3082\u308a\u306b\u8ffd\u52a0\u300d"],"For products whose quote form is for multiple products. Products with options are added from their own page.":["\u898b\u7a4d\u3082\u308a\u30d5\u30a9\u30fc\u30e0\u304c\u8907\u6570\u306e\u5546\u54c1\u7528\u306b\u8a2d\u5b9a\u3055\u308c\u305f\u5546\u54c1\u304c\u5bfe\u8c61\u3067\u3059\u3002\u30aa\u30d7\u30b7\u30e7\u30f3\u306e\u3042\u308b\u5546\u54c1\u306f\u3001\u305d\u306e\u5546\u54c1\u306e\u30da\u30fc\u30b8\u304b\u3089\u8ffd\u52a0\u3057\u307e\u3059\u3002"],"Floating \"Quote list\" button":["\u30d5\u30ed\u30fc\u30c6\u30a3\u30f3\u30b0\u306e\u300c\u898b\u7a4d\u3082\u308a\u30ea\u30b9\u30c8\u300d\u30dc\u30bf\u30f3"],"Shows while the list has products. For a link in your header or menu, use the [tiered_pricing_quote_list_link] shortcode.":["\u30ea\u30b9\u30c8\u306b\u5546\u54c1\u304c\u3042\u308b\u9593\u3001\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u30d8\u30c3\u30c0\u30fc\u3084\u30e1\u30cb\u30e5\u30fc\u306b\u30ea\u30f3\u30af\u3092\u7f6e\u304f\u306b\u306f\u3001[tiered_pricing_quote_list_link]\u30b7\u30e7\u30fc\u30c8\u30b3\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"\"Request a quote for this cart\" on the cart page":["\u30ab\u30fc\u30c8\u30da\u30fc\u30b8\u306e\u300c\u3053\u306e\u30ab\u30fc\u30c8\u306e\u898b\u7a4d\u3082\u308a\u3092\u30ea\u30af\u30a8\u30b9\u30c8\u300d"],"Copies the cart into the quote list. The cart itself stays as it is.":["\u30ab\u30fc\u30c8\u306e\u5185\u5bb9\u3092\u898b\u7a4d\u3082\u308a\u30ea\u30b9\u30c8\u306b\u30b3\u30d4\u30fc\u3057\u307e\u3059\u3002\u30ab\u30fc\u30c8\u81ea\u4f53\u306f\u305d\u306e\u307e\u307e\u3067\u3059\u3002"],"Anti-Spam (reCAPTCHA v3)":["\u30b9\u30d1\u30e0\u5bfe\u7b56 (reCAPTCHA v3)"],"Configure Google reCAPTCHA v3 to protect all quote forms from spam. Leave blank to disable.":["\u3059\u3079\u3066\u306e\u898b\u7a4d\u30d5\u30a9\u30fc\u30e0\u3092\u30b9\u30d1\u30e0\u304b\u3089\u4fdd\u8b77\u3059\u308b\u305f\u3081\u306b Google reCAPTCHA v3 \u3092\u69cb\u6210\u3057\u307e\u3059\u3002\u7121\u52b9\u306b\u3059\u308b\u306b\u306f\u7a7a\u767d\u306e\u307e\u307e\u306b\u3057\u307e\u3059\u3002"],"Site Key":["\u30b5\u30a4\u30c8\u30ad\u30fc"],"Secret Key":["\u79d8\u5bc6\u9375"],"Lowest score accepted":["\u53d7\u3051\u4ed8\u3051\u308b\u6700\u4f4e\u30b9\u30b3\u30a2"],"Google scores each request from 0.0 (likely a bot) to 1.0 (likely a person). Requests below this score are refused. 0.5 is the default; lower it if real customers are told the spam check failed.":["Google\u306f\u5404\u30ea\u30af\u30a8\u30b9\u30c8\u30920.0\uff08\u30dc\u30c3\u30c8\u306e\u53ef\u80fd\u6027\u304c\u9ad8\u3044\uff09\u304b\u30891.0\uff08\u4eba\u9593\u306e\u53ef\u80fd\u6027\u304c\u9ad8\u3044\uff09\u3067\u30b9\u30b3\u30a2\u4ed8\u3051\u3057\u307e\u3059\u3002\u3053\u306e\u30b9\u30b3\u30a2\u3092\u4e0b\u56de\u308b\u30ea\u30af\u30a8\u30b9\u30c8\u306f\u62d2\u5426\u3055\u308c\u307e\u3059\u3002\u30c7\u30d5\u30a9\u30eb\u30c8\u306f0.5\u3067\u3059\u3002\u5b9f\u969b\u306e\u9867\u5ba2\u306b\u30b9\u30d1\u30e0\u30c1\u30a7\u30c3\u30af\u304c\u5931\u6557\u3057\u305f\u3068\u8868\u793a\u3055\u308c\u308b\u5834\u5408\u306f\u3001\u4e0b\u3052\u3066\u304f\u3060\u3055\u3044\u3002"],"Cancel":["\u30ad\u30e3\u30f3\u30bb\u30eb"],"Save Settings":["\u8a2d\u5b9a\u306e\u4fdd\u5b58"],"Settings saved successfully.":["\u8a2d\u5b9a\u304c\u6b63\u5e38\u306b\u4fdd\u5b58\u3055\u308c\u307e\u3057\u305f\u3002"],"Error saving settings.":["\u8a2d\u5b9a\u306e\u4fdd\u5b58\u4e2d\u306b\u30a8\u30e9\u30fc\u304c\u767a\u751f\u3057\u307e\u3057\u305f\u3002"],"Quote request":["\u898b\u7a4d\u3082\u308a\u4f9d\u983c"],"Needed by":["\u5e0c\u671b\u7d0d\u671f"],"Sizes, colours, delivery details or anything else we should know.":["\u30b5\u30a4\u30ba\u3001\u8272\u3001\u914d\u9001\u306e\u8a73\u7d30\u306a\u3069\u3001\u304a\u77e5\u3089\u305b\u3044\u305f\u3060\u304d\u305f\u3044\u3053\u3068\u304c\u3042\u308c\u3070\u3054\u8a18\u5165\u304f\u3060\u3055\u3044\u3002"],"Loading...":["\u8aad\u307f\u8fbc\u307f\u4e2d..."],"The quote list page is ready.":["\u898b\u7a4d\u3082\u308a\u30ea\u30b9\u30c8\u306e\u30da\u30fc\u30b8\u306e\u6e96\u5099\u304c\u3067\u304d\u307e\u3057\u305f\u3002"],"Your first form is saved":["\u6700\u521d\u306e\u30d5\u30a9\u30fc\u30e0\u3092\u4fdd\u5b58\u3057\u307e\u3057\u305f"],"The form is saved":["\u30d5\u30a9\u30fc\u30e0\u3092\u4fdd\u5b58\u3057\u307e\u3057\u305f"],"It does not show on any product yet. Where should customers see it?":["\u3053\u306e\u30d5\u30a9\u30fc\u30e0\u306f\u307e\u3060\u3069\u306e\u5546\u54c1\u306b\u3082\u8868\u793a\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002\u9867\u5ba2\u306b\u3069\u3053\u3067\u8868\u793a\u3057\u307e\u3059\u304b\uff1f"],"On all products":["\u3059\u3079\u3066\u306e\u5546\u54c1"],"On some categories or products":["\u4e00\u90e8\u306e\u30ab\u30c6\u30b4\u30ea\u30fc\u307e\u305f\u306f\u5546\u54c1"],"I will choose it on each product":["\u5546\u54c1\u3054\u3068\u306b\u81ea\u5206\u3067\u9078\u3076"],"To choose it on a product, open the product, go to the General tab and pick the form under \"Request a Quote Form\", below the tiered prices. A global pricing rule has the same field.":["\u5546\u54c1\u3067\u9078\u629e\u3059\u308b\u306b\u306f\u3001\u5546\u54c1\u3092\u958b\u3044\u3066\u300c\u4e00\u822c\u300d\u30bf\u30d6\u306b\u79fb\u52d5\u3057\u3001\u6bb5\u968e\u4fa1\u683c\u306e\u4e0b\u306b\u3042\u308b\u300c\u898b\u7a4d\u3082\u308a\u30ea\u30af\u30a8\u30b9\u30c8\u30d5\u30a9\u30fc\u30e0\u300d\u3067\u30d5\u30a9\u30fc\u30e0\u3092\u9078\u3073\u307e\u3059\u3002\u30b0\u30ed\u30fc\u30d0\u30eb\u4fa1\u683c\u8a2d\u5b9a\u30eb\u30fc\u30eb\u306b\u3082\u540c\u3058\u9805\u76ee\u304c\u3042\u308a\u307e\u3059\u3002"],"Customers collect products in the quote list and send the request from its page. The list has no page yet, so it stays off.":["\u304a\u5ba2\u69d8\u306f\u898b\u7a4d\u3082\u308a\u30ea\u30b9\u30c8\u306b\u5546\u54c1\u3092\u96c6\u3081\u3001\u305d\u306e\u30da\u30fc\u30b8\u304b\u3089\u4f9d\u983c\u3092\u9001\u4fe1\u3057\u307e\u3059\u3002\u30ea\u30b9\u30c8\u306b\u306f\u307e\u3060\u30da\u30fc\u30b8\u304c\u306a\u3044\u305f\u3081\u3001\u30aa\u30d5\u306e\u307e\u307e\u3067\u3059\u3002"],"Later":["\u5f8c\u3067"],"Are you sure you want to delete this form?":["\u3053\u306e\u30d5\u30a9\u30fc\u30e0\u3092\u524a\u9664\u3057\u3066\u3082\u3088\u308d\u3057\u3044\u3067\u3059\u304b?"],"Global settings saved successfully.":["\u30b0\u30ed\u30fc\u30d0\u30eb\u8a2d\u5b9a\u304c\u6b63\u5e38\u306b\u4fdd\u5b58\u3055\u308c\u307e\u3057\u305f\u3002"],"Error saving global settings.":["\u30b0\u30ed\u30fc\u30d0\u30eb\u8a2d\u5b9a\u306e\u4fdd\u5b58\u4e2d\u306b\u30a8\u30e9\u30fc\u304c\u767a\u751f\u3057\u307e\u3057\u305f\u3002"],"Leave this form without saving? Your changes will be lost.":["\u4fdd\u5b58\u305b\u305a\u306b\u3053\u306e\u30d5\u30a9\u30fc\u30e0\u3092\u96e2\u308c\u307e\u3059\u304b\uff1f\u5909\u66f4\u5185\u5bb9\u306f\u5931\u308f\u308c\u307e\u3059\u3002"]}}}