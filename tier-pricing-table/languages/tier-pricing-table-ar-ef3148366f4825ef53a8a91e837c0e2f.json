u0643\u062a\u0631\u0648\u0646\u064a"],"Select Dropdown":["\u062d\u062f\u062f \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0646\u0633\u062f\u0644\u0629"],"Radio Buttons":["\u0623\u0632\u0631\u0627\u0631 \u0627\u0644\u0631\u0627\u062f\u064a\u0648"],"Checkboxes":["\u062e\u0627\u0646\u0627\u062a \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631"],"Heading":["\u0639\u0646\u0648\u0627\u0646"],"File Upload":["\u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0645\u0644\u0641"],"Date Picker":["\u0645\u0646\u062a\u0642\u064a \u0627\u0644\u062a\u0627\u0631\u064a\u062e"],"Field":["\u0645\u062c\u0627\u0644"],"Request a Quote on the frontend is a premium feature. You can preview it as an administrator, but upgrading is required for your customers to use it.":["\u064a\u0639\u062f \u0637\u0644\u0628 \u0639\u0631\u0636 \u0623\u0633\u0639\u0627\u0631 \u0639\u0644\u0649 \u0627\u0644\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0645\u064a\u0632\u0629 \u0645\u062a\u0645\u064a\u0632\u0629. \u064a\u0645\u0643\u0646\u0643 \u0645\u0639\u0627\u064a\u0646\u062a\u0647 \u0643\u0645\u0633\u0624\u0648\u0644\u060c \u0648\u0644\u0643\u0646 \u0627\u0644\u062a\u0631\u0642\u064a\u0629 \u0645\u0637\u0644\u0648\u0628\u0629 \u062d\u062a\u0649 \u064a\u062a\u0645\u0643\u0646 \u0639\u0645\u0644\u0627\u0624\u0643 \u0645\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647."],"Back":["\u062e\u0644\u0641"],"Edit Form:":["\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c:"],"Save Form":["\u062d\u0641\u0638 \u0627\u0644\u0646\u0645\u0648\u0630\u062c"],"Show this form on":["\u0625\u0638\u0647\u0627\u0631 \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0641\u064a"],"Products and pricing rules that choose it":["\u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0648\u0642\u0648\u0627\u0639\u062f \u0627\u0644\u062a\u0633\u0639\u064a\u0631 \u0627\u0644\u062a\u064a \u062a\u062e\u062a\u0627\u0631\u0647"],"Choose this form on a product (General tab, \"Request a Quote Form\", below the tiered prices) or in a global pricing rule.":["\u0627\u062e\u062a\u0631 \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0641\u064a \u0645\u0646\u062a\u062c (\u062a\u0628\u0648\u064a\u0628 \u0639\u0627\u0645\u060c \"\u0646\u0645\u0648\u0630\u062c \u0637\u0644\u0628 \u0639\u0631\u0636 \u0623\u0633\u0639\u0627\u0631\"\u060c \u0623\u0633\u0641\u0644 \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0645\u062a\u062f\u0631\u062c\u0629) \u0623\u0648 \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u062a\u0633\u0639\u064a\u0631 \u0639\u0627\u0645\u0629."],"A form chosen on a product or in a global pricing rule still wins there. If several forms cover a product, the one that names the product wins, then the one for its category, then the one for all products.":["\u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0645\u062e\u062a\u0627\u0631 \u0641\u064a \u0645\u0646\u062a\u062c \u0623\u0648 \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u062a\u0633\u0639\u064a\u0631 \u0639\u0627\u0645\u0629 \u064a\u0638\u0644 \u0644\u0647 \u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629 \u0647\u0646\u0627\u0643. \u0625\u0630\u0627 \u0634\u0645\u0644 \u0639\u062f\u0629 \u0646\u0645\u0627\u0630\u062c \u0645\u0646\u062a\u062c\u064b\u0627\u060c \u0641\u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0630\u064a \u064a\u0633\u0645\u0651\u064a \u0627\u0644\u0645\u0646\u062a\u062c \u064a\u0641\u0648\u0632\u060c \u062b\u0645 \u0646\u0645\u0648\u0630\u062c \u0641\u0626\u062a\u0647\u060c \u062b\u0645 \u0646\u0645\u0648\u0630\u062c \u0643\u0644 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a."],"Chosen on %d product or pricing rule.":["\u0644\u0645 \u064a\u064f\u062e\u062a\u0631 \u0641\u064a \u0623\u064a \u0645\u0646\u062a\u062c \u0623\u0648 \u0642\u0627\u0639\u062f\u0629 \u062a\u0633\u0639\u064a\u0631.","\u0645\u062e\u062a\u0627\u0631 \u0641\u064a \u0645\u0646\u062a\u062c \u0623\u0648 \u0642\u0627\u0639\u062f\u0629 \u062a\u0633\u0639\u064a\u0631 \u0648\u0627\u062d\u062f\u0629.","\u0645\u062e\u062a\u0627\u0631 \u0641\u064a \u0645\u0646\u062a\u062c\u064a\u0646 \u0623\u0648 \u0642\u0627\u0639\u062f\u062a\u064a \u062a\u0633\u0639\u064a\u0631.","\u0645\u062e\u062a\u0627\u0631 \u0641\u064a %d \u0645\u0646\u062a\u062c\u0627\u062a \u0648\u0642\u0648\u0627\u0639\u062f \u062a\u0633\u0639\u064a\u0631.","\u0645\u062e\u062a\u0627\u0631 \u0641\u064a %d \u0645\u0646\u062a\u062c\u064b\u0627 \u0648\u0642\u0627\u0639\u062f\u0629 \u062a\u0633\u0639\u064a\u0631.","\u0645\u062e\u062a\u0627\u0631 \u0641\u064a %d \u0645\u0646\u062a\u062c \u0648\u0642\u0627\u0639\u062f\u0629 \u062a\u0633\u0639\u064a\u0631."],"No product or pricing rule has chosen this form yet, so customers do not see it.":["\u0644\u0645 \u064a\u062e\u062a\u0631 \u0623\u064a \u0645\u0646\u062a\u062c \u0623\u0648 \u0642\u0627\u0639\u062f\u0629 \u062a\u0633\u0639\u064a\u0631 \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0628\u0639\u062f\u060c \u0644\u0630\u0644\u0643 \u0644\u0627 \u064a\u0631\u0627\u0647 \u0627\u0644\u0639\u0645\u0644\u0627\u0621."],"Search categories":["\u0627\u0628\u062d\u062b \u0641\u064a \u0627\u0644\u0641\u0626\u0627\u062a"],"Their subcategories are included.":["\u062a\u064f\u0634\u0645\u0644 \u0641\u0626\u0627\u062a\u0647\u0627 \u0627\u0644\u0641\u0631\u0639\u064a\u0629."],"Search by name or SKU":["\u0627\u0628\u062d\u062b \u0628\u0627\u0644\u0627\u0633\u0645 \u0623\u0648 SKU"],"A product with variations covers all of them.":["\u0627\u0644\u0645\u0646\u062a\u062c \u0630\u0648 \u0627\u0644\u062a\u0628\u0627\u064a\u0646\u0627\u062a \u064a\u0634\u0645\u0644\u0647\u0627 \u0643\u0644\u0647\u0627."],"Except these products":["\u0628\u0627\u0633\u062a\u062b\u0646\u0627\u0621 \u0647\u0630\u0647 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a"],"Customer roles":["\u0623\u062f\u0648\u0627\u0631 \u0627\u0644\u0639\u0645\u0644\u0627\u0621"],"Leave empty to show the form to everyone.":["\u0627\u062a\u0631\u0643\u0647 \u0641\u0627\u0631\u063a\u064b\u0627 \u0644\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0644\u0644\u062c\u0645\u064a\u0639."],"A product without a pricing layout (no price tiers, or no price at all) shows the button by itself under the price. So does the Tooltip layout.":["\u0627\u0644\u0645\u0646\u062a\u062c \u0628\u0644\u0627 \u062a\u062e\u0637\u064a\u0637 \u062a\u0633\u0639\u064a\u0631 (\u0628\u0644\u0627 \u0637\u0628\u0642\u0627\u062a \u0623\u0633\u0639\u0627\u0631\u060c \u0623\u0648 \u0628\u0644\u0627 \u0633\u0639\u0631) \u064a\u0639\u0631\u0636 \u0627\u0644\u0632\u0631 \u0648\u062d\u062f\u0647 \u062a\u062d\u062a \u0627\u0644\u0633\u0639\u0631. \u0648\u0643\u0630\u0644\u0643 \u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u062a\u0644\u0645\u064a\u062d."],"Quote requests":["\u0637\u0644\u0628\u0627\u062a \u0639\u0631\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631"],"Customers request a quote for":["\u064a\u0637\u0644\u0628 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0639\u0631\u0636 \u0623\u0633\u0639\u0627\u0631 \u0644\u0640"],"Individual products":["\u0645\u0646\u062a\u062c\u0627\u062a \u0641\u0631\u062f\u064a\u0629"],"Quote buttons add the product to the quote list. Customers send one request for all of them from the quote list page.":["\u062a\u0636\u064a\u0641 \u0623\u0632\u0631\u0627\u0631 \u0639\u0631\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0645\u0646\u062a\u062c \u0625\u0644\u0649 \u0642\u0627\u0626\u0645\u0629 \u0639\u0631\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631. \u064a\u0631\u0633\u0644 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0637\u0644\u0628\u064b\u0627 \u0648\u0627\u062d\u062f\u064b\u0627 \u0644\u0647\u0627 \u0643\u0644\u0647\u0627 \u0645\u0646 \u0635\u0641\u062d\u0629 \u0642\u0627\u0626\u0645\u0629 \u0639\u0631\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631."],"Each quote button opens this form for its product.":["\u064a\u0641\u062a\u062d \u0643\u0644 \u0632\u0631 \u0639\u0631\u0636 \u0623\u0633\u0639\u0627\u0631 \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0644\u0645\u0646\u062a\u062c\u0647."],"The quote list needs a page first.":["\u062a\u062d\u062a\u0627\u062c \u0642\u0627\u0626\u0645\u0629 \u0639\u0631\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0625\u0644\u0649 \u0635\u0641\u062d\u0629 \u0623\u0648\u0644\u064b\u0627."],"Open Settings":["\u0641\u062a\u062d \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a"],"Appearance & Content":["\u0627\u0644\u0645\u0638\u0647\u0631 \u0648\u0627\u0644\u0645\u062d\u062a\u0648\u0649"],"The text of the button that opens this form.":["\u0646\u0635 \u0627\u0644\u0632\u0631 \u0627\u0644\u0630\u064a \u064a\u0641\u062a\u062d \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c."],"Where the button shows":["\u0623\u064a\u0646 \u064a\u0638\u0647\u0631 \u0627\u0644\u0632\u0631"],"Inside means the last row of a table, one more block, option or line of text, or a strip under a horizontal table, depending on the pricing layout.":["\"\u062f\u0627\u062e\u0644\" \u064a\u0639\u0646\u064a \u0627\u0644\u0635\u0641 \u0627\u0644\u0623\u062e\u064a\u0631 \u0641\u064a \u062c\u062f\u0648\u0644\u060c \u0623\u0648 \u0643\u062a\u0644\u0629 \u0623\u0648 \u062e\u064a\u0627\u0631\u064b\u0627 \u0623\u0648 \u0633\u0637\u0631 \u0646\u0635 \u0625\u0636\u0627\u0641\u064a\u064b\u0627\u060c \u0623\u0648 \u0634\u0631\u064a\u0637\u064b\u0627 \u0623\u0633\u0641\u0644 \u062c\u062f\u0648\u0644 \u0623\u0641\u0642\u064a\u060c \u0628\u062d\u0633\u0628 \u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u062a\u0633\u0639\u064a\u0631."],"Button style":["\u0646\u0645\u0637 \u0627\u0644\u0632\u0631"],"Outlined (secondary)":["\u0628\u062d\u062f\u0648\u062f (\u062b\u0627\u0646\u0648\u064a)"],"Filled (like Add to cart)":["\u0645\u0639\u0628\u0651\u0623 (\u0645\u062b\u0644 \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0627\u0644\u0633\u0644\u0629)"],"Text link":["\u0631\u0627\u0628\u0637 \u0646\u0635\u064a"],"Outlined keeps \"Add to cart\" the main action of the product page. Inside the Blocks layout the whole block is the button; inside the Plain text layout it is a text link.":["\u0627\u0644\u0632\u0631 \u0630\u0648 \u0627\u0644\u062d\u062f\u0648\u062f \u064a\u064f\u0628\u0642\u064a \"\u0623\u0636\u0641 \u0625\u0644\u0649 \u0627\u0644\u0633\u0644\u0629\" \u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0631\u0626\u064a\u0633\u064a \u0641\u064a \u0635\u0641\u062d\u0629 \u0627\u0644\u0645\u0646\u062a\u062c. \u062f\u0627\u062e\u0644 \u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u0643\u062a\u0644 \u062a\u0643\u0648\u0646 \u0627\u0644\u0643\u062a\u0644\u0629 \u0643\u0644\u0647\u0627 \u0647\u064a \u0627\u0644\u0632\u0631\u061b \u0648\u062f\u0627\u062e\u0644 \u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u0646\u0635 \u0627\u0644\u0639\u0627\u062f\u064a \u064a\u0643\u0648\u0646 \u0631\u0627\u0628\u0637\u064b\u0627 \u0646\u0635\u064a\u064b\u0627."],"Outlined keeps \"Add to cart\" the main action of the product page.":["\u0627\u0644\u0632\u0631 \u0630\u0648 \u0627\u0644\u062d\u062f\u0648\u062f \u064a\u064f\u0628\u0642\u064a \"\u0623\u0636\u0641 \u0625\u0644\u0649 \u0627\u0644\u0633\u0644\u0629\" \u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0631\u0626\u064a\u0633\u064a \u0641\u064a \u0635\u0641\u062d\u0629 \u0627\u0644\u0645\u0646\u062a\u062c."],"This form still uses the theme's main button, as before button styles existed. An outlined button stands out less than \"Add to cart\".":["\u0644\u0627 \u064a\u0632\u0627\u0644 \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u064a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0632\u0631 \u0627\u0644\u0631\u0626\u064a\u0633\u064a \u0644\u0644\u0642\u0627\u0644\u0628\u060c \u0643\u0645\u0627 \u0642\u0628\u0644 \u0648\u062c\u0648\u062f \u0623\u0646\u0645\u0627\u0637 \u0627\u0644\u0623\u0632\u0631\u0627\u0631. \u0627\u0644\u0632\u0631 \u0630\u0648 \u0627\u0644\u062d\u062f\u0648\u062f \u0623\u0642\u0644 \u0628\u0631\u0648\u0632\u064b\u0627 \u0645\u0646 \"\u0623\u0636\u0641 \u0625\u0644\u0649 \u0627\u0644\u0633\u0644\u0629\"."],"Use the outlined button":["\u0627\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0632\u0631 \u0630\u0627 \u0627\u0644\u062d\u062f\u0648\u062f"],"Hide Add to Cart button":["\u0625\u062e\u0641\u0627\u0621 \u0632\u0631 \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0633\u0644\u0629 \u0627\u0644\u062a\u0633\u0648\u0642"],"The product is sold on request only: Add to cart is hidden and the product cannot be added to the cart from anywhere.":["\u0627\u0644\u0645\u0646\u062a\u062c \u064a\u064f\u0628\u0627\u0639 \u0639\u0646\u062f \u0627\u0644\u0637\u0644\u0628 \u0641\u0642\u0637: \u0632\u0631 \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0627\u0644\u0633\u0644\u0629 \u0645\u062e\u0641\u064a \u0648\u0644\u0627 \u064a\u0645\u0643\u0646 \u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0645\u0646\u062a\u062c \u0625\u0644\u0649 \u0627\u0644\u0633\u0644\u0629 \u0645\u0646 \u0623\u064a \u0645\u0643\u0627\u0646."],"Show for non-purchasable products":["\u0639\u0631\u0636 \u0644\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u063a\u064a\u0631 \u0627\u0644\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0634\u0631\u0627\u0621"],"Display the Quote button even if the product does not have a price or is out of stock.":["\u0642\u0645 \u0628\u0639\u0631\u0636 \u0632\u0631 \u0639\u0631\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u062d\u062a\u0649 \u0644\u0648 \u0644\u0645 \u064a\u0643\u0646 \u0644\u0644\u0645\u0646\u062a\u062c \u0633\u0639\u0631 \u0623\u0648 \u0643\u0627\u0646 \u063a\u064a\u0631 \u0645\u062a\u0648\u0641\u0631 \u0641\u064a \u0627\u0644\u0645\u062e\u0632\u0648\u0646."],"Label in the pricing layout":["\u0627\u0644\u062a\u0633\u0645\u064a\u0629 \u0641\u064a \u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u062a\u0633\u0639\u064a\u0631"],"The text of the quote entry, where the other rows, blocks or options show a quantity. Keep it short: blocks are narrow.":["\u0646\u0635 \u0645\u062f\u062e\u0644 \u0639\u0631\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631\u060c \u062d\u064a\u062b \u062a\u0639\u0631\u0636 \u0627\u0644\u0635\u0641\u0648\u0641 \u0623\u0648 \u0627\u0644\u0643\u062a\u0644 \u0623\u0648 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0623\u062e\u0631\u0649 \u0643\u0645\u064a\u0629. \u0627\u062c\u0639\u0644\u0647 \u0642\u0635\u064a\u0631\u064b\u0627: \u0627\u0644\u0643\u062a\u0644 \u0636\u064a\u0642\u0629."],"Popup title":["\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629"],"Send button text":["\u0646\u0635 \u0632\u0631 \u0627\u0644\u0625\u0631\u0633\u0627\u0644"],"Note under the send button":["\u0645\u0644\u0627\u062d\u0638\u0629 \u062a\u062d\u062a \u0632\u0631 \u0627\u0644\u0625\u0631\u0633\u0627\u0644"],"No payment now. We reply by e-mail.":["\u0644\u0627 \u062f\u0641\u0639 \u0627\u0644\u0622\u0646. \u0646\u0631\u062f \u0639\u0644\u064a\u0643 \u0628\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a."],"A line that reassures: what happens next, how soon you reply. Leave blank for none.":["\u0633\u0637\u0631 \u0645\u0637\u0645\u0626\u0646: \u0645\u0627 \u0627\u0644\u0630\u064a \u0633\u064a\u062d\u062f\u062b \u0644\u0627\u062d\u0642\u064b\u0627\u060c \u0648\u0645\u062a\u0649 \u062a\u0631\u062f\u0651\u0648\u0646. \u0627\u062a\u0631\u0643\u0647 \u0641\u0627\u0631\u063a\u064b\u0627 \u0644\u0639\u062f\u0645 \u0625\u0638\u0647\u0627\u0631 \u0634\u064a\u0621."],"Open the form from a quantity":["\u0641\u062a\u062d \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0639\u0646\u062f \u0643\u0645\u064a\u0629 \u0645\u0639\u064a\u0646\u0629"],"The form opens by itself when a customer chooses this quantity or more. Leave blank to switch this off.":["\u064a\u064f\u0641\u062a\u062d \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0646\u062f\u0645\u0627 \u064a\u062e\u062a\u0627\u0631 \u0627\u0644\u0639\u0645\u064a\u0644 \u0647\u0630\u0647 \u0627\u0644\u0643\u0645\u064a\u0629 \u0623\u0648 \u0623\u0643\u062b\u0631. \u0627\u062a\u0631\u0643\u0647 \u0641\u0627\u0631\u063a\u064b\u0627 \u0644\u0625\u064a\u0642\u0627\u0641 \u0630\u0644\u0643."],"Email Notifications":["\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"],"Enable Admin Email":["\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0644\u0645\u0633\u0624\u0648\u0644"],"Send an email to the store admin when this form is submitted.":["\u0623\u0631\u0633\u0644 \u0628\u0631\u064a\u062f\u064b\u0627 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u064b\u0627 \u0625\u0644\u0649 \u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0645\u062a\u062c\u0631 \u0639\u0646\u062f \u0625\u0631\u0633\u0627\u0644 \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c."],"Enable Customer Email":["\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0644\u0639\u0645\u064a\u0644"],"Send an acknowledgment email to the customer.":["\u0625\u0631\u0633\u0627\u0644 \u0631\u0633\u0627\u0644\u0629 \u0625\u0642\u0631\u0627\u0631 \u0628\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0625\u0644\u0649 \u0627\u0644\u0639\u0645\u064a\u0644."],"Manage Email Templates \u2197":["\u0625\u062f\u0627\u0631\u0629 \u0642\u0648\u0627\u0644\u0628 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u2197"],"Success Actions":["\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0646\u062c\u0627\u062d"],"After Submission":["\u0628\u0639\u062f \u0627\u0644\u062a\u0642\u062f\u064a\u0645"],"Show Message":["\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u0631\u0633\u0627\u0644\u0629"],"Redirect to URL":["\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u0625\u0644\u0649 URL"],"Success Message":["\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u0646\u062c\u0627\u062d"],"Message shown after successful submission.":["\u062a\u0638\u0647\u0631 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0628\u0639\u062f \u0627\u0644\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0646\u0627\u062c\u062d."],"Redirect URL":["\u0625\u0639\u0627\u062f\u0629 \u062a\u0648\u062c\u064a\u0647 URL"],"Enter the full URL (e.g., https:\/\/example.com\/thank-you)":["\u0623\u062f\u062e\u0644 \u0639\u0646\u0648\u0627\u0646 URL \u0627\u0644\u0643\u0627\u0645\u0644 (\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644\u060c https:\/\/example.com\/thank-you)"],"Form name":["\u0627\u0633\u0645 \u0627\u0644\u0646\u0645\u0648\u0630\u062c"],"Add form title":["\u0625\u0636\u0627\u0641\u0629 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0646\u0645\u0648\u0630\u062c"],"Preview":["\u0645\u0639\u0627\u064a\u0646\u0629"],"Form Fields":["\u062d\u0642\u0648\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c"],"Expand All":["\u0642\u0645 \u0628\u062a\u0648\u0633\u064a\u0639 \u0627\u0644\u0643\u0644"],"Collapse All":["\u0637\u064a \u0627\u0644\u0643\u0644"],"No fields added yet. Select a field type below to add one.":["\u0644\u0645 \u062a\u062a\u0645 \u0625\u0636\u0627\u0641\u0629 \u0623\u064a \u062d\u0642\u0648\u0644 \u0628\u0639\u062f. \u062d\u062f\u062f \u0646\u0648\u0639 \u0627\u0644\u062d\u0642\u0644 \u0623\u062f\u0646\u0627\u0647 \u0644\u0625\u0636\u0627\u0641\u0629 \u0648\u0627\u062d\u062f."],"Drag to reorder":["\u0627\u0633\u062d\u0628 \u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0631\u062a\u064a\u0628"],"Paragraph Content":["\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0641\u0642\u0631\u0629"],"Heading Text":["\u0646\u0635 \u0627\u0644\u0639\u0646\u0648\u0627\u0646"],"Title format":["\u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u0639\u0646\u0648\u0627\u0646"],"Hidden":["\u0645\u062e\u062a\u0641\u064a"],"Options (One per line)":["\u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a (\u0648\u0627\u062d\u062f \u0644\u0643\u0644 \u0633\u0637\u0631)"],"Option 1\nOption 2\nOption 3":["\u0627\u0644\u062e\u064a\u0627\u0631 1\n\u0627\u0644\u062e\u064a\u0627\u0631 2\n\u0627\u0644\u062e\u064a\u0627\u0631 3"],"Require input":["\u062a\u062a\u0637\u0644\u0628 \u0627\u0644\u0625\u062f\u062e\u0627\u0644"],"Sync with product quantity":["\u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629 \u0645\u0639 \u0643\u0645\u064a\u0629 \u0627\u0644\u0645\u0646\u062a\u062c"],"Add description":["\u0623\u0636\u0641 \u0627\u0644\u0648\u0635\u0641"],"Add placeholder":["\u0625\u0636\u0627\u0641\u0629 \u0639\u0646\u0635\u0631 \u0646\u0627\u0626\u0628"],"Max File Size (MB)":["\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u062d\u062c\u0645 \u0627\u0644\u0645\u0644\u0641 (\u0645\u064a\u062c\u0627\u0628\u0627\u064a\u062a)"],"No limit":["\u0628\u0644\u0627 \u062d\u062f"],"Leave blank for no limit of its own. Your server accepts files up to %s.":["\u0627\u062a\u0631\u0643\u0647 \u0641\u0627\u0631\u063a\u064b\u0627 \u0644\u0639\u062f\u0645 \u0648\u0636\u0639 \u062d\u062f \u062e\u0627\u0635. \u064a\u0642\u0628\u0644 \u062e\u0627\u062f\u0645\u0643 \u0645\u0644\u0641\u0627\u062a \u062d\u062a\u0649 %s."],"Leave blank for no limit of its own (the server's upload limit still applies).":["\u0627\u062a\u0631\u0643\u0647 \u0641\u0627\u0631\u063a\u064b\u0627 \u0644\u0639\u062f\u0645 \u0648\u0636\u0639 \u062d\u062f \u062e\u0627\u0635 (\u064a\u0638\u0644 \u062d\u062f \u0627\u0644\u0631\u0641\u0639 \u0641\u064a \u0627\u0644\u062e\u0627\u062f\u0645 \u0633\u0627\u0631\u064a\u0627\u064b)."],"Allowed Extensions":["\u0627\u0644\u0627\u0645\u062a\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u0633\u0645\u0648\u062d \u0628\u0647\u0627"],"Comma separated, e.g. pdf, doc, png. Leave blank for any.":["\u0645\u0641\u0635\u0648\u0644\u0629 \u0628\u0641\u0627\u0635\u0644\u0629\u060c \u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644 \u0642\u0648\u0627\u062a \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0634\u0639\u0628\u064a\u060c \u0648\u062b\u064a\u0642\u0629\u060c \u0628\u0627\u0628\u0648\u0627 \u0646\u064a\u0648 \u063a\u064a\u0646\u064a\u0627. \u0627\u062a\u0631\u0643\u0647 \u0641\u0627\u0631\u063a\u0627 \u0644\u0623\u064a."],"Disable past dates":["\u062a\u0639\u0637\u064a\u0644 \u0627\u0644\u062a\u0648\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0627\u0636\u064a\u0629"],"Prevent customers from selecting dates in the past.":["\u0645\u0646\u0639 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0645\u0646 \u062a\u062d\u062f\u064a\u062f \u062a\u0648\u0627\u0631\u064a\u062e \u0641\u064a \u0627\u0644\u0645\u0627\u0636\u064a."],"Add field...":["\u0625\u0636\u0627\u0641\u0629 \u062d\u0642\u0644..."],"Customers collect several products with the quote buttons, then send one request for all of them from the quote list page.":["\u064a\u062c\u0645\u0639 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0639\u062f\u0629 \u0645\u0646\u062a\u062c\u0627\u062a \u0628\u0623\u0632\u0631\u0627\u0631 \u0639\u0631\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631\u060c \u062b\u0645 \u064a\u0631\u0633\u0644\u0648\u0646 \u0637\u0644\u0628\u064b\u0627 \u0648\u0627\u062d\u062f\u064b\u0627 \u0644\u0647\u0627 \u0643\u0644\u0647\u0627 \u0645\u0646 \u0635\u0641\u062d\u0629 \u0642\u0627\u0626\u0645\u0629 \u0639\u0631\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631."],"Forms for multiple products:":["\u0646\u0645\u0627\u0630\u062c \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u0645\u062a\u0639\u062f\u062f\u0629:"],"No form uses the quote list yet. Open a form and choose \"Multiple products\" under Quote requests; forms for individual products keep opening for one product.":["\u0644\u0627 \u064a\u0633\u062a\u062e\u062f\u0645 \u0623\u064a \u0646\u0645\u0648\u0630\u062c \u0642\u0627\u0626\u0645\u0629 \u0639\u0631\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0628\u0639\u062f. \u0627\u0641\u062a\u062d \u0646\u0645\u0648\u0630\u062c\u064b\u0627 \u0648\u0627\u062e\u062a\u0631 \"\u0645\u0646\u062a\u062c\u0627\u062a \u0645\u062a\u0639\u062f\u062f\u0629\" \u0636\u0645\u0646 \u0637\u0644\u0628\u0627\u062a \u0639\u0631\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631\u061b \u062a\u0638\u0644 \u0646\u0645\u0627\u0630\u062c \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u0641\u0631\u062f\u064a\u0629 \u062a\u064f\u0641\u062a\u062d \u0644\u0645\u0646\u062a\u062c \u0648\u0627\u062d\u062f."],"Quote list page":["\u0635\u0641\u062d\u0629 \u0642\u0627\u0626\u0645\u0629 \u0639\u0631\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631"],"Loading pages\u2026":["\u062c\u0627\u0631\u064d \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0635\u0641\u062d\u0627\u062a\u2026"],"Choose a page":["\u0627\u062e\u062a\u0631 \u0635\u0641\u062d\u0629"],"Create the page":["\u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0635\u0641\u062d\u0629"],"View the page":["\u0639\u0631\u0636 \u0627\u0644\u0635\u0641\u062d\u0629"],"The page shows the list and the form. Any page with the [tiered_pricing_quote_list] shortcode works.":["\u062a\u0639\u0631\u0636 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0648\u0627\u0644\u0646\u0645\u0648\u0630\u062c. \u062a\u0635\u0644\u062d \u0623\u064a \u0635\u0641\u062d\u0629 \u0641\u064a\u0647\u0627 \u0627\u0644\u0631\u0645\u0632 \u0627\u0644\u0642\u0635\u064a\u0631 [tiered_pricing_quote_list]."],"The quote list stays off until it has a page.":["\u062a\u0628\u0642\u0649 \u0642\u0627\u0626\u0645\u0629 \u0639\u0631\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0645\u062a\u0648\u0642\u0641\u0629 \u062d\u062a\u0649 \u062a\u0643\u0648\u0646 \u0644\u0647\u0627 \u0635\u0641\u062d\u0629."],"Form on the quote list page":["\u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0641\u064a \u0635\u0641\u062d\u0629 \u0642\u0627\u0626\u0645\u0629 \u0639\u0631\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631"],"The first form for multiple products":["\u0623\u0648\u0644 \u0646\u0645\u0648\u0630\u062c \u0644\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u0645\u062a\u0639\u062f\u062f\u0629"],"Its quantity field is left out: each product in the list has its own quantity.":["\u062d\u0642\u0644 \u0627\u0644\u0643\u0645\u064a\u0629 \u0641\u064a\u0647 \u0645\u062d\u0630\u0648\u0641: \u0644\u0643\u0644 \u0645\u0646\u062a\u062c \u0641\u064a \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0643\u0645\u064a\u062a\u0647 \u0627\u0644\u062e\u0627\u0635\u0629."],"Show estimated prices in the list":["\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u062a\u0642\u062f\u064a\u0631\u064a\u0629 \u0641\u064a \u0627\u0644\u0642\u0627\u0626\u0645\u0629"],"Each customer sees their own tier price for the quantity in the list. Never shown to visitors you hide prices from.":["\u064a\u0631\u0649 \u0643\u0644 \u0639\u0645\u064a\u0644 \u0633\u0639\u0631 \u0637\u0628\u0642\u062a\u0647 \u0627\u0644\u062e\u0627\u0635 \u0644\u0644\u0643\u0645\u064a\u0629 \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629 \u0641\u064a \u0627\u0644\u0642\u0627\u0626\u0645\u0629. \u0644\u0627 \u064a\u0638\u0647\u0631 \u0623\u0628\u062f\u064b\u0627 \u0644\u0644\u0632\u0648\u0627\u0631 \u0627\u0644\u0630\u064a\u0646 \u062a\u062e\u0641\u064a \u0639\u0646\u0647\u0645 \u0627\u0644\u0623\u0633\u0639\u0627\u0631."],"\"Add to quote\" on shop and category pages":["\"\u0623\u0636\u0641 \u0625\u0644\u0649 \u0639\u0631\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631\" \u0641\u064a \u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0645\u062a\u062c\u0631 \u0648\u0627\u0644\u0641\u0626\u0627\u062a"],"For products whose quote form is for multiple products. Products with options are added from their own page.":["\u0644\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u062a\u064a \u0646\u0645\u0648\u0630\u062c \u0639\u0631\u0636 \u0623\u0633\u0639\u0627\u0631\u0647\u0627 \u0644\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u0645\u062a\u0639\u062f\u062f\u0629. \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0630\u0627\u062a \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u062a\u064f\u0636\u0627\u0641 \u0645\u0646 \u0635\u0641\u062d\u062a\u0647\u0627."],"Floating \"Quote list\" button":["\u0632\u0631 \"\u0642\u0627\u0626\u0645\u0629 \u0639\u0631\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631\" \u0627\u0644\u0639\u0627\u0626\u0645"],"Shows while the list has products. For a link in your header or menu, use the [tiered_pricing_quote_list_link] shortcode.":["\u064a\u0638\u0647\u0631 \u0645\u0627 \u062f\u0627\u0645\u062a \u0641\u064a \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0645\u0646\u062a\u062c\u0627\u062a. \u0644\u0631\u0627\u0628\u0637 \u0641\u064a \u0631\u0623\u0633 \u0627\u0644\u0645\u0648\u0642\u0639 \u0623\u0648 \u0627\u0644\u0642\u0627\u0626\u0645\u0629\u060c \u0627\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0631\u0645\u0632 \u0627\u0644\u0642\u0635\u064a\u0631 [tiered_pricing_quote_list_link]."],"\"Request a quote for this cart\" on the cart page":["\"\u0637\u0644\u0628 \u0639\u0631\u0636 \u0623\u0633\u0639\u0627\u0631 \u0644\u0647\u0630\u0647 \u0627\u0644\u0633\u0644\u0629\" \u0641\u064a \u0635\u0641\u062d\u0629 \u0627\u0644\u0633\u0644\u0629"],"Copies the cart into the quote list. The cart itself stays as it is.":["\u064a\u0646\u0633\u062e \u0627\u0644\u0633\u0644\u0629 \u0625\u0644\u0649 \u0642\u0627\u0626\u0645\u0629 \u0639\u0631\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631. \u062a\u0628\u0642\u0649 \u0627\u0644\u0633\u0644\u0629 \u0646\u0641\u0633\u0647\u0627 \u0643\u0645\u0627 \u0647\u064a."],"Anti-Spam (reCAPTCHA v3)":["\u0645\u0643\u0627\u0641\u062d\u0629 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0639\u0634\u0648\u0627\u0626\u064a (reCAPTCHA v3)"],"Configure Google reCAPTCHA v3 to protect all quote forms from spam. Leave blank to disable.":["\u0642\u0645 \u0628\u062a\u0643\u0648\u064a\u0646 Google reCAPTCHA v3 \u0644\u062d\u0645\u0627\u064a\u0629 \u062c\u0645\u064a\u0639 \u0646\u0645\u0627\u0630\u062c \u0639\u0631\u0648\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0645\u0646 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0639\u0634\u0648\u0627\u0626\u064a. \u0627\u062a\u0631\u0643\u0647 \u0641\u0627\u0631\u063a\u064b\u0627 \u0644\u0644\u062a\u0639\u0637\u064a\u0644."],"Site Key":["\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0645\u0648\u0642\u0639"],"Secret Key":["\u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0633\u0631\u064a"],"Lowest score accepted":["\u0623\u062f\u0646\u0649 \u062f\u0631\u062c\u0629 \u0645\u0642\u0628\u0648\u0644\u0629"],"Google scores each request from 0.0 (likely a bot) to 1.0 (likely a person). Requests below this score are refused. 0.5 is the default; lower it if real customers are told the spam check failed.":["\u062a\u0639\u0637\u064a Google \u0643\u0644 \u0637\u0644\u0628 \u062f\u0631\u062c\u0629 \u0645\u0646 0.0 (\u0639\u0644\u0649 \u0627\u0644\u0623\u0631\u062c\u062d \u0631\u0648\u0628\u0648\u062a) \u0625\u0644\u0649 1.0 (\u0639\u0644\u0649 \u0627\u0644\u0623\u0631\u062c\u062d \u0634\u062e\u0635). \u062a\u064f\u0631\u0641\u0636 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0623\u0642\u0644 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u062f\u0631\u062c\u0629. \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 0.5\u061b \u0627\u062e\u0641\u0636\u0647\u0627 \u0625\u0630\u0627 \u0642\u064a\u0644 \u0644\u0644\u0639\u0645\u0644\u0627\u0621 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u064a\u0646 \u0625\u0646 \u0641\u062d\u0635 \u0627\u0644\u0631\u0633\u0627\u0626\u0644 \u0627\u0644\u0645\u0632\u0639\u062c\u0629 \u0641\u0634\u0644."],"Cancel":["\u064a\u0644\u063a\u064a"],"Save Settings":["\u062d\u0641\u0638 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a"],"Settings saved successfully.":["\u062a\u0645 \u062d\u0641\u0638 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0628\u0646\u062c\u0627\u062d."],"Error saving settings.":["\u062e\u0637\u0623 \u0641\u064a \u062d\u0641\u0638 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a."],"New Form":["\u0646\u0645\u0648\u0630\u062c \u062c\u062f\u064a\u062f"],"Enter your full name":["\u0623\u062f\u062e\u0644 \u0627\u0633\u0645\u0643 \u0627\u0644\u0643\u0627\u0645\u0644"],"Enter your email address":["\u0623\u062f\u062e\u0644 \u0639\u0646\u0648\u0627\u0646 \u0628\u0631\u064a\u062f\u0643 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"],"Specify the quantity you need":["\u062d\u062f\u062f \u0627\u0644\u0643\u0645\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u062d\u062a\u0627\u062c\u0647\u0627"],"Add any specific requirements or questions here...":["\u0623\u0636\u0641 \u0623\u064a \u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0623\u0648 \u0623\u0633\u0626\u0644\u0629 \u0645\u062d\u062f\u062f\u0629 \u0647\u0646\u0627..."],"Loading...":["\u062a\u062d\u0645\u064a\u0644..."],"Your first form is saved":["\u062a\u0645 \u062d\u0641\u0638 \u0646\u0645\u0648\u0630\u062c\u0643 \u0627\u0644\u0623\u0648\u0644"],"The form is saved":["\u062a\u0645 \u062d\u0641\u0638 \u0627\u0644\u0646\u0645\u0648\u0630\u062c"],"It does not show on any product yet. Where should customers see it?":["\u0644\u0627 \u064a\u0638\u0647\u0631 \u0641\u064a \u0623\u064a \u0645\u0646\u062a\u062c \u0628\u0639\u062f. \u0623\u064a\u0646 \u064a\u0646\u0628\u063a\u064a \u0623\u0646 \u064a\u0631\u0627\u0647 \u0627\u0644\u0639\u0645\u0644\u0627\u0621\u061f"],"On all products":["\u0641\u064a \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a"],"On some categories or products":["\u0641\u064a \u0628\u0639\u0636 \u0627\u0644\u0641\u0626\u0627\u062a \u0623\u0648 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a"],"I will choose it on each product":["\u0633\u0623\u062e\u062a\u0627\u0631\u0647 \u0641\u064a \u0643\u0644 \u0645\u0646\u062a\u062c"],"To choose it on a product, open the product, go to the General tab and pick the form under \"Request a Quote Form\", below the tiered prices. A global pricing rule has the same field.":["\u0644\u0627\u062e\u062a\u064a\u0627\u0631\u0647 \u0641\u064a \u0645\u0646\u062a\u062c\u060c \u0627\u0641\u062a\u062d \u0627\u0644\u0645\u0646\u062a\u062c \u0648\u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u062a\u0628\u0648\u064a\u0628 \u0639\u0627\u0645 \u0648\u0627\u062e\u062a\u0631 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0636\u0645\u0646 \"\u0646\u0645\u0648\u0630\u062c \u0637\u0644\u0628 \u0639\u0631\u0636 \u0623\u0633\u0639\u0627\u0631\"\u060c \u0623\u0633\u0641\u0644 \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0645\u062a\u062f\u0631\u062c\u0629. \u0644\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u062a\u0633\u0639\u064a\u0631 \u0627\u0644\u0639\u0627\u0645\u0629 \u0627\u0644\u062d\u0642\u0644 \u0646\u0641\u0633\u0647."],"Are you sure you want to delete this form?":["\u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f \u0623\u0646\u0643 \u062a\u0631\u064a\u062f \u062d\u0630\u0641 \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c\u061f"],"Global settings saved successfully.":["\u062a\u0645 \u062d\u0641\u0638 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0639\u0627\u0645\u0629 \u0628\u0646\u062c\u0627\u062d."],"Error saving global settings.":["\u062d\u062f\u062b \u062e\u0637\u0623 \u0623\u062b\u0646\u0627\u0621 \u062d\u0641\u0638 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0639\u0627\u0645\u0629."],"Leave this form without saving? Your changes will be lost.":["\u0647\u0644 \u062a\u0631\u064a\u062f \u0645\u063a\u0627\u062f\u0631\u0629 \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u062f\u0648\u0646 \u062d\u0641\u0638\u061f \u0633\u062a\u0641\u0642\u062f \u062a\u063a\u064a\u064a\u0631\u0627\u062a\u0643."]}}}