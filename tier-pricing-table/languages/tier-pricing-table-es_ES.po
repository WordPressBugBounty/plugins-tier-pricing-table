#: src/Addons/CartUpsells/CartUpsellsAddon.php:9
msgid "Next tier message in the cart"
msgstr "Mensaje del siguiente nivel en el carrito"

#: src/Addons/CartUpsells/CartUpsellsAddon.php:13
msgid "\"Add 13 more to get $14.50 each\" under cart items, with a one-click quantity link and a progress bar."
msgstr "«Añade 13 más y llévatelo a 14,50 $ cada uno» bajo los artículos del carrito, con un enlace de cantidad de un clic y una barra de progreso."

#: src/Addons/CartUpsells/CartUpsellsService.php:235 src/Addons/CartUpsells/UpsellsSubsection.php:43 src/Addons/LayoutConfigurator/LayoutConfigurator.php:413
msgid "Add <b>{tp_required_quantity}</b> more to get <b>{tp_next_price}</b> each"
msgstr "Añade <b>{tp_required_quantity}</b> más para conseguir <b>{tp_next_price}</b> cada uno"

#: src/Addons/CartUpsells/UpsellsSubsection.php:11
msgid "Cart Upsell Messages"
msgstr "Mensajes de ventas adicionales del carrito"

#: src/Addons/CartUpsells/UpsellsSubsection.php:15
msgid "Display targeted messages in the cart to encourage customers to reach the next discount tier."
msgstr "Muestre mensajes específicos en el carrito para alentar a los clientes a alcanzar el siguiente nivel de descuento."

#: src/Addons/CartUpsells/UpsellsSubsection.php:26
msgid "Enable cart upsells"
msgstr "Habilitar ventas adicionales del carrito"

#: src/Addons/CartUpsells/UpsellsSubsection.php:34 src/Addons/ProductCatalogLoop/Settings/ProductCatalogLoopSettingsSection.php:468
msgid "Template"
msgstr "Plantilla"

#: src/Addons/CartUpsells/UpsellsSubsection.php:49
msgid "Quantity link"
msgstr "Enlace de cantidad"

#: src/Addons/CartUpsells/UpsellsSubsection.php:54
msgid "The required quantity in the message is a link: one click sets the cart line to the next tier and updates the cart."
msgstr "La cantidad requerida en el mensaje es un enlace: un clic ajusta la línea del carrito al siguiente nivel y actualiza el carrito."

#: src/Addons/CartUpsells/UpsellsSubsection.php:58 src/Addons/GlobalTieredPricing/CPT/Form/Tabs/OrderShipping.php:82
msgid "Progress bar"
msgstr "Barra de progreso"

#: src/Addons/CartUpsells/UpsellsSubsection.php:63
msgid "Show a bar under the message that fills up as the quantity approaches the next tier."
msgstr "Muestra una barra bajo el mensaje que se va llenando a medida que la cantidad se acerca al siguiente nivel."

#: src/Addons/CartUpsells/UpsellsSubsection.php:67
msgid "Upsell text color"
msgstr "Vender color de texto adicional"

#: src/Addons/CartUpsells/UpsellsSubsection.php:73
msgid "Note: This feature is not compatible with the Gutenberg Cart/Checkout blocks."
msgstr "Nota: Esta función no es compatible con los bloques de carrito/pago de Gutenberg."

#: src/Addons/CatalogPrices/CatalogPricesAddon.php:9
msgid "Lowest price and price range"
msgstr "Precio más bajo y rango de precios"

#: src/Addons/CatalogPrices/CatalogPricesAddon.php:13
msgid "Shows \"From $19.80\" or a price range for products with tiers, in the shop and as the product page price."
msgstr "Muestra «Desde 19,80 $» o un rango de precios en los productos con niveles, en la tienda y como precio de la página de producto."

