{"translation-revision-date":"2026-10-28T13:31:01+00:00","generator":"WP-CLI\/2.12.0","source":"src\/Addons\/LayoutConfigurator\/js-source\/components\/Controls.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"zh_CN","plural-forms":"nplurals=1; plural=0;"},"Apply to variable products":["\u9002\u7528\u4e8e\u53ef\u53d8\u4ea7\u54c1"],"Custom template":["\u81ea\u5b9a\u4e49\u6a21\u677f"],"Price":["\u4ef7\u683c"],"Quantity":["\u6570\u91cf"],"Discount":["\u6298\u6263"],"Total savings":["\u603b\u8282\u7701"],"Summary layout":["\u6982\u8981\u5e03\u5c40"],"Where it shows":["\u663e\u793a\u4f4d\u7f6e"],"Product lists":["\u4ea7\u54c1\u5217\u8868"],"All categories":["\u6240\u6709\u5206\u7c7b"],"Tiers per grid item":["\u6bcf\u4e2a\u7f51\u683c\u9879\u7684\u6863\u4f4d\u6570"],"All":["\u5168\u90e8"],"Bulk savings badge":["\u6279\u91cf\u4f18\u60e0\u5fbd\u7ae0"],"Dynamic price":["\u52a8\u6001\u4ef7\u683c"],"Update the displayed price to the tier price when the customer changes the quantity in the grid. Needs a quantity field on the grid item, from this plugin, the theme or another plugin.":["\u5ba2\u6237\u5728\u7f51\u683c\u4e2d\u66f4\u6539\u6570\u91cf\u65f6\uff0c\u5c06\u663e\u793a\u7684\u4ef7\u683c\u66f4\u65b0\u4e3a\u6863\u4f4d\u4ef7\u683c\u3002\u9700\u8981\u7f51\u683c\u9879\u4e0a\u6709\u6570\u91cf\u5b57\u6bb5\uff0c\u53ef\u6765\u81ea\u672c\u63d2\u4ef6\u3001\u4e3b\u9898\u6216\u5176\u4ed6\u63d2\u4ef6\u3002"],"Compact layout":["\u5e03\u5c40\u7d27\u51d1"],"Layout source":["\u5e03\u5c40\u6e90\u7801"],"Same as product page":["\u4e0e\u4ea7\u54c1\u9875\u9762\u76f8\u540c"],"Custom":["\u98ce\u4fd7"],"Spacing":["\u95f4\u8ddd"],"Auto":["\u81ea\u52a8"],"Cell padding":["\u5355\u5143\u683c\u5185\u8fb9\u8ddd"],"Tier order":["\u6863\u4f4d\u987a\u5e8f"],"Show discount":["\u663e\u793a\u6298\u6263"],"Discount format":["\u6298\u6263\u683c\u5f0f"],"Total":["\u5168\u90e8\u7684"],"Badge colour":["\u5fbd\u7ae0\u989c\u8272"],"Visibility":["\u53ef\u89c1\u6027"],"Options":["\u9009\u9879"],"Title":["\u6807\u9898"],"Singular":["\u5355\u6570"],"Plural":["\u590d\u6570"],"Enable compact layout":["\u542f\u7528\u7d27\u51d1\u5e03\u5c40"],"Quantity format":["\u6570\u91cf\u683c\u5f0f"],"Tooltip border":["\u5de5\u5177\u63d0\u793a\u8fb9\u6846"],"Make pricing tiers clickable":["\u4f7f\u5b9a\u4ef7\u7b49\u7ea7\u53ef\u70b9\u51fb"],"Labels":["\u6807\u7b7e"],"Format":["\u683c\u5f0f"],"Auto: the design style's own badge colours.":["\u81ea\u52a8\uff1a\u4f7f\u7528\u8bbe\u8ba1\u98ce\u683c\u81ea\u5e26\u7684\u5fbd\u7ae0\u989c\u8272\u3002"],"A light tint of this colour behind the badge text in this colour. Reset for the design style's own colours.":["\u5fbd\u7ae0\u6587\u5b57\u4f7f\u7528\u6b64\u989c\u8272\uff0c\u80cc\u540e\u886c\u4ee5\u6b64\u989c\u8272\u7684\u6d45\u8272\u5e95\u3002\u91cd\u7f6e\u53ef\u6062\u590d\u8bbe\u8ba1\u98ce\u683c\u81ea\u5e26\u7684\u989c\u8272\u3002"],"Auto: the badge follows the active tier colour.":["\u81ea\u52a8\uff1a\u5fbd\u7ae0\u8ddf\u968f\u5f53\u524d\u6863\u4f4d\u989c\u8272\u3002"],"The badge background; its text stays white. Reset for the active tier colour.":["\u5fbd\u7ae0\u80cc\u666f\u8272\uff1b\u6587\u5b57\u4fdd\u6301\u767d\u8272\u3002\u91cd\u7f6e\u53ef\u6062\u590d\u5f53\u524d\u6863\u4f4d\u989c\u8272\u3002"],"Auto: the savings bar follows the active tier colour.":["\u81ea\u52a8\uff1a\u8282\u7701\u8fdb\u5ea6\u6761\u8ddf\u968f\u5f53\u524d\u6863\u4f4d\u989c\u8272\u3002"],"The savings bar and the percentage next to it. Reset for the active tier colour.":["\u8282\u7701\u8fdb\u5ea6\u6761\u53ca\u5176\u65c1\u8fb9\u7684\u767e\u5206\u6bd4\u3002\u91cd\u7f6e\u53ef\u6062\u590d\u5f53\u524d\u6863\u4f4d\u989c\u8272\u3002"],"Available in the premium version.":["\u9ad8\u7ea7\u7248\u4e2d\u53ef\u7528\u3002"],"You can try it in the preview; the store shows it with premium only.":["\u60a8\u53ef\u4ee5\u5728\u9884\u89c8\u4e2d\u8bd5\u7528\uff1b\u5546\u5e97\u4e2d\u4ec5\u9ad8\u7ea7\u7248\u4f1a\u663e\u793a\u5b83\u3002"],"Depending on the theme, the pricing block may need small CSS adjustments to fit the grid.":["\u89c6\u4e3b\u9898\u800c\u5b9a\uff0c\u5b9a\u4ef7\u533a\u5757\u53ef\u80fd\u9700\u8981\u5c11\u91cf CSS \u8c03\u6574\u624d\u80fd\u9002\u914d\u7f51\u683c\u3002"],"Tiered pricing is not shown on shop and category pages.":["\u5546\u5e97\u548c\u5206\u7c7b\u9875\u9762\u4e0d\u663e\u793a\u9636\u68af\u5b9a\u4ef7\u3002"],"The layout is not inserted automatically. Place it with the [tiered-pricing-table] shortcode, the Tiered Pricing block or the widget; prices still update live.":["\u5e03\u5c40\u4e0d\u4f1a\u81ea\u52a8\u63d2\u5165\u3002\u8bf7\u4f7f\u7528 [tiered-pricing-table] \u7b80\u7801\u3001\u201c\u9636\u68af\u5b9a\u4ef7\u201d\u533a\u5757\u6216\u5c0f\u5de5\u5177\u653e\u7f6e\u5b83\uff1b\u4ef7\u683c\u4ecd\u4f1a\u5b9e\u65f6\u66f4\u65b0\u3002"],"Position":["\u4f4d\u7f6e"],"Cart prices":["\u8d2d\u7269\u8f66\u4ef7\u683c"],"Discounted items":["\u6298\u6263\u5546\u54c1"],"How items with a tiered price appear in the cart.":["\u5e26\u9636\u68af\u4ef7\u683c\u7684\u5546\u54c1\u5728\u8d2d\u7269\u8f66\u4e2d\u7684\u663e\u793a\u65b9\u5f0f\u3002"],"Show the original item price crossed out":["\u5212\u6389\u663e\u793a\u539f\u59cb\u5355\u4ef7"],"Show the original subtotal crossed out":["\u5212\u6389\u663e\u793a\u539f\u59cb\u5c0f\u8ba1"],"Cross out the regular price instead of the sale price":["\u5212\u6389\u539f\u4ef7\u800c\u975e\u4fc3\u9500\u4ef7"],"For products on sale.":["\u9002\u7528\u4e8e\u4fc3\u9500\u4e2d\u7684\u4ea7\u54c1\u3002"],"A row before the order total, in the cart totals and in the classic checkout's order review. Not available with the Checkout block.":["\u8d2d\u7269\u8f66\u5408\u8ba1\u4ee5\u53ca\u7ecf\u5178\u7ed3\u8d26\u9875\u8ba2\u5355\u786e\u8ba4\u4e2d\u3001\u8ba2\u5355\u603b\u8ba1\u4e4b\u524d\u7684\u4e00\u884c\u3002\u4e0d\u9002\u7528\u4e8e\u201c\u7ed3\u8d26\u201d\u533a\u5757\u3002"],"Show what the tiered prices take off the cart":["\u663e\u793a\u9636\u68af\u4ef7\u683c\u4e3a\u8d2d\u7269\u8f66\u8282\u7701\u7684\u91d1\u989d"],"Row label":["\u884c\u6807\u7b7e"],"Upsell message":["\u8ffd\u52a0\u9500\u552e\u63d0\u793a\u4fe1\u606f"],"Next tier message":["\u4e0b\u4e00\u6863\u4f4d\u63d0\u793a\u4fe1\u606f"],"Shown under the item name while a higher tier is within reach. Not available with the Cart block.":["\u5f53\u66f4\u9ad8\u6863\u4f4d\u89e6\u624b\u53ef\u53ca\u65f6\u663e\u793a\u5728\u5546\u54c1\u540d\u79f0\u4e0b\u65b9\u3002\u4e0d\u9002\u7528\u4e8e\u201c\u8d2d\u7269\u8f66\u201d\u533a\u5757\u3002"],"Show a message about the next tier":["\u663e\u793a\u5173\u4e8e\u4e0b\u4e00\u6863\u4f4d\u7684\u63d0\u793a\u4fe1\u606f"],"Next tier shortcuts":["\u4e0b\u4e00\u6863\u4f4d\u5feb\u6377\u94fe\u63a5"],"Make the quantity a link that sets the cart to the next tier":["\u5c06\u6570\u91cf\u8bbe\u4e3a\u94fe\u63a5\uff0c\u70b9\u51fb\u540e\u8d2d\u7269\u8f66\u8df3\u5230\u4e0b\u4e00\u6863\u4f4d"],"One click moves the line to the next tier and updates the cart.":["\u70b9\u51fb\u4e00\u6b21\u5373\u53ef\u5c06\u8be5\u884c\u63d0\u5347\u5230\u4e0b\u4e00\u6863\u4f4d\u5e76\u66f4\u65b0\u8d2d\u7269\u8f66\u3002"],"Show a progress bar to the next tier":["\u663e\u793a\u5230\u4e0b\u4e00\u6863\u4f4d\u7684\u8fdb\u5ea6\u6761"],"Message colour":["\u63d0\u793a\u4fe1\u606f\u989c\u8272"],"Layout":["\u5e03\u5c40"],"Show on shop and category pages":["\u5728\u5546\u5e97\u548c\u5206\u7c7b\u9875\u9762\u663e\u793a"],"Show on the product page":["\u5728\u4ea7\u54c1\u9875\u9762\u663e\u793a"],"The badge shows in every product list: the shop, categories, search, related products, shortcodes and blocks.":["\u5fbd\u7ae0\u663e\u793a\u5728\u6240\u6709\u4ea7\u54c1\u5217\u8868\u4e2d\uff1a\u5546\u5e97\u3001\u5206\u7c7b\u3001\u641c\u7d22\u3001\u76f8\u5173\u4ea7\u54c1\u3001\u7b80\u7801\u548c\u533a\u5757\u3002"],"Every product list: the shop, categories, search, related products, shortcodes and blocks.":["\u6240\u6709\u4ea7\u54c1\u5217\u8868\uff1a\u5546\u5e97\u3001\u5206\u7c7b\u3001\u641c\u7d22\u3001\u76f8\u5173\u4ea7\u54c1\u3001\u7b80\u7801\u548c\u533a\u5757\u3002"],"The product lists that show tiered pricing.":["\u663e\u793a\u9636\u68af\u5b9a\u4ef7\u7684\u4ea7\u54c1\u5217\u8868\u3002"],"Only for products in":["\u4ec5\u9650\u4ee5\u4e0b\u5206\u7c7b\u4e2d\u7684\u4ea7\u54c1"],"Type to search categories. Leave empty for every product; a category covers its child categories.":["\u8f93\u5165\u4ee5\u641c\u7d22\u5206\u7c7b\u3002\u7559\u7a7a\u5219\u9002\u7528\u4e8e\u6240\u6709\u4ea7\u54c1\uff1b\u5206\u7c7b\u5305\u542b\u5176\u5b50\u5206\u7c7b\u3002"],"Grid item":["\u7f51\u683c\u9879"],"Minimal styling so the pricing block fits the product grid.":["\u6781\u7b80\u6837\u5f0f\uff0c\u4f7f\u5b9a\u4ef7\u533a\u5757\u9002\u914d\u4ea7\u54c1\u7f51\u683c\u3002"],"Quantity selector in the grid":["\u7f51\u683c\u4e2d\u7684\u6570\u91cf\u9009\u62e9\u5668"],"Adds a quantity field to every grid item. Only for themes that do not have one.":["\u4e3a\u6bcf\u4e2a\u7f51\u683c\u9879\u6dfb\u52a0\u6570\u91cf\u5b57\u6bb5\u3002\u4ec5\u9002\u7528\u4e8e\u672c\u8eab\u6ca1\u6709\u6570\u91cf\u5b57\u6bb5\u7684\u4e3b\u9898\u3002"],"The rest sit behind a \"+N more\" link to the product page.":["\u5176\u4f59\u6863\u4f4d\u6298\u53e0\u5728\u6307\u5411\u4ea7\u54c1\u9875\u7684\u201c\u8fd8\u6709 N \u4e2a\u201d\u94fe\u63a5\u540e\u3002"],"Shop and category pages use the product page layout and its settings.":["\u5546\u5e97\u548c\u5206\u7c7b\u9875\u9762\u4f7f\u7528\u4ea7\u54c1\u9875\u9762\u7684\u5e03\u5c40\u53ca\u5176\u8bbe\u7f6e\u3002"],"Design style":["\u8bbe\u8ba1\u98ce\u683c"],"A space-saving version of the selected design style.":["\u6240\u9009\u8bbe\u8ba1\u98ce\u683c\u7684\u7d27\u51d1\u7248\u672c\u3002"],"Auto: each design style keeps its own spacing.":["\u81ea\u52a8\uff1a\u6bcf\u79cd\u8bbe\u8ba1\u98ce\u683c\u4fdd\u7559\u81ea\u8eab\u7684\u95f4\u8ddd\u3002"],"Gap between the tiers. Reset for the design style's own spacing.":["\u6863\u4f4d\u4e4b\u95f4\u7684\u95f4\u8ddd\u3002\u91cd\u7f6e\u53ef\u6062\u590d\u8bbe\u8ba1\u98ce\u683c\u81ea\u8eab\u7684\u95f4\u8ddd\u3002"],"Auto: each design style keeps its own cell padding.":["\u81ea\u52a8\uff1a\u6bcf\u79cd\u8bbe\u8ba1\u98ce\u683c\u4fdd\u7559\u81ea\u8eab\u7684\u5355\u5143\u683c\u5185\u8fb9\u8ddd\u3002"],"Padding inside each cell; it also overrides the theme's cell padding. Reset for the design style's own padding.":["\u6bcf\u4e2a\u5355\u5143\u683c\u7684\u5185\u8fb9\u8ddd\uff1b\u540c\u65f6\u4f1a\u8986\u76d6\u4e3b\u9898\u7684\u5355\u5143\u683c\u5185\u8fb9\u8ddd\u3002\u91cd\u7f6e\u53ef\u6062\u590d\u8bbe\u8ba1\u98ce\u683c\u81ea\u8eab\u7684\u5185\u8fb9\u8ddd\u3002"],"Active tier colour":["\u5f53\u524d\u6863\u4f4d\u989c\u8272"],"Taken from your theme (%s) when the plugin was installed.":["\u5b89\u88c5\u63d2\u4ef6\u65f6\u53d6\u81ea\u60a8\u7684\u4e3b\u9898\uff08%s\uff09\u3002"],"Discount badge colour":["\u6298\u6263\u5fbd\u7ae0\u989c\u8272"],"Reset":["\u91cd\u7f6e"],"Active tier border":["\u5f53\u524d\u6863\u4f4d\u8fb9\u6846"],"Mark the active tier with a left border":["\u7528\u5de6\u8fb9\u6846\u6807\u8bb0\u5f53\u524d\u6863\u4f4d"],"A bar in the active tier colour at the left of the row.":["\u884c\u5de6\u4fa7\u4e00\u6761\u91c7\u7528\u5f53\u524d\u6863\u4f4d\u989c\u8272\u7684\u7ad6\u6761\u3002"],"e.g. Buy more, pay less":["\u4f8b\u5982\u201c\u4e70\u5f97\u8d8a\u591a\uff0c\u8d8a\u5212\u7b97\u201d"],"Quantity unit":["\u6570\u91cf\u5355\u4f4d"],"Shown next to quantities, e.g. pieces, boxes, packs. Leave empty for none.":["\u663e\u793a\u5728\u6570\u91cf\u65c1\u8fb9\uff0c\u4f8b\u5982\u4ef6\u3001\u76d2\u3001\u5305\u3002\u7559\u7a7a\u5219\u4e0d\u663e\u793a\u3002"],"Column headers":["\u5217\u6807\u9898"],"Leave a header empty to hide that column.":["\u5217\u6807\u9898\u7559\u7a7a\u53ef\u9690\u85cf\u8be5\u5217\u3002"],"Tooltip icon":["\u5de5\u5177\u63d0\u793a\u56fe\u6807"],"Colour and size of the icon shown next to the price.":["\u4ef7\u683c\u65c1\u6240\u793a\u56fe\u6807\u7684\u989c\u8272\u548c\u5927\u5c0f\u3002"],"Option text":["\u9009\u9879\u6587\u5b57"],"Text of each pricing option. Click a variable to insert it.":["\u6bcf\u4e2a\u5b9a\u4ef7\u9009\u9879\u7684\u6587\u5b57\u3002\u70b9\u51fb\u53d8\u91cf\u5373\u53ef\u63d2\u5165\u3002"],"Base price option":["\u57fa\u7840\u4ef7\u683c\u9009\u9879"],"Show an option for the regular price (no discount)":["\u663e\u793a\u539f\u4ef7\u9009\u9879\uff08\u65e0\u6298\u6263\uff09"],"Pricing string":["\u5b9a\u4ef7\u6587\u5b57"],"Text shown for each pricing tier. Click a variable to insert it.":["\u6bcf\u4e2a\u5b9a\u4ef7\u6863\u4f4d\u663e\u793a\u7684\u6587\u5b57\u3002\u70b9\u51fb\u53d8\u91cf\u5373\u53ef\u63d2\u5165\u3002"],"First tier":["\u7b2c\u4e00\u6863"],"Show the regular price tier (no discount)":["\u663e\u793a\u539f\u4ef7\u6863\u4f4d\uff08\u65e0\u6298\u6263\uff09"],"Show the original price crossed out":["\u5212\u6389\u663e\u793a\u539f\u59cb\u4ef7\u683c"],"Show the total for the selected option":["\u663e\u793a\u6240\u9009\u9009\u9879\u7684\u603b\u4ef7"],"Clicking a tier selects its quantity.":["\u70b9\u51fb\u6863\u4f4d\u5373\u53ef\u9009\u62e9\u5176\u6570\u91cf\u3002"],"Price display":["\u4ef7\u683c\u663e\u793a"],"Price behaviour":["\u4ef7\u683c\u884c\u4e3a"],"Update the price on quantity change":["\u6570\u91cf\u53d8\u5316\u65f6\u66f4\u65b0\u4ef7\u683c"],"The main price follows the quantity the customer enters.":["\u4e3b\u4ef7\u683c\u8ddf\u968f\u5ba2\u6237\u8f93\u5165\u7684\u6570\u91cf\u3002"],"Next to the discounted tier price.":["\u6298\u6263\u6863\u4f4d\u4ef7\u683c\u65c1\u8fb9\u3002"],"Show the total price (price \u00d7 quantity)":["\u663e\u793a\u603b\u4ef7\uff08\u5355\u4ef7 \u00d7 \u6570\u91cf\uff09"],"Instead of the price per item.":["\u4ee3\u66ff\u6bcf\u4ef6\u4ef7\u683c\u3002"],"Also for products without tiered pricing":["\u4e5f\u9002\u7528\u4e8e\u6ca1\u6709\u9636\u68af\u5b9a\u4ef7\u7684\u4ea7\u54c1"],"Savings badge":["\u8282\u7701\u5fbd\u7ae0"],"Badge":["\u5fbd\u7ae0"],"Shown when the selected quantity has a discount. Also available as the [tiered_price_you_save] shortcode.":["\u6240\u9009\u6570\u91cf\u6709\u6298\u6263\u65f6\u663e\u793a\u3002\u4e5f\u53ef\u901a\u8fc7 [tiered_price_you_save] \u7b80\u7801\u4f7f\u7528\u3002"],"Show the savings badge":["\u663e\u793a\u8282\u7701\u5fbd\u7ae0"],"Style":["\u6837\u5f0f"],"Text: the colour as text colour. Pill: a filled label with white text. Outlined: a bordered label.":["\u6587\u5b57\uff1a\u4ee5\u6b64\u989c\u8272\u4f5c\u4e3a\u6587\u5b57\u989c\u8272\u3002\u80f6\u56ca\uff1a\u586b\u5145\u8272\u6807\u7b7e\uff0c\u767d\u8272\u6587\u5b57\u3002\u63cf\u8fb9\uff1a\u5e26\u8fb9\u6846\u7684\u6807\u7b7e\u3002"],"Reset for the active tier colour.":["\u91cd\u7f6e\u53ef\u6062\u590d\u5f53\u524d\u6863\u4f4d\u989c\u8272\u3002"],"Badge options":["\u5fbd\u7ae0\u9009\u9879"],"Include the WooCommerce sale discount":["\u5305\u542b WooCommerce \u4fc3\u9500\u6298\u6263"],"An existing sale discount counts towards the savings.":["\u5df2\u6709\u7684\u4fc3\u9500\u6298\u6263\u8ba1\u5165\u8282\u7701\u91d1\u989d\u3002"],"Show for products without tiered pricing":["\u5bf9\u6ca1\u6709\u9636\u68af\u5b9a\u4ef7\u7684\u4ea7\u54c1\u4e5f\u663e\u793a"],"For regular sale products.":["\u9002\u7528\u4e8e\u6b63\u5e38\u9500\u552e\u7684\u4ea7\u54c1\u3002"],"Pricing summary":["\u5b9a\u4ef7\u6458\u8981"],"Summary block":["\u6458\u8981\u533a\u5757"],"Quantity, price per item and total for the selected quantity, near the pricing layout.":["\u6240\u9009\u6570\u91cf\u7684\u6570\u91cf\u3001\u6bcf\u4ef6\u4ef7\u683c\u548c\u603b\u4ef7\uff0c\u663e\u793a\u5728\u5b9a\u4ef7\u5e03\u5c40\u9644\u8fd1\u3002"],"Show the pricing summary block":["\u663e\u793a\u5b9a\u4ef7\u6458\u8981\u533a\u5757"],"e.g. Your order":["\u4f8b\u5982\u201c\u60a8\u7684\u8ba2\u5355\u201d"],"Each":["\u6bcf\u4ef6"],"A badge on the product image with the biggest discount the product's tiers give. Shows whether or not the pricing does, in the lists \"Where it shows\" allows.":["\u4ea7\u54c1\u56fe\u7247\u4e0a\u7684\u5fbd\u7ae0\uff0c\u663e\u793a\u8be5\u4ea7\u54c1\u5404\u6863\u4f4d\u4e2d\u7684\u6700\u5927\u6298\u6263\u3002\u65e0\u8bba\u5b9a\u4ef7\u672c\u8eab\u662f\u5426\u663e\u793a\uff0c\u90fd\u4f1a\u5728\u201c\u663e\u793a\u4f4d\u7f6e\u201d\u5141\u8bb8\u7684\u5217\u8868\u4e2d\u663e\u793a\u3002"],"Show a bulk savings badge":["\u663e\u793a\u6279\u91cf\u4f18\u60e0\u5fbd\u7ae0"],"Auto: the active tier colour.":["\u81ea\u52a8\uff1a\u4f7f\u7528\u5f53\u524d\u6863\u4f4d\u989c\u8272\u3002"],"The price shown in the product grid for products with tiered pricing.":["\u5728\u4ea7\u54c1\u7f51\u683c\u4e2d\u4e3a\u6709\u9636\u68af\u5b9a\u4ef7\u7684\u4ea7\u54c1\u663e\u793a\u7684\u4ef7\u683c\u3002"],"Replace the regular price":["\u66ff\u6362\u539f\u4ef7"],"Show the lowest tier price or a price range instead.":["\u6539\u4e3a\u663e\u793a\u6700\u4f4e\u6863\u4f4d\u4ef7\u683c\u6216\u4ef7\u683c\u533a\u95f4\u3002"],"Lowest and highest prices across all variations.":["\u6240\u6709\u53d8\u4f53\u4e2d\u7684\u6700\u4f4e\u4ef7\u548c\u6700\u9ad8\u4ef7\u3002"],"Prefix for the lowest price":["\u6700\u4f4e\u4ef7\u524d\u7f00"],"Click a variable to insert it.":["\u70b9\u51fb\u53d8\u91cf\u5373\u53ef\u63d2\u5165\u3002"]}}}