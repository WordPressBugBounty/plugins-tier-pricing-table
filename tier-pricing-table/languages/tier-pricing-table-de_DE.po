msgid "Coupons and tiered prices"
msgstr "Gutscheine und Staffelpreise"

#: src/Addons/Coupons/CouponsAddon.php:51
msgid "Apply on top of tiered prices"
msgstr "Zusätzlich zu den Staffelpreisen anwenden"

#: src/Addons/Coupons/CouponsAddon.php:52
msgid "Switch tiered prices off"
msgstr "Staffelpreise ausschalten"

#: src/Addons/Coupons/CouponsAddon.php:53
