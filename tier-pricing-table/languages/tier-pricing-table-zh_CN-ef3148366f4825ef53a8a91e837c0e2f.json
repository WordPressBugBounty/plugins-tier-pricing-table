f7\u6c42\u3002"],"Preview Mode:":["\u9884\u89c8\u6a21\u5f0f\uff1a"],"You are currently using the free version of Tiered Pricing Table. The Request a Quote feature is available for creation and previewing purposes, but it will not be active on the frontend for your customers.":["\u60a8\u5f53\u524d\u6b63\u5728\u4f7f\u7528\u514d\u8d39\u7248\u672c\u7684\u5206\u5c42\u5b9a\u4ef7\u8868\u3002\u8bf7\u6c42\u62a5\u4ef7\u529f\u80fd\u53ef\u7528\u4e8e\u521b\u5efa\u548c\u9884\u89c8\u76ee\u7684\uff0c\u4f46\u4e0d\u4f1a\u5728\u60a8\u7684\u5ba2\u6237\u7684\u524d\u7aef\u4e0a\u6fc0\u6d3b\u3002"],"Upgrade to Premium to unlock this feature &rarr;":["\u5347\u7ea7\u5230\u9ad8\u7ea7\u7248\u4ee5\u89e3\u9501\u6b64\u529f\u80fd \u2192"],"Request a Quote Forms":["\u7d22\u53d6\u62a5\u4ef7\u8868\u683c"],"Add New Form":["\u6dfb\u52a0\u65b0\u8868\u683c"],"Form Name":["\u8868\u683c\u540d\u79f0"],"Shows on":["\u663e\u793a\u4e8e"],"Actions":["\u884c\u52a8"],"Multiple products":["\u591a\u4e2a\u4ea7\u54c1"],"Some categories and products":["\u90e8\u5206\u5206\u7c7b\u548c\u4ea7\u54c1"],"%d product or pricing rule":["%d \u4e2a\u4ea7\u54c1\u548c\u5b9a\u4ef7\u89c4\u5219"],"Nowhere yet":["\u6682\u65e0"],"Below the pricing layout":["\u5b9a\u4ef7\u5e03\u5c40\u4e0b\u65b9"],"Inside the pricing layout":["\u5728\u5b9a\u4ef7\u5e03\u5c40\u5185"],"Next to Add to cart":["\u5728\u201c\u52a0\u5165\u8d2d\u7269\u8f66\u201d\u65c1"],"Delete":["\u5220\u9664"],"Create the page":["\u521b\u5efa\u9875\u9762"],"Or use a page that shows the list":["\u6216\u4f7f\u7528\u663e\u793a\u6e05\u5355\u7684\u9875\u9762"],"Choose a page":["\u9009\u62e9\u9875\u9762"],"Use this page":["\u4f7f\u7528\u6b64\u9875\u9762"],"Nothing found.":["\u672a\u627e\u5230\u4efb\u4f55\u5185\u5bb9\u3002"],"Nothing more to add.":["\u6ca1\u6709\u66f4\u591a\u53ef\u6dfb\u52a0\u7684\u4e86\u3002"],"#%s (deleted)":["#%s\uff08\u5df2\u5220\u9664\uff09"],"Option":["\u9009\u9879"],"Choose a file":["\u9009\u62e9\u6587\u4ef6"],"dd\/mm\/yyyy":["\u65e5\/\u6708\/\u5e74"],"(no title