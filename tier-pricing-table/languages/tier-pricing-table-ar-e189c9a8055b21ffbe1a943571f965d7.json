rt: the Global pricing rules add-on is switched off.":["\u0644\u0627 \u062a\u0634\u0627\u0631\u0643 \u0623\u064a \u0642\u0627\u0639\u062f\u0629 \u062a\u0633\u0639\u064a\u0631 \u0639\u0627\u0644\u0645\u064a\u0629: \u0648\u062d\u062f\u0629 \u0642\u0648\u0627\u0639\u062f \u0627\u0644\u062a\u0633\u0639\u064a\u0631 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629 \u0645\u0639\u0637\u0651\u0644\u0629."],"Source of the prices: %s.":["\u0645\u0635\u062f\u0631 \u0627\u0644\u0623\u0633\u0639\u0627\u0631: %s."],"Quantity limits: %s.":["\u062d\u062f\u0648\u062f \u0627\u0644\u0643\u0645\u064a\u0629: %s."],"No quantity limits.":["\u0644\u0627 \u062a\u0648\u062c\u062f \u062d\u062f\u0648\u062f \u0644\u0644\u0643\u0645\u064a\u0629."],"Price per item":["\u0633\u0639\u0631 \u0627\u0644\u0642\u0637\u0639\u0629"],"Verdict":["\u0627\u0644\u0646\u062a\u064a\u062c\u0629"],"Why":["\u0627\u0644\u0633\u0628\u0628"],"The rule you came from":["\u0627\u0644\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u062a\u064a \u0623\u062a\u064a\u062a \u0645\u0646\u0647\u0627"],"for":["\u0644\u0640"],"What the customer pays":["\u0645\u0627 \u064a\u062f\u0641\u0639\u0647 \u0627\u0644\u0639\u0645\u064a\u0644"],"Rules are matched in priority order: the lowest number first, and the newer rule first when numbers are equal. The first active rule that matches is applied.":["\u062a\u064f\u0637\u0627\u0628\u0642 \u0627\u0644\u0642\u0648\u0627\u0639\u062f \u062d\u0633\u0628 \u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629: \u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0623\u0642\u0644 \u0623\u0648\u0644\u064b\u0627\u060c \u0648\u0627\u0644\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0623\u062d\u062f\u062b \u0623\u0648\u0644\u064b\u0627 \u0639\u0646\u062f \u062a\u0633\u0627\u0648\u064a \u0627\u0644\u0623\u0631\u0642\u0627\u0645. \u0648\u062a\u064f\u0637\u0628\u0651\u0642 \u0623\u0648\u0644 \u0642\u0627\u0639\u062f\u0629 \u0646\u0634\u0637\u0629 \u0645\u0637\u0627\u0628\u0642\u0629."],"The Global pricing rules add-on is switched off (see the modules above), so no rule takes part in pricing.":["\u0648\u062d\u062f\u0629 \u0642\u0648\u0627\u0639\u062f \u0627\u0644\u062a\u0633\u0639\u064a\u0631 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629 \u0645\u0639\u0637\u0651\u0644\u0629 (\u0627\u0646\u0638\u0631 \u0627\u0644\u0648\u062d\u062f\u0627\u062a \u0623\u0639\u0644\u0627\u0647)\u060c \u0644\u0630\u0627 \u0644\u0627 \u062a\u0634\u0627\u0631\u0643 \u0623\u064a \u0642\u0627\u0639\u062f\u0629 \u0641\u064a \u0627\u0644\u062a\u0633\u0639\u064a\u0631."],"There are no global pricing rules yet.":["\u0644\u0627 \u062a\u0648\u062c\u062f \u0642\u0648\u0627\u0639\u062f \u062a\u0633\u0639\u064a\u0631 \u0639\u0627\u0644\u0645\u064a\u0629 \u0628\u0639\u062f."],"Add a pricing rule":["\u0625\u0636\u0627\u0641\u0629 \u0642\u0627\u0639\u062f\u0629 \u062a\u0633\u0639\u064a\u0631"],"Pricing log":["\u0633\u062c\u0644 \u0627\u0644\u062a\u0633\u0639\u064a\u0631"],"Pricing Test":["\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u062a\u0633\u0639\u064a\u0631"],"See what a customer pays for a product without opening the storefront: which global pricing rule applies and why, which one wins when several match, and the prices per quantity.":["\u0627\u0637\u0651\u0644\u0639 \u0639\u0644\u0649 \u0645\u0627 \u064a\u062f\u0641\u0639\u0647 \u0627\u0644\u0639\u0645\u064a\u0644 \u0644\u0645\u0646\u062a\u062c \u0645\u0627 \u062f\u0648\u0646 \u0641\u062a\u062d \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u062a\u062c\u0631: \u0623\u064a \u0642\u0627\u0639\u062f\u0629 \u062a\u0633\u0639\u064a\u0631 \u0639\u0627\u0644\u0645\u064a\u0629 \u062a\u0646\u0637\u0628\u0642 \u0648\u0644\u0645\u0627\u0630\u0627\u060c \u0648\u0623\u064a\u0647\u0627 \u062a\u0641\u0648\u0632 \u0639\u0646\u062f \u062a\u0637\u0627\u0628\u0642 \u0639\u062f\u0629 \u0642\u0648\u0627\u0639\u062f\u060c \u0648\u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u062d\u0633\u0628 \u0627\u0644\u0643\u0645\u064a\u0629."],"Checking the rule":["\u062c\u0627\u0631\u064d \u0641\u062d\u0635 \u0627\u0644\u0642\u0627\u0639\u062f\u0629"],"Pick a product and a customer; the rule is highlighted in the results.":["\u0627\u062e\u062a\u0631 \u0645\u0646\u062a\u062c\u064b\u0627 \u0648\u0639\u0645\u064a\u0644\u064b\u0627\u061b \u0648\u0633\u062a\u064f\u0628\u0631\u0632 \u0627\u0644\u0642\u0627\u0639\u062f\u0629 \u0641\u064a \u0627\u0644\u0646\u062a\u0627\u0626\u062c."],"Type to search products and variations.":["\u0627\u0643\u062a\u0628 \u0644\u0644\u0628\u062d\u062b \u0641\u064a \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0648\u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0627\u062a."],"A customer":["\u0639\u0645\u064a\u0644"],"Which customer":["\u0623\u064a \u0639\u0645\u064a\u0644"],"Type a name or an email address.":["\u0627\u0643\u062a\u0628 \u0627\u0633\u0645\u064b\u0627 \u0623\u0648 \u0639\u0646\u0648\u0627\u0646 \u0628\u0631\u064a\u062f \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a."],"The test could not run. Reload the page and try again.":["\u062a\u0639\u0630\u0631 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631. \u0623\u0639\u062f \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0635\u0641\u062d\u0629 \u0648\u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."],"Testing\u2026":["\u062c\u0627\u0631\u064d \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631\u2026"],"Run the test":["\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631"],"Rules are tested as they are saved.":["\u062a\u064f\u062e\u062a\u0628\u0631 \u0627\u0644\u0642\u0648\u0627\u0639\u062f \u0628\u062d\u0627\u0644\u062a\u0647\u0627 \u0627\u0644\u0645\u062d\u0641\u0648\u0638\u0629."],"Roles Management":["\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0623\u062f\u0648\u0627\u0631"],"Data Clean Up":["\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a"]}}}