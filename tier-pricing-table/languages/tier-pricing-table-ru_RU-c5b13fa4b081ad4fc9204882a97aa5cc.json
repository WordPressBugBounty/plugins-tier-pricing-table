{"translation-revision-date":"2026-10-28T13:31:01+00:00","generator":"WP-CLI\/2.12.0","source":"src\/Addons\/LayoutConfigurator\/js-source\/components\/Controls.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ru_RU","plural-forms":"nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);"},"Apply to variable products":["\u041f\u0440\u0438\u043c\u0435\u043d\u0438\u0442\u044c \u043a \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430\u043c"],"Custom template":["\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u0448\u0430\u0431\u043b\u043e\u043d"],"Price":["\u0426\u0435\u043d\u0430"],"Quantity":["\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e"],"Discount":["\u0421\u043a\u0438\u0434\u043a\u0430"],"Total savings":["\u041e\u0431\u0449\u0430\u044f \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u044f"],"Summary layout":["\u0421\u0432\u043e\u0434\u043d\u044b\u0439 \u043c\u0430\u043a\u0435\u0442"],"Where it shows":["\u0413\u0434\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c"],"Product lists":["\u0421\u043f\u0438\u0441\u043a\u0438 \u0442\u043e\u0432\u0430\u0440\u043e\u0432"],"All categories":["\u0412\u0441\u0435 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438"],"Tiers per grid item":["\u0423\u0440\u043e\u0432\u043d\u0435\u0439 \u043d\u0430 \u044d\u043b\u0435\u043c\u0435\u043d\u0442 \u0441\u0435\u0442\u043a\u0438"],"All":["\u0412\u0441\u0435"],"Bulk savings badge":["\u0417\u043d\u0430\u0447\u043e\u043a \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0438 \u0437\u0430 \u043e\u0431\u044a\u0435\u043c"],"Dynamic price":["\u0414\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0446\u0435\u043d\u0430"],"Update the displayed price to the tier price when the customer changes the quantity in the grid. Needs a quantity field on the grid item, from this plugin, the theme or another plugin.":["\u041e\u0431\u043d\u043e\u0432\u043b\u044f\u0442\u044c \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u043c\u0443\u044e \u0446\u0435\u043d\u0443 \u0434\u043e \u0446\u0435\u043d\u044b \u0443\u0440\u043e\u0432\u043d\u044f, \u043a\u043e\u0433\u0434\u0430 \u043a\u043b\u0438\u0435\u043d\u0442 \u043c\u0435\u043d\u044f\u0435\u0442 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0432 \u0441\u0435\u0442\u043a\u0435. \u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u043f\u043e\u043b\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0432 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0435 \u0441\u0435\u0442\u043a\u0438 \u2014 \u043e\u0442 \u044d\u0442\u043e\u0433\u043e \u043f\u043b\u0430\u0433\u0438\u043d\u0430, \u0442\u0435\u043c\u044b \u0438\u043b\u0438 \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u043f\u043b\u0430\u0433\u0438\u043d\u0430."],"Compact layout":["\u041a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u0430\u044f \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u043a\u0430"],"Layout source":["\u0418\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u043c\u0430\u043a\u0435\u0442\u0430"],"Same as product page":["\u0422\u043e \u0436\u0435, \u0447\u0442\u043e \u0438 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430"],"Custom":["\u041e\u0431\u044b\u0447\u0430\u0439"],"Spacing":["\u0418\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u044b"],"Auto":["\u0410\u0432\u0442\u043e"],"Cell padding":["\u041e\u0442\u0441\u0442\u0443\u043f\u044b \u0432 \u044f\u0447\u0435\u0439\u043a\u0430\u0445"],"Tier order":["\u041f\u043e\u0440\u044f\u0434\u043e\u043a \u0443\u0440\u043e\u0432\u043d\u0435\u0439"],"Show discount":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0441\u043a\u0438\u0434\u043a\u0443"],"Discount format":["\u0424\u043e\u0440\u043c\u0430\u0442 \u0441\u043a\u0438\u0434\u043a\u0438"],"Total":["\u041e\u0431\u0449\u0438\u0439"],"Badge colour":["\u0426\u0432\u0435\u0442 \u0437\u043d\u0430\u0447\u043a\u0430"],"Visibility":["\u0412\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u044c"],"Options":["\u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b"],"Title":["\u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a"],"Singular":["\u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e"],"Plural":["\u041c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e"],"Enable compact layout":["\u0412\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u044b\u0439 \u043c\u0430\u043a\u0435\u0442"],"Quantity format":["\u0424\u043e\u0440\u043c\u0430\u0442 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430"],"Tooltip border":["\u0413\u0440\u0430\u043d\u0438\u0446\u0430 \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0438"],"Make pricing tiers clickable":["\u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0446\u0435\u043d\u043e\u0432\u044b\u0435 \u0443\u0440\u043e\u0432\u043d\u0438 \u043a\u043b\u0438\u043a\u0430\u0431\u0435\u043b\u044c\u043d\u044b\u043c\u0438"],"Labels":["\u042d\u0442\u0438\u043a\u0435\u0442\u043a\u0438"],"Format":["\u0424\u043e\u0440\u043c\u0430\u0442"],"Auto: the design style's own badge colours.":["\u0410\u0432\u0442\u043e: \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0446\u0432\u0435\u0442\u0430 \u0437\u043d\u0430\u0447\u043a\u0430 \u0432 \u0441\u0442\u0438\u043b\u0435 \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u044f."],"A light tint of this colour behind the badge text in this colour. Reset for the design style's own colours.":["\u0421\u0432\u0435\u0442\u043b\u044b\u0439 \u043e\u0442\u0442\u0435\u043d\u043e\u043a \u044d\u0442\u043e\u0433\u043e \u0446\u0432\u0435\u0442\u0430 \u0437\u0430 \u0442\u0435\u043a\u0441\u0442\u043e\u043c \u0437\u043d\u0430\u0447\u043a\u0430, \u0441\u0430\u043c \u0442\u0435\u043a\u0441\u0442 \u2014 \u044d\u0442\u0438\u043c \u0446\u0432\u0435\u0442\u043e\u043c. \u0421\u0431\u0440\u043e\u0441\u044c\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0446\u0432\u0435\u0442\u0430 \u0441\u0442\u0438\u043b\u044f \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u044f."],"Auto: the badge follows the active tier colour.":["\u0410\u0432\u0442\u043e: \u0437\u043d\u0430\u0447\u043e\u043a \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 \u0446\u0432\u0435\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f."],"The badge background; its text stays white. Reset for the active tier colour.":["\u0424\u043e\u043d \u0437\u043d\u0430\u0447\u043a\u0430; \u0442\u0435\u043a\u0441\u0442 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u0431\u0435\u043b\u044b\u043c. \u0421\u0431\u0440\u043e\u0441\u044c\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0446\u0432\u0435\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f."],"Auto: the savings bar follows the active tier colour.":["\u0410\u0432\u0442\u043e: \u043f\u043e\u043b\u043e\u0441\u0430 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 \u0446\u0432\u0435\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f."],"The savings bar and the percentage next to it. Reset for the active tier colour.":["\u041f\u043e\u043b\u043e\u0441\u0430 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0438 \u0438 \u043f\u0440\u043e\u0446\u0435\u043d\u0442 \u0440\u044f\u0434\u043e\u043c \u0441 \u043d\u0435\u0439. \u0421\u0431\u0440\u043e\u0441\u044c\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0446\u0432\u0435\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f."],"Available in the premium version.":["\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u043e \u0432 \u043f\u0440\u0435\u043c\u0438\u0443\u043c-\u0432\u0435\u0440\u0441\u0438\u0438."],"You can try it in the preview; the store shows it with premium only.":["\u041c\u043e\u0436\u043d\u043e \u043f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u0442\u044c \u0432 \u043f\u0440\u0435\u0434\u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0435; \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435 \u044d\u0442\u043e \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0441 \u043f\u0440\u0435\u043c\u0438\u0443\u043c-\u0432\u0435\u0440\u0441\u0438\u0435\u0439."],"Depending on the theme, the pricing block may need small CSS adjustments to fit the grid.":["\u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0442\u0435\u043c\u044b \u0431\u043b\u043e\u043a\u0443 \u0446\u0435\u043d \u043c\u043e\u0433\u0443\u0442 \u043f\u043e\u043d\u0430\u0434\u043e\u0431\u0438\u0442\u044c\u0441\u044f \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u043f\u0440\u0430\u0432\u043a\u0438 CSS, \u0447\u0442\u043e\u0431\u044b \u0432\u043f\u0438\u0441\u0430\u0442\u044c\u0441\u044f \u0432 \u0441\u0435\u0442\u043a\u0443."],"Tiered pricing is not shown on shop and category pages.":["\u041c\u043d\u043e\u0433\u043e\u0443\u0440\u043e\u0432\u043d\u0435\u0432\u044b\u0435 \u0446\u0435\u043d\u044b \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430\u0445 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u0438 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0439."],"The layout is not inserted automatically. Place it with the [tiered-pricing-table] shortcode, the Tiered Pricing block or the widget; prices still update live.":["\u041c\u0430\u043a\u0435\u0442 \u043d\u0435 \u0432\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438. \u0420\u0430\u0437\u043c\u0435\u0441\u0442\u0438\u0442\u0435 \u0435\u0433\u043e \u0448\u043e\u0440\u0442\u043a\u043e\u0434\u043e\u043c [tiered-pricing-table], \u0431\u043b\u043e\u043a\u043e\u043c \u00ab\u041c\u043d\u043e\u0433\u043e\u0443\u0440\u043e\u0432\u043d\u0435\u0432\u043e\u0435 \u0446\u0435\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u00bb \u0438\u043b\u0438 \u0432\u0438\u0434\u0436\u0435\u0442\u043e\u043c; \u0446\u0435\u043d\u044b \u043f\u043e-\u043f\u0440\u0435\u0436\u043d\u0435\u043c\u0443 \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438."],"Position":["\u041f\u043e\u0437\u0438\u0446\u0438\u044f"],"Cart prices":["\u0426\u0435\u043d\u044b \u0432 \u043a\u043e\u0440\u0437\u0438\u043d\u0435"],"Discounted items":["\u0422\u043e\u0432\u0430\u0440\u044b \u0441\u043e \u0441\u043a\u0438\u0434\u043a\u043e\u0439"],"How items with a tiered price appear in the cart.":["\u041a\u0430\u043a \u0442\u043e\u0432\u0430\u0440\u044b \u0441 \u043c\u043d\u043e\u0433\u043e\u0443\u0440\u043e\u0432\u043d\u0435\u0432\u043e\u0439 \u0446\u0435\u043d\u043e\u0439 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u044e\u0442\u0441\u044f \u0432 \u043a\u043e\u0440\u0437\u0438\u043d\u0435."],"Show the original item price crossed out":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0438\u0441\u0445\u043e\u0434\u043d\u0443\u044e \u0446\u0435\u043d\u0443 \u0442\u043e\u0432\u0430\u0440\u0430 \u0437\u0430\u0447\u0435\u0440\u043a\u043d\u0443\u0442\u043e\u0439"],"Show the original subtotal crossed out":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0438\u0441\u0445\u043e\u0434\u043d\u044b\u0439 \u043f\u043e\u0434\u044b\u0442\u043e\u0433 \u0437\u0430\u0447\u0435\u0440\u043a\u043d\u0443\u0442\u044b\u043c"],"Cross out the regular price instead of the sale price":["\u0417\u0430\u0447\u0435\u0440\u043a\u0438\u0432\u0430\u0442\u044c \u043e\u0431\u044b\u0447\u043d\u0443\u044e \u0446\u0435\u043d\u0443 \u0432\u043c\u0435\u0441\u0442\u043e \u0446\u0435\u043d\u044b \u0440\u0430\u0441\u043f\u0440\u043e\u0434\u0430\u0436\u0438"],"For products on sale.":["\u0414\u043b\u044f \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u043d\u0430 \u0440\u0430\u0441\u043f\u0440\u043e\u0434\u0430\u0436\u0435."],"A row before the order total, in the cart totals and in the classic checkout's order review. Not available with the Checkout block.":["\u0421\u0442\u0440\u043e\u043a\u0430 \u043f\u0435\u0440\u0435\u0434 \u0438\u0442\u043e\u0433\u043e\u043c \u0437\u0430\u043a\u0430\u0437\u0430 \u2014 \u0432 \u0438\u0442\u043e\u0433\u0430\u0445 \u043a\u043e\u0440\u0437\u0438\u043d\u044b \u0438 \u0432 \u043e\u0431\u0437\u043e\u0440\u0435 \u0437\u0430\u043a\u0430\u0437\u0430 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u044f. \u041d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e \u0441 \u0431\u043b\u043e\u043a\u043e\u043c \u00ab\u041e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0435 \u0437\u0430\u043a\u0430\u0437\u0430\u00bb."],"Show what the tiered prices take off the cart":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c, \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u043d\u043e\u0433\u043e\u0443\u0440\u043e\u0432\u043d\u0435\u0432\u044b\u0435 \u0446\u0435\u043d\u044b \u0441\u043d\u0438\u043c\u0430\u044e\u0442 \u0441 \u043a\u043e\u0440\u0437\u0438\u043d\u044b"],"Row label":["\u041f\u043e\u0434\u043f\u0438\u0441\u044c \u0441\u0442\u0440\u043e\u043a\u0438"],"Upsell message":["\u0421\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043e \u0434\u043e\u043f\u0440\u043e\u0434\u0430\u0436\u0435"],"Next tier message":["\u0421\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c \u0443\u0440\u043e\u0432\u043d\u0435"],"Shown under the item name while a higher tier is within reach. Not available with the Cart block.":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0434 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\u043c \u0442\u043e\u0432\u0430\u0440\u0430, \u043f\u043e\u043a\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d \u0431\u043e\u043b\u0435\u0435 \u0432\u044b\u0441\u043e\u043a\u0438\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c. \u041d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e \u0441 \u0431\u043b\u043e\u043a\u043e\u043c \u00ab\u041a\u043e\u0440\u0437\u0438\u043d\u0430\u00bb."],"Show a message about the next tier":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c \u0443\u0440\u043e\u0432\u043d\u0435"],"Next tier shortcuts":["\u0411\u044b\u0441\u0442\u0440\u044b\u0439 \u043f\u0435\u0440\u0435\u0445\u043e\u0434 \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c"],"Make the quantity a link that sets the cart to the next tier":["\u0421\u0434\u0435\u043b\u0430\u0442\u044c \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0441\u0441\u044b\u043b\u043a\u043e\u0439, \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u044f\u0449\u0435\u0439 \u043a\u043e\u0440\u0437\u0438\u043d\u0443 \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c"],"One click moves the line to the next tier and updates the cart.":["\u041e\u0434\u0438\u043d \u043a\u043b\u0438\u043a \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0438\u0442 \u0441\u0442\u0440\u043e\u043a\u0443 \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0438 \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u0435\u0442 \u043a\u043e\u0440\u0437\u0438\u043d\u0443."],"Show a progress bar to the next tier":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0430 \u0434\u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f"],"Message colour":["\u0426\u0432\u0435\u0442 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f"],"Layout":["\u041c\u0430\u043a\u0435\u0442"],"Show on shop and category pages":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430\u0445 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u0438 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0439"],"Show on the product page":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435 \u0442\u043e\u0432\u0430\u0440\u0430"],"The badge shows in every product list: the shop, categories, search, related products, shortcodes and blocks.":["\u0417\u043d\u0430\u0447\u043e\u043a \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432\u043e \u0432\u0441\u0435\u0445 \u0441\u043f\u0438\u0441\u043a\u0430\u0445 \u0442\u043e\u0432\u0430\u0440\u043e\u0432: \u043c\u0430\u0433\u0430\u0437\u0438\u043d, \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438, \u043f\u043e\u0438\u0441\u043a, \u043f\u043e\u0445\u043e\u0436\u0438\u0435 \u0442\u043e\u0432\u0430\u0440\u044b, \u0448\u043e\u0440\u0442\u043a\u043e\u0434\u044b \u0438 \u0431\u043b\u043e\u043a\u0438."],"Every product list: the shop, categories, search, related products, shortcodes and blocks.":["\u0412\u0441\u0435 \u0441\u043f\u0438\u0441\u043a\u0438 \u0442\u043e\u0432\u0430\u0440\u043e\u0432: \u043c\u0430\u0433\u0430\u0437\u0438\u043d, \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438, \u043f\u043e\u0438\u0441\u043a, \u043f\u043e\u0445\u043e\u0436\u0438\u0435 \u0442\u043e\u0432\u0430\u0440\u044b, \u0448\u043e\u0440\u0442\u043a\u043e\u0434\u044b \u0438 \u0431\u043b\u043e\u043a\u0438."],"The product lists that show tiered pricing.":["\u0421\u043f\u0438\u0441\u043a\u0438 \u0442\u043e\u0432\u0430\u0440\u043e\u0432, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u043c\u043d\u043e\u0433\u043e\u0443\u0440\u043e\u0432\u043d\u0435\u0432\u044b\u0435 \u0446\u0435\u043d\u044b."],"Only for products in":["\u0422\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0432"],"Type to search categories. Leave empty for every product; a category covers its child categories.":["\u041d\u0430\u0447\u043d\u0438\u0442\u0435 \u0432\u0432\u043e\u0434\u0438\u0442\u044c \u0434\u043b\u044f \u043f\u043e\u0438\u0441\u043a\u0430 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0439. \u041e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u043f\u0443\u0441\u0442\u044b\u043c \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u0442\u043e\u0432\u0430\u0440\u043e\u0432; \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0441\u0432\u043e\u0438 \u0434\u043e\u0447\u0435\u0440\u043d\u0438\u0435 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438."],"Grid item":["\u042d\u043b\u0435\u043c\u0435\u043d\u0442 \u0441\u0435\u0442\u043a\u0438"],"Minimal styling so the pricing block fits the product grid.":["\u041c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0435, \u0447\u0442\u043e\u0431\u044b \u0431\u043b\u043e\u043a \u0446\u0435\u043d \u0432\u043f\u0438\u0441\u0430\u043b\u0441\u044f \u0432 \u0441\u0435\u0442\u043a\u0443 \u0442\u043e\u0432\u0430\u0440\u043e\u0432."],"Quantity selector in the grid":["\u041f\u043e\u043b\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0432 \u0441\u0435\u0442\u043a\u0435"],"Adds a quantity field to every grid item. Only for themes that do not have one.":["\u0414\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u043f\u043e\u043b\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043a \u043a\u0430\u0436\u0434\u043e\u043c\u0443 \u0442\u043e\u0432\u0430\u0440\u0443 \u0432 \u0441\u0435\u0442\u043a\u0435. \u0422\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0442\u0435\u043c, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0435\u0433\u043e \u043d\u0435\u0442."],"The rest sit behind a \"+N more\" link to the product page.":["\u041e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u043a\u0440\u044b\u0442\u044b \u0437\u0430 \u0441\u0441\u044b\u043b\u043a\u043e\u0439 \u00ab+ \u0435\u0449\u0435 N\u00bb \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u0442\u043e\u0432\u0430\u0440\u0430."],"Shop and category pages use the product page layout and its settings.":["\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u0438 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0439 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u043c\u0430\u043a\u0435\u0442 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u0442\u043e\u0432\u0430\u0440\u0430 \u0438 \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438."],"Design style":["\u0421\u0442\u0438\u043b\u044c \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u044f"],"A space-saving version of the selected design style.":["\u041a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u0430\u044f \u0432\u0435\u0440\u0441\u0438\u044f \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u043e\u0433\u043e \u0441\u0442\u0438\u043b\u044f \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u044f."],"Auto: each design style keeps its own spacing.":["\u0410\u0432\u0442\u043e: \u0443 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0441\u0442\u0438\u043b\u044f \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u044f \u0441\u0432\u043e\u0438 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u044b."],"Gap between the tiers. Reset for the design style's own spacing.":["\u0420\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043c\u0435\u0436\u0434\u0443 \u0443\u0440\u043e\u0432\u043d\u044f\u043c\u0438. \u0421\u0431\u0440\u043e\u0441\u044c\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u044b \u0441\u0442\u0438\u043b\u044f \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u044f."],"Auto: each design style keeps its own cell padding.":["\u0410\u0432\u0442\u043e: \u0443 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0441\u0442\u0438\u043b\u044f \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u044f \u0441\u0432\u043e\u0438 \u043e\u0442\u0441\u0442\u0443\u043f\u044b \u0432 \u044f\u0447\u0435\u0439\u043a\u0430\u0445."],"Padding inside each cell; it also overrides the theme's cell padding. Reset for the design style's own padding.":["\u041e\u0442\u0441\u0442\u0443\u043f\u044b \u0432\u043d\u0443\u0442\u0440\u0438 \u043a\u0430\u0436\u0434\u043e\u0439 \u044f\u0447\u0435\u0439\u043a\u0438; \u0442\u0430\u043a\u0436\u0435 \u043f\u0435\u0440\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u044e\u0442 \u043e\u0442\u0441\u0442\u0443\u043f\u044b \u044f\u0447\u0435\u0435\u043a \u0442\u0435\u043c\u044b. \u0421\u0431\u0440\u043e\u0441\u044c\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043e\u0442\u0441\u0442\u0443\u043f\u044b \u0441\u0442\u0438\u043b\u044f \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u044f."],"Active tier colour":["\u0426\u0432\u0435\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f"],"Taken from your theme (%s) when the plugin was installed.":["\u0412\u0437\u044f\u0442\u043e \u0438\u0437 \u0432\u0430\u0448\u0435\u0439 \u0442\u0435\u043c\u044b (%s) \u043f\u0440\u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0435 \u043f\u043b\u0430\u0433\u0438\u043d\u0430."],"Discount badge colour":["\u0426\u0432\u0435\u0442 \u0437\u043d\u0430\u0447\u043a\u0430 \u0441\u043a\u0438\u0434\u043a\u0438"],"Reset":["\u0421\u0431\u0440\u043e\u0441\u0438\u0442\u044c"],"Active tier border":["\u0420\u0430\u043c\u043a\u0430 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f"],"Mark the active tier with a left border":["\u041e\u0442\u043c\u0435\u0447\u0430\u0442\u044c \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u043b\u0435\u0432\u043e\u0439 \u0440\u0430\u043c\u043a\u043e\u0439"],"A bar in the active tier colour at the left of the row.":["\u041f\u043e\u043b\u043e\u0441\u0430 \u0446\u0432\u0435\u0442\u0430 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f \u0441\u043b\u0435\u0432\u0430 \u043e\u0442 \u0441\u0442\u0440\u043e\u043a\u0438."],"e.g. Buy more, pay less":["\u043d\u0430\u043f\u0440. \u041f\u043e\u043a\u0443\u043f\u0430\u0439\u0442\u0435 \u0431\u043e\u043b\u044c\u0448\u0435 \u2014 \u043f\u043b\u0430\u0442\u0438\u0442\u0435 \u043c\u0435\u043d\u044c\u0448\u0435"],"Quantity unit":["\u0415\u0434\u0438\u043d\u0438\u0446\u0430 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430"],"Shown next to quantities, e.g. pieces, boxes, packs. Leave empty for none.":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0440\u044f\u0434\u043e\u043c \u0441 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c, \u043d\u0430\u043f\u0440. \u0448\u0442., \u043a\u043e\u0440\u043e\u0431\u043e\u043a, \u0443\u043f\u0430\u043a\u043e\u0432\u043e\u043a. \u041e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u043f\u0443\u0441\u0442\u044b\u043c, \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c."],"Column headers":["\u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0438 \u0441\u0442\u043e\u043b\u0431\u0446\u043e\u0432"],"Leave a header empty to hide that column.":["\u041e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u043f\u0443\u0441\u0442\u044b\u043c, \u0447\u0442\u043e\u0431\u044b \u0441\u043a\u0440\u044b\u0442\u044c \u0441\u0442\u043e\u043b\u0431\u0435\u0446."],"Tooltip icon":["\u0417\u043d\u0430\u0447\u043e\u043a \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0438"],"Colour and size of the icon shown next to the price.":["\u0426\u0432\u0435\u0442 \u0438 \u0440\u0430\u0437\u043c\u0435\u0440 \u0437\u043d\u0430\u0447\u043a\u0430 \u0440\u044f\u0434\u043e\u043c \u0441 \u0446\u0435\u043d\u043e\u0439."],"Option text":["\u0422\u0435\u043a\u0441\u0442 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430"],"Text of each pricing option. Click a variable to insert it.":["\u0422\u0435\u043a\u0441\u0442 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430 \u0446\u0435\u043d\u044b. \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e, \u0447\u0442\u043e\u0431\u044b \u0432\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0435\u0435."],"Base price option":["\u0412\u0430\u0440\u0438\u0430\u043d\u0442 \u0441 \u0431\u0430\u0437\u043e\u0432\u043e\u0439 \u0446\u0435\u043d\u043e\u0439"],"Show an option for the regular price (no discount)":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0432\u0430\u0440\u0438\u0430\u043d\u0442 \u0441 \u043e\u0431\u044b\u0447\u043d\u043e\u0439 \u0446\u0435\u043d\u043e\u0439 (\u0431\u0435\u0437 \u0441\u043a\u0438\u0434\u043a\u0438)"],"Pricing string":["\u0421\u0442\u0440\u043e\u043a\u0430 \u0446\u0435\u043d\u044b"],"Text shown for each pricing tier. Click a variable to insert it.":["\u0422\u0435\u043a\u0441\u0442 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0446\u0435\u043d\u043e\u0432\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f. \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e, \u0447\u0442\u043e\u0431\u044b \u0432\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0435\u0435."],"First tier":["\u041f\u0435\u0440\u0432\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c"],"Show the regular price tier (no discount)":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0441 \u043e\u0431\u044b\u0447\u043d\u043e\u0439 \u0446\u0435\u043d\u043e\u0439 (\u0431\u0435\u0437 \u0441\u043a\u0438\u0434\u043a\u0438)"],"Show the original price crossed out":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0438\u0441\u0445\u043e\u0434\u043d\u0443\u044e \u0446\u0435\u043d\u0443 \u0437\u0430\u0447\u0435\u0440\u043a\u043d\u0443\u0442\u043e\u0439"],"Show the total for the selected option":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0438\u0442\u043e\u0433 \u0434\u043b\u044f \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u043e\u0433\u043e \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430"],"Clicking a tier selects its quantity.":["\u041d\u0430\u0436\u0430\u0442\u0438\u0435 \u043d\u0430 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0442 \u0435\u0433\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e."],"Price display":["\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0446\u0435\u043d\u044b"],"Price behaviour":["\u041f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0446\u0435\u043d\u044b"],"Update the price on quantity change":["\u041e\u0431\u043d\u043e\u0432\u043b\u044f\u0442\u044c \u0446\u0435\u043d\u0443 \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430"],"The main price follows the quantity the customer enters.":["\u041e\u0441\u043d\u043e\u0432\u043d\u0430\u044f \u0446\u0435\u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0437\u0430 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u0432\u043e\u0434\u0438\u0442 \u043a\u043b\u0438\u0435\u043d\u0442."],"Next to the discounted tier price.":["\u0420\u044f\u0434\u043e\u043c \u0441 \u0446\u0435\u043d\u043e\u0439 \u0443\u0440\u043e\u0432\u043d\u044f \u0441\u043e \u0441\u043a\u0438\u0434\u043a\u043e\u0439."],"Show the total price (price \u00d7 quantity)":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043e\u0431\u0449\u0443\u044e \u0446\u0435\u043d\u0443 (\u0446\u0435\u043d\u0430 \u00d7 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e)"],"Instead of the price per item.":["\u0412\u043c\u0435\u0441\u0442\u043e \u0446\u0435\u043d\u044b \u0437\u0430 \u0448\u0442\u0443\u043a\u0443."],"Also for products without tiered pricing":["\u0422\u0430\u043a\u0436\u0435 \u0434\u043b\u044f \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0431\u0435\u0437 \u043c\u043d\u043e\u0433\u043e\u0443\u0440\u043e\u0432\u043d\u0435\u0432\u044b\u0445 \u0446\u0435\u043d"],"Savings badge":["\u0417\u043d\u0430\u0447\u043e\u043a \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0438"],"Badge":["\u0417\u043d\u0430\u0447\u043e\u043a"],"Shown when the selected quantity has a discount. Also available as the [tiered_price_you_save] shortcode.":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f, \u043a\u043e\u0433\u0434\u0430 \u0443 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u043e\u0433\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0435\u0441\u0442\u044c \u0441\u043a\u0438\u0434\u043a\u0430. \u0422\u0430\u043a\u0436\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d \u043a\u0430\u043a \u0448\u043e\u0440\u0442\u043a\u043e\u0434 [tiered_price_you_save]."],"Show the savings badge":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0437\u043d\u0430\u0447\u043e\u043a \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0438"],"Style":["\u0421\u0442\u0438\u043b\u044c"],"Text: the colour as text colour. Pill: a filled label with white text. Outlined: a bordered label.":["\u0422\u0435\u043a\u0441\u0442: \u0446\u0432\u0435\u0442 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043a \u0442\u0435\u043a\u0441\u0442\u0443. \u041a\u0430\u043f\u0441\u0443\u043b\u0430: \u0437\u0430\u043b\u0438\u0432\u043a\u0430 \u0441 \u0431\u0435\u043b\u044b\u043c \u0442\u0435\u043a\u0441\u0442\u043e\u043c. \u041a\u043e\u043d\u0442\u0443\u0440: \u044f\u0440\u043b\u044b\u043a \u0441 \u0440\u0430\u043c\u043a\u043e\u0439."],"Reset for the active tier colour.":["\u0421\u0431\u0440\u043e\u0441\u044c\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0446\u0432\u0435\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f."],"Badge options":["\u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u0437\u043d\u0430\u0447\u043a\u0430"],"Include the WooCommerce sale discount":["\u0423\u0447\u0438\u0442\u044b\u0432\u0430\u0442\u044c \u0441\u043a\u0438\u0434\u043a\u0443 \u0440\u0430\u0441\u043f\u0440\u043e\u0434\u0430\u0436\u0438 WooCommerce"],"An existing sale discount counts towards the savings.":["\u0414\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0449\u0430\u044f \u0441\u043a\u0438\u0434\u043a\u0430 \u0440\u0430\u0441\u043f\u0440\u043e\u0434\u0430\u0436\u0438 \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0438."],"Show for products without tiered pricing":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0434\u043b\u044f \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0431\u0435\u0437 \u043c\u043d\u043e\u0433\u043e\u0443\u0440\u043e\u0432\u043d\u0435\u0432\u044b\u0445 \u0446\u0435\u043d"],"For regular sale products.":["\u0414\u043b\u044f \u043e\u0431\u044b\u0447\u043d\u044b\u0445 \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u043d\u0430 \u0440\u0430\u0441\u043f\u0440\u043e\u0434\u0430\u0436\u0435."],"Pricing summary":["\u0421\u0432\u043e\u0434\u043a\u0430 \u0446\u0435\u043d"],"Summary block":["\u0421\u0432\u043e\u0434\u043d\u044b\u0439 \u0431\u043b\u043e\u043a"],"Quantity, price per item and total for the selected quantity, near the pricing layout.":["\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e, \u0446\u0435\u043d\u0430 \u0437\u0430 \u0448\u0442\u0443\u043a\u0443 \u0438 \u0438\u0442\u043e\u0433 \u0434\u043b\u044f \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u043e\u0433\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430, \u0440\u044f\u0434\u043e\u043c \u0441 \u043c\u0430\u043a\u0435\u0442\u043e\u043c \u0446\u0435\u043d."],"Show the pricing summary block":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0431\u043b\u043e\u043a \u0441\u0432\u043e\u0434\u043a\u0438 \u0446\u0435\u043d"],"e.g. Your order":["\u043d\u0430\u043f\u0440. \u0412\u0430\u0448 \u0437\u0430\u043a\u0430\u0437"],"Each":["\u0417\u0430 \u0448\u0442."],"A badge on the product image with the biggest discount the product's tiers give. Shows whether or not the pricing does, in the lists \"Where it shows\" allows.":["\u0417\u043d\u0430\u0447\u043e\u043a \u043d\u0430 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0438 \u0442\u043e\u0432\u0430\u0440\u0430 \u0441 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u043a\u0438\u0434\u043a\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0434\u0430\u044e\u0442 \u0435\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u0438. \u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u0441\u043f\u0438\u0441\u043a\u0430\u0445, \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u043d\u044b\u0445 \u0432 \u00ab\u0413\u0434\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c\u00bb, \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u0442\u043e\u0433\u043e, \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u043b\u0438 \u0442\u0430\u043c \u0441\u0430\u043c\u0438 \u0446\u0435\u043d\u044b."],"Show a bulk savings badge":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0437\u043d\u0430\u0447\u043e\u043a \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0438 \u0437\u0430 \u043e\u0431\u044a\u0435\u043c"],"Auto: the active tier colour.":["\u0410\u0432\u0442\u043e: \u0446\u0432\u0435\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f."],"The price shown in the product grid for products with tiered pricing.":["\u0426\u0435\u043d\u0430 \u0432 \u0441\u0435\u0442\u043a\u0435 \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0434\u043b\u044f \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0441 \u043c\u043d\u043e\u0433\u043e\u0443\u0440\u043e\u0432\u043d\u0435\u0432\u044b\u043c\u0438 \u0446\u0435\u043d\u0430\u043c\u0438."],"Replace the regular price":["\u0417\u0430\u043c\u0435\u043d\u044f\u0442\u044c \u043e\u0431\u044b\u0447\u043d\u0443\u044e \u0446\u0435\u043d\u0443"],"Show the lowest tier price or a price range instead.":["\u0412\u043c\u0435\u0441\u0442\u043e \u044d\u0442\u043e\u0433\u043e \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u0443\u044e \u0446\u0435\u043d\u0443 \u0443\u0440\u043e\u0432\u043d\u044f \u0438\u043b\u0438 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d \u0446\u0435\u043d."],"Lowest and highest prices across all variations.":["\u041c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0438 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0446\u0435\u043d\u044b \u0441\u0440\u0435\u0434\u0438 \u0432\u0441\u0435\u0445 \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u0439."],"Prefix for the lowest price":["\u041f\u0440\u0435\u0444\u0438\u043a\u0441 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0446\u0435\u043d\u044b"],"Click a variable to insert it.":["\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e, \u0447\u0442\u043e\u0431\u044b \u0432\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0435\u0435."]}}}