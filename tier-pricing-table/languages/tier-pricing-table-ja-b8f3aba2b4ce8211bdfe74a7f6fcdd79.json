{"translation-revision-date":"2026-10-12 11:58+0000","generator":"WP-CLI\/2.12.0","source":"src\/Addons\/LayoutConfigurator\/build\/index.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ja","plural-forms":"nplurals=1; plural=0;"},"Apply to variable products":["\u53ef\u5909\u5546\u54c1\u3078\u306e\u9069\u7528"],"Custom template":["\u30ab\u30b9\u30bf\u30e0\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8"],"Custom table columns":["\u30ab\u30b9\u30bf\u30e0\u30c6\u30fc\u30d6\u30eb\u5217"],"Price":["\u4fa1\u683c"],"Quantity":["\u91cf"],"Discount":["\u5272\u5f15"],"Total savings":["\u5408\u8a08\u7bc0\u7d04\u984d"],"Product name":["\u5546\u54c1\u540d"],"Pricing Display":["\u4fa1\u683c\u8868\u793a"],"The preview could not be rendered.":["\u30d7\u30ec\u30d3\u30e5\u30fc\u3092\u8868\u793a\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002"],"Summary layout":["\u6982\u8981\u30ec\u30a4\u30a2\u30a6\u30c8"],"Where it shows":["\u8868\u793a\u3059\u308b\u5834\u6240"],"Product lists":["\u5546\u54c1\u4e00\u89a7"],"All categories":["\u3059\u3079\u3066\u306e\u30ab\u30c6\u30b4\u30ea\u30fc"],"Tiers per grid item":["\u30b0\u30ea\u30c3\u30c9\u30a2\u30a4\u30c6\u30e0\u3042\u305f\u308a\u306e\u968e\u5c64\u6570"],"All":["\u3059\u3079\u3066"],"Bulk savings badge":["\u307e\u3068\u3081\u8cb7\u3044\u5272\u5f15\u30d0\u30c3\u30b8"],"Dynamic price":["\u52d5\u7684\u4fa1\u683c"],"Update the displayed price to the tier price when the customer changes the quantity in the grid. Needs a quantity field on the grid item, from this plugin, the theme or another plugin.":["\u9867\u5ba2\u304c\u30b0\u30ea\u30c3\u30c9\u5185\u3067\u6570\u91cf\u3092\u5909\u66f4\u3057\u305f\u3068\u304d\u306b\u3001\u8868\u793a\u4fa1\u683c\u3092\u968e\u5c64\u4fa1\u683c\u306b\u66f4\u65b0\u3057\u307e\u3059\u3002\u30b0\u30ea\u30c3\u30c9\u30a2\u30a4\u30c6\u30e0\u306b\u6570\u91cf\u30d5\u30a3\u30fc\u30eb\u30c9 (\u3053\u306e\u30d7\u30e9\u30b0\u30a4\u30f3\u3001\u30c6\u30fc\u30de\u3001\u307e\u305f\u306f\u4ed6\u306e\u30d7\u30e9\u30b0\u30a4\u30f3\u306b\u3088\u308b\u3082\u306e) \u304c\u5fc5\u8981\u3067\u3059\u3002"],"Compact layout":["\u30b3\u30f3\u30d1\u30af\u30c8\u306a\u30ec\u30a4\u30a2\u30a6\u30c8"],"Layout source":["\u30ec\u30a4\u30a2\u30a6\u30c8\u30bd\u30fc\u30b9"],"Same as product page":["\u5546\u54c1\u30da\u30fc\u30b8\u3068\u540c\u3058"],"Custom":["\u30ab\u30b9\u30bf\u30e0"],"Spacing":["\u9593\u9694"],"Auto":["\u81ea\u52d5"],"Cell padding":["\u30bb\u30eb\u5185\u4f59\u767d"],"Tier order":["\u968e\u5c64\u306e\u9806\u5e8f"],"Show discount":["\u5272\u5f15\u3092\u8868\u793a"],"Discount format":["\u5272\u5f15\u306e\u8868\u793a\u5f62\u5f0f"],"Product":["\u88fd\u54c1"],"Total":["\u5408\u8a08"],"Badge colour":["\u30d0\u30c3\u30b8\u306e\u8272"],"Options":["\u30aa\u30d7\u30b7\u30e7\u30f3"],"Title":["\u30bf\u30a4\u30c8\u30eb"],"Singular":["\u7279\u7570"],"Plural":["\u8907\u6570"],"Enable compact layout":["\u30b3\u30f3\u30d1\u30af\u30c8\u306a\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u6709\u52b9\u306b\u3059\u308b"],"Quantity format":["\u6570\u91cf\u5f62\u5f0f"],"Tooltip border":["\u30c4\u30fc\u30eb\u30c1\u30c3\u30d7\u306e\u5883\u754c\u7dda"],"Make pricing tiers clickable":["\u4fa1\u683c\u968e\u5c64\u3092\u30af\u30ea\u30c3\u30af\u3067\u304d\u308b\u3088\u3046\u306b\u3059\u308b"],"Add to cart":["\u30ab\u30fc\u30c8\u306b\u8ffd\u52a0"],"Labels":["\u30e9\u30d9\u30eb"],"Cart":["\u30ab\u30fc\u30c8"],"Format":["\u5f62\u5f0f"],"Bold":["\u592a\u5b57"],"Italic":["\u659c\u4f53"],"Strikethrough":["\u53d6\u308a\u6d88\u3057\u7dda"],"Formatting":["\u66f8\u5f0f"],"Insert":["\u633f\u5165"],"Auto: the design style's own badge colours.":["\u81ea\u52d5: \u30c7\u30b6\u30a4\u30f3\u30b9\u30bf\u30a4\u30eb\u672c\u6765\u306e\u30d0\u30c3\u30b8\u306e\u8272\u3002"],"A light tint of this colour behind the badge text in this colour. Reset for the design style's own colours.":["\u3053\u306e\u8272\u306e\u8584\u3044\u80cc\u666f\u306b\u3001\u3053\u306e\u8272\u3067\u30d0\u30c3\u30b8\u306e\u6587\u5b57\u3092\u8868\u793a\u3057\u307e\u3059\u3002\u30c7\u30b6\u30a4\u30f3\u30b9\u30bf\u30a4\u30eb\u672c\u6765\u306e\u8272\u306b\u623b\u3059\u306b\u306f\u30ea\u30bb\u30c3\u30c8\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Auto: the badge follows the active tier colour.":["\u81ea\u52d5: \u30d0\u30c3\u30b8\u306f\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u968e\u5c64\u306e\u8272\u306b\u5f93\u3044\u307e\u3059\u3002"],"The badge background; its text stays white. Reset for the active tier colour.":["\u30d0\u30c3\u30b8\u306e\u80cc\u666f\u8272\u3067\u3059\u3002\u6587\u5b57\u306f\u767d\u306e\u307e\u307e\u3067\u3059\u3002\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u968e\u5c64\u306e\u8272\u306b\u623b\u3059\u306b\u306f\u30ea\u30bb\u30c3\u30c8\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Auto: the savings bar follows the active tier colour.":["\u81ea\u52d5: \u7bc0\u7d04\u30d0\u30fc\u306f\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u968e\u5c64\u306e\u8272\u306b\u5f93\u3044\u307e\u3059\u3002"],"The savings bar and the percentage next to it. Reset for the active tier colour.":["\u7bc0\u7d04\u30d0\u30fc\u3068\u305d\u306e\u6a2a\u306e\u30d1\u30fc\u30bb\u30f3\u30c6\u30fc\u30b8\u3067\u3059\u3002\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u968e\u5c64\u306e\u8272\u306b\u623b\u3059\u306b\u306f\u30ea\u30bb\u30c3\u30c8\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Available in the premium version.":["\u30d7\u30ec\u30df\u30a2\u30e0\u7248\u3067\u5229\u7528\u3067\u304d\u307e\u3059\u3002"],"You can try it in the preview; the store shows it with premium only.":["\u30d7\u30ec\u30d3\u30e5\u30fc\u3067\u8a66\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c8\u30a2\u3067\u306f\u30d7\u30ec\u30df\u30a2\u30e0\u7248\u3067\u306e\u307f\u8868\u793a\u3055\u308c\u307e\u3059\u3002"],"Depending on the theme, the pricing block may need small CSS adjustments to fit the grid.":["\u30c6\u30fc\u30de\u306b\u3088\u3063\u3066\u306f\u3001\u4fa1\u683c\u8a2d\u5b9a\u30d6\u30ed\u30c3\u30af\u3092\u30b0\u30ea\u30c3\u30c9\u306b\u5408\u308f\u305b\u308b\u305f\u3081\u306b CSS \u306e\u5fae\u8abf\u6574\u304c\u5fc5\u8981\u306a\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002"],"Tiered pricing is not shown on shop and category pages.":["\u6bb5\u968e\u7684\u4fa1\u683c\u8a2d\u5b9a\u306f\u30b7\u30e7\u30c3\u30d7\u3068\u30ab\u30c6\u30b4\u30ea\u30fc\u30da\u30fc\u30b8\u306b\u306f\u8868\u793a\u3055\u308c\u307e\u305b\u3093\u3002"],"The layout is not inserted automatically. Place it with the [tiered-pricing-table] shortcode, the Tiered Pricing block or the widget; prices still update live.":["\u30ec\u30a4\u30a2\u30a6\u30c8\u306f\u81ea\u52d5\u3067\u306f\u633f\u5165\u3055\u308c\u307e\u305b\u3093\u3002[tiered-pricing-table] \u30b7\u30e7\u30fc\u30c8\u30b3\u30fc\u30c9\u3001Tiered Pricing \u30d6\u30ed\u30c3\u30af\u3001\u307e\u305f\u306f\u30a6\u30a3\u30b8\u30a7\u30c3\u30c8\u3067\u914d\u7f6e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4fa1\u683c\u306f\u30e9\u30a4\u30d6\u3067\u66f4\u65b0\u3055\u308c\u307e\u3059\u3002"],"Position":["\u4f4d\u7f6e"],"Cart prices":["\u30ab\u30fc\u30c8\u306e\u4fa1\u683c"],"Discounted items":["\u5272\u5f15\u5bfe\u8c61\u306e\u5546\u54c1"],"How items with a tiered price appear in the cart.":["\u6bb5\u968e\u7684\u4fa1\u683c\u304c\u9069\u7528\u3055\u308c\u305f\u5546\u54c1\u306e\u30ab\u30fc\u30c8\u3067\u306e\u8868\u793a\u65b9\u6cd5\u3067\u3059\u3002"],"Show the original item price crossed out":["\u5143\u306e\u5546\u54c1\u4fa1\u683c\u3092\u53d6\u308a\u6d88\u3057\u7dda\u4ed8\u304d\u3067\u8868\u793a"],"Show the original subtotal crossed out":["\u5143\u306e\u5c0f\u8a08\u3092\u53d6\u308a\u6d88\u3057\u7dda\u4ed8\u304d\u3067\u8868\u793a"],"Cross out the regular price instead of the sale price":["\u30bb\u30fc\u30eb\u4fa1\u683c\u3067\u306f\u306a\u304f\u901a\u5e38\u4fa1\u683c\u306b\u53d6\u308a\u6d88\u3057\u7dda\u3092\u4ed8\u3051\u308b"],"For products on sale.":["\u30bb\u30fc\u30eb\u4e2d\u306e\u5546\u54c1\u5411\u3051\u3002"],"A row before the order total, in the cart totals and in the classic checkout's order review. Not available with the Checkout block.":["\u30ab\u30fc\u30c8\u5408\u8a08\u3068\u5f93\u6765\u306e\u304a\u652f\u6255\u3044\u30da\u30fc\u30b8\u306e\u6ce8\u6587\u78ba\u8a8d\u306b\u3001\u6ce8\u6587\u5408\u8a08\u306e\u524d\u306b\u8868\u793a\u3055\u308c\u308b\u884c\u3067\u3059\u3002\u304a\u652f\u6255\u3044\u30d6\u30ed\u30c3\u30af\u3067\u306f\u5229\u7528\u3067\u304d\u307e\u305b\u3093\u3002"],"Show what the tiered prices take off the cart":["\u6bb5\u968e\u7684\u4fa1\u683c\u306b\u3088\u308b\u30ab\u30fc\u30c8\u306e\u5024\u5f15\u304d\u984d\u3092\u8868\u793a"],"Row label":["\u884c\u30e9\u30d9\u30eb"],"Upsell message":["\u30a2\u30c3\u30d7\u30bb\u30eb\u30e1\u30c3\u30bb\u30fc\u30b8"],"Next tier message":["\u6b21\u306e\u968e\u5c64\u306e\u30e1\u30c3\u30bb\u30fc\u30b8"],"Shown under the item name while a higher tier is within reach. Not available with the Cart block.":["\u4e0a\u4f4d\u306e\u968e\u5c64\u306b\u5c4a\u304d\u305d\u3046\u306a\u3068\u304d\u306b\u5546\u54c1\u540d\u306e\u4e0b\u306b\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u30ab\u30fc\u30c8\u30d6\u30ed\u30c3\u30af\u3067\u306f\u5229\u7528\u3067\u304d\u307e\u305b\u3093\u3002"],"Show a message about the next tier":["\u6b21\u306e\u968e\u5c64\u306b\u3064\u3044\u3066\u306e\u30e1\u30c3\u30bb\u30fc\u30b8\u3092\u8868\u793a"],"Next tier shortcuts":["\u6b21\u306e\u968e\u5c64\u3078\u306e\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8"],"Make the quantity a link that sets the cart to the next tier":["\u6570\u91cf\u3092\u3001\u30ab\u30fc\u30c8\u3092\u6b21\u306e\u968e\u5c64\u306b\u8a2d\u5b9a\u3059\u308b\u30ea\u30f3\u30af\u306b\u3059\u308b"],"One click moves the line to the next tier and updates the cart.":["\u30ef\u30f3\u30af\u30ea\u30c3\u30af\u3067\u660e\u7d30\u3092\u6b21\u306e\u968e\u5c64\u306b\u79fb\u52d5\u3057\u3001\u30ab\u30fc\u30c8\u3092\u66f4\u65b0\u3057\u307e\u3059\u3002"],"Show a progress bar to the next tier":["\u6b21\u306e\u968e\u5c64\u307e\u3067\u306e\u9032\u6357\u30d0\u30fc\u3092\u8868\u793a"],"Message colour":["\u30e1\u30c3\u30bb\u30fc\u30b8\u306e\u8272"],"Layout":["\u30ec\u30a4\u30a2\u30a6\u30c8"],"Visibility":["\u8868\u793a\u8a2d\u5b9a"],"Show on shop and category pages":["\u30b7\u30e7\u30c3\u30d7\u3068\u30ab\u30c6\u30b4\u30ea\u30fc\u30da\u30fc\u30b8\u306b\u8868\u793a"],"Show on the product page":["\u5546\u54c1\u30da\u30fc\u30b8\u306b\u8868\u793a"],"The badge shows in every product list: the shop, categories, search, related products, shortcodes and blocks.":["\u30d0\u30c3\u30b8\u306f\u3059\u3079\u3066\u306e\u5546\u54c1\u4e00\u89a7\u306b\u8868\u793a\u3055\u308c\u307e\u3059: \u30b7\u30e7\u30c3\u30d7\u3001\u30ab\u30c6\u30b4\u30ea\u30fc\u3001\u691c\u7d22\u3001\u95a2\u9023\u5546\u54c1\u3001\u30b7\u30e7\u30fc\u30c8\u30b3\u30fc\u30c9\u3001\u30d6\u30ed\u30c3\u30af\u3002"],"Every product list: the shop, categories, search, related products, shortcodes and blocks.":["\u3059\u3079\u3066\u306e\u5546\u54c1\u4e00\u89a7: \u30b7\u30e7\u30c3\u30d7\u3001\u30ab\u30c6\u30b4\u30ea\u30fc\u3001\u691c\u7d22\u3001\u95a2\u9023\u5546\u54c1\u3001\u30b7\u30e7\u30fc\u30c8\u30b3\u30fc\u30c9\u3001\u30d6\u30ed\u30c3\u30af\u3002"],"The product lists that show tiered pricing.":["\u6bb5\u968e\u7684\u4fa1\u683c\u8a2d\u5b9a\u3092\u8868\u793a\u3059\u308b\u5546\u54c1\u4e00\u89a7\u3067\u3059\u3002"],"Only for products in":["\u5bfe\u8c61\u30ab\u30c6\u30b4\u30ea\u30fc\u306e\u5546\u54c1\u306e\u307f"],"Type to search categories. Leave empty for every product; a category covers its child categories.":["\u5165\u529b\u3057\u3066\u30ab\u30c6\u30b4\u30ea\u30fc\u3092\u691c\u7d22\u3057\u307e\u3059\u3002\u7a7a\u6b04\u306b\u3059\u308b\u3068\u3059\u3079\u3066\u306e\u5546\u54c1\u304c\u5bfe\u8c61\u3067\u3059\u3002\u30ab\u30c6\u30b4\u30ea\u30fc\u306b\u306f\u5b50\u30ab\u30c6\u30b4\u30ea\u30fc\u3082\u542b\u307e\u308c\u307e\u3059\u3002"],"Grid item":["\u30b0\u30ea\u30c3\u30c9\u30a2\u30a4\u30c6\u30e0"],"Minimal styling so the pricing block fits the product grid.":["\u4fa1\u683c\u8a2d\u5b9a\u30d6\u30ed\u30c3\u30af\u304c\u5546\u54c1\u30b0\u30ea\u30c3\u30c9\u306b\u53ce\u307e\u308b\u3088\u3046\u6700\u5c0f\u9650\u306e\u30b9\u30bf\u30a4\u30eb\u3092\u9069\u7528\u3057\u307e\u3059\u3002"],"Quantity selector in the grid":["\u30b0\u30ea\u30c3\u30c9\u5185\u306e\u6570\u91cf\u30bb\u30ec\u30af\u30bf\u30fc"],"Adds a quantity field to every grid item. Only for themes that do not have one.":["\u5404\u30b0\u30ea\u30c3\u30c9\u30a2\u30a4\u30c6\u30e0\u306b\u6570\u91cf\u30d5\u30a3\u30fc\u30eb\u30c9\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002\u6570\u91cf\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u306a\u3044\u30c6\u30fc\u30de\u306e\u307f\u5bfe\u8c61\u3067\u3059\u3002"],"The rest sit behind a \"+N more\" link to the product page.":["\u6b8b\u308a\u306f\u5546\u54c1\u30da\u30fc\u30b8\u3078\u306e\u300c+N \u4ef6\u300d\u30ea\u30f3\u30af\u306b\u307e\u3068\u3081\u3089\u308c\u307e\u3059\u3002"],"Shop and category pages use the product page layout and its settings.":["\u30b7\u30e7\u30c3\u30d7\u30da\u30fc\u30b8\u3068\u30ab\u30c6\u30b4\u30ea\u30fc\u30da\u30fc\u30b8\u306f\u5546\u54c1\u30da\u30fc\u30b8\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3068\u305d\u306e\u8a2d\u5b9a\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002"],"Design style":["\u30c7\u30b6\u30a4\u30f3\u30b9\u30bf\u30a4\u30eb"],"A space-saving version of the selected design style.":["\u9078\u629e\u3057\u305f\u30c7\u30b6\u30a4\u30f3\u30b9\u30bf\u30a4\u30eb\u306e\u7701\u30b9\u30da\u30fc\u30b9\u7248\u3067\u3059\u3002"],"Auto: each design style keeps its own spacing.":["\u81ea\u52d5: \u5404\u30c7\u30b6\u30a4\u30f3\u30b9\u30bf\u30a4\u30eb\u672c\u6765\u306e\u9593\u9694\u3092\u7dad\u6301\u3057\u307e\u3059\u3002"],"Gap between the tiers. Reset for the design style's own spacing.":["\u968e\u5c64\u9593\u306e\u9593\u9694\u3067\u3059\u3002\u30c7\u30b6\u30a4\u30f3\u30b9\u30bf\u30a4\u30eb\u672c\u6765\u306e\u9593\u9694\u306b\u623b\u3059\u306b\u306f\u30ea\u30bb\u30c3\u30c8\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Auto: each design style keeps its own cell padding.":["\u81ea\u52d5: \u5404\u30c7\u30b6\u30a4\u30f3\u30b9\u30bf\u30a4\u30eb\u672c\u6765\u306e\u30bb\u30eb\u5185\u4f59\u767d\u3092\u7dad\u6301\u3057\u307e\u3059\u3002"],"Padding inside each cell; it also overrides the theme's cell padding. Reset for the design style's own padding.":["\u5404\u30bb\u30eb\u5185\u306e\u4f59\u767d\u3067\u3059\u3002\u30c6\u30fc\u30de\u306e\u30bb\u30eb\u5185\u4f59\u767d\u3082\u4e0a\u66f8\u304d\u3057\u307e\u3059\u3002\u30c7\u30b6\u30a4\u30f3\u30b9\u30bf\u30a4\u30eb\u672c\u6765\u306e\u4f59\u767d\u306b\u623b\u3059\u306b\u306f\u30ea\u30bb\u30c3\u30c8\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Active tier colour":["\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u968e\u5c64\u306e\u8272"],"Discount badge colour":["\u5272\u5f15\u30d0\u30c3\u30b8\u306e\u8272"],"Reset":["\u30ea\u30bb\u30c3\u30c8"],"Active tier border":["\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u968e\u5c64\u306e\u67a0\u7dda"],"Mark the active tier with a left border":["\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u968e\u5c64\u3092\u5de6\u67a0\u7dda\u3067\u5f37\u8abf\u3059\u308b"],"A bar in the active tier colour at the left of the row.":["\u884c\u306e\u5de6\u5074\u306b\u8868\u793a\u3055\u308c\u308b\u3001\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u968e\u5c64\u306e\u8272\u306e\u30d0\u30fc\u3067\u3059\u3002"],"e.g. Buy more, pay less":["\u4f8b: \u307e\u3068\u3081\u8cb7\u3044\u3067\u304a\u5f97"],"Quantity unit":["\u6570\u91cf\u306e\u5358\u4f4d"],"Shown next to quantities, e.g. pieces, boxes, packs. Leave empty for none.":["\u6570\u91cf\u306e\u6a2a\u306b\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u4f8b: \u500b\u3001\u7bb1\u3001\u30d1\u30c3\u30af\u3002\u4e0d\u8981\u306a\u5834\u5408\u306f\u7a7a\u6b04\u306b\u3057\u307e\u3059\u3002"],"Column headers":["\u5217\u898b\u51fa\u3057"],"Leave a header empty to hide that column.":["\u898b\u51fa\u3057\u3092\u7a7a\u6b04\u306b\u3059\u308b\u3068\u3001\u305d\u306e\u5217\u306f\u975e\u8868\u793a\u306b\u306a\u308a\u307e\u3059\u3002"],"Tooltip icon":["\u30c4\u30fc\u30eb\u30c1\u30c3\u30d7\u30a2\u30a4\u30b3\u30f3"],"Colour and size of the icon shown next to the price.":["\u4fa1\u683c\u306e\u6a2a\u306b\u8868\u793a\u3055\u308c\u308b\u30a2\u30a4\u30b3\u30f3\u306e\u8272\u3068\u30b5\u30a4\u30ba\u3067\u3059\u3002"],"Option text":["\u30aa\u30d7\u30b7\u30e7\u30f3\u306e\u30c6\u30ad\u30b9\u30c8"],"Text of each pricing option. Click a variable to insert it.":["\u5404\u4fa1\u683c\u30aa\u30d7\u30b7\u30e7\u30f3\u306e\u30c6\u30ad\u30b9\u30c8\u3067\u3059\u3002\u5909\u6570\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u3068\u633f\u5165\u3055\u308c\u307e\u3059\u3002"],"Base price option":["\u57fa\u672c\u4fa1\u683c\u306e\u30aa\u30d7\u30b7\u30e7\u30f3"],"Show an option for the regular price (no discount)":["\u901a\u5e38\u4fa1\u683c (\u5272\u5f15\u306a\u3057) \u306e\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u8868\u793a"],"Pricing string":["\u4fa1\u683c\u8868\u793a\u6587\u5b57\u5217"],"Text shown for each pricing tier. Click a variable to insert it.":["\u5404\u4fa1\u683c\u968e\u5c64\u306b\u8868\u793a\u3055\u308c\u308b\u30c6\u30ad\u30b9\u30c8\u3067\u3059\u3002\u5909\u6570\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u3068\u633f\u5165\u3055\u308c\u307e\u3059\u3002"],"First tier":["\u6700\u521d\u306e\u968e\u5c64"],"Show the regular price tier (no discount)":["\u901a\u5e38\u4fa1\u683c\u306e\u968e\u5c64 (\u5272\u5f15\u306a\u3057) \u3092\u8868\u793a"],"Show the original price crossed out":["\u5143\u306e\u4fa1\u683c\u3092\u53d6\u308a\u6d88\u3057\u7dda\u4ed8\u304d\u3067\u8868\u793a"],"Show the total for the selected option":["\u9078\u629e\u3057\u305f\u30aa\u30d7\u30b7\u30e7\u30f3\u306e\u5408\u8a08\u3092\u8868\u793a"],"Clicking a tier selects its quantity.":["\u968e\u5c64\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u3068\u305d\u306e\u6570\u91cf\u304c\u9078\u629e\u3055\u308c\u307e\u3059\u3002"],"Price display":["\u4fa1\u683c\u8868\u793a"],"Price behaviour":["\u4fa1\u683c\u306e\u52d5\u4f5c"],"Update the price on quantity change":["\u6570\u91cf\u5909\u66f4\u6642\u306b\u4fa1\u683c\u3092\u66f4\u65b0"],"The main price follows the quantity the customer enters.":["\u30e1\u30a4\u30f3\u306e\u4fa1\u683c\u306f\u9867\u5ba2\u304c\u5165\u529b\u3057\u305f\u6570\u91cf\u306b\u9023\u52d5\u3057\u307e\u3059\u3002"],"Next to the discounted tier price.":["\u5272\u5f15\u5f8c\u306e\u968e\u5c64\u4fa1\u683c\u306e\u6a2a\u306b\u8868\u793a\u3057\u307e\u3059\u3002"],"Show the total price (price \u00d7 quantity)":["\u5408\u8a08\u4fa1\u683c (\u4fa1\u683c \u00d7 \u6570\u91cf) \u3092\u8868\u793a"],"Instead of the price per item.":["1 \u500b\u3042\u305f\u308a\u306e\u4fa1\u683c\u306e\u4ee3\u308f\u308a\u306b\u8868\u793a\u3057\u307e\u3059\u3002"],"Also for products without tiered pricing":["\u6bb5\u968e\u7684\u4fa1\u683c\u8a2d\u5b9a\u306e\u306a\u3044\u5546\u54c1\u306b\u3082\u8868\u793a"],"Savings badge":["\u7bc0\u7d04\u30d0\u30c3\u30b8"],"Badge":["\u30d0\u30c3\u30b8"],"Shown when the selected quantity has a discount. Also available as the [tiered_price_you_save] shortcode.":["\u9078\u629e\u3057\u305f\u6570\u91cf\u306b\u5272\u5f15\u304c\u3042\u308b\u3068\u304d\u306b\u8868\u793a\u3055\u308c\u307e\u3059\u3002[tiered_price_you_save] \u30b7\u30e7\u30fc\u30c8\u30b3\u30fc\u30c9\u3067\u3082\u5229\u7528\u3067\u304d\u307e\u3059\u3002"],"Show the savings badge":["\u7bc0\u7d04\u30d0\u30c3\u30b8\u3092\u8868\u793a"],"Style":["\u30b9\u30bf\u30a4\u30eb"],"Text: the colour as text colour. Pill: a filled label with white text. Outlined: a bordered label.":["\u30c6\u30ad\u30b9\u30c8: \u3053\u306e\u8272\u3092\u6587\u5b57\u8272\u3068\u3057\u3066\u4f7f\u7528\u3057\u307e\u3059\u3002\u30d4\u30eb: \u767d\u6587\u5b57\u306e\u5857\u308a\u3064\u3076\u3057\u30e9\u30d9\u30eb\u3002\u30a2\u30a6\u30c8\u30e9\u30a4\u30f3: \u67a0\u7dda\u4ed8\u304d\u306e\u30e9\u30d9\u30eb\u3002"],"Reset for the active tier colour.":["\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u968e\u5c64\u306e\u8272\u306b\u623b\u3059\u306b\u306f\u30ea\u30bb\u30c3\u30c8\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Badge options":["\u30d0\u30c3\u30b8\u306e\u30aa\u30d7\u30b7\u30e7\u30f3"],"Include the WooCommerce sale discount":["WooCommerce \u306e\u30bb\u30fc\u30eb\u5272\u5f15\u3092\u542b\u3081\u308b"],"An existing sale discount counts towards the savings.":["\u65e2\u5b58\u306e\u30bb\u30fc\u30eb\u5272\u5f15\u3082\u7bc0\u7d04\u984d\u306b\u542b\u307e\u308c\u307e\u3059\u3002"],"Show for products without tiered pricing":["\u6bb5\u968e\u7684\u4fa1\u683c\u8a2d\u5b9a\u306e\u306a\u3044\u5546\u54c1\u306b\u3082\u8868\u793a"],"For regular sale products.":["\u901a\u5e38\u306e\u30bb\u30fc\u30eb\u5546\u54c1\u5411\u3051\u3002"],"Pricing summary":["\u4fa1\u683c\u6982\u8981"],"Summary block":["\u6982\u8981\u30d6\u30ed\u30c3\u30af"],"Quantity, price per item and total for the selected quantity, near the pricing layout.":["\u9078\u629e\u3057\u305f\u6570\u91cf\u306e\u6570\u91cf\u30011 \u500b\u3042\u305f\u308a\u306e\u4fa1\u683c\u3001\u5408\u8a08\u3092\u4fa1\u683c\u8a2d\u5b9a\u30ec\u30a4\u30a2\u30a6\u30c8\u306e\u8fd1\u304f\u306b\u8868\u793a\u3057\u307e\u3059\u3002"],"Show the pricing summary block":["\u4fa1\u683c\u6982\u8981\u30d6\u30ed\u30c3\u30af\u3092\u8868\u793a"],"e.g. Your order":["\u4f8b: \u3054\u6ce8\u6587\u5185\u5bb9"],"Each":["\u5358\u4fa1"],"A badge on the product image with the biggest discount the product's tiers give. Shows whether or not the pricing does, in the lists \"Where it shows\" allows.":["\u5546\u54c1\u306e\u968e\u5c64\u304c\u63d0\u4f9b\u3059\u308b\u6700\u5927\u306e\u5272\u5f15\u3092\u5546\u54c1\u753b\u50cf\u4e0a\u306e\u30d0\u30c3\u30b8\u3067\u8868\u793a\u3057\u307e\u3059\u3002\u300c\u8868\u793a\u3059\u308b\u5834\u6240\u300d\u3067\u8a31\u53ef\u3055\u308c\u305f\u4e00\u89a7\u3067\u306f\u3001\u4fa1\u683c\u8a2d\u5b9a\u306e\u8868\u793a\u306e\u6709\u7121\u306b\u304b\u304b\u308f\u3089\u305a\u8868\u793a\u3055\u308c\u307e\u3059\u3002"],"Show a bulk savings badge":["\u307e\u3068\u3081\u8cb7\u3044\u5272\u5f15\u30d0\u30c3\u30b8\u3092\u8868\u793a"],"Auto: the active tier colour.":["\u81ea\u52d5: \u30a2\u30af\u30c6\u30a3\u30d6\u306a\u968e\u5c64\u306e\u8272\u3002"],"The price shown in the product grid for products with tiered pricing.":["\u6bb5\u968e\u7684\u4fa1\u683c\u8a2d\u5b9a\u306e\u3042\u308b\u5546\u54c1\u306e\u5546\u54c1\u30b0\u30ea\u30c3\u30c9\u306b\u8868\u793a\u3055\u308c\u308b\u4fa1\u683c\u3067\u3059\u3002"],"Replace the regular price":["\u901a\u5e38\u4fa1\u683c\u3092\u7f6e\u304d\u63db\u3048\u308b"],"Show the lowest tier price or a price range instead.":["\u4ee3\u308f\u308a\u306b\u6700\u4f4e\u968e\u5c64\u4fa1\u683c\u307e\u305f\u306f\u4fa1\u683c\u7bc4\u56f2\u3092\u8868\u793a\u3057\u307e\u3059\u3002"],"Lowest and highest prices across all variations.":["\u3059\u3079\u3066\u306e\u30d0\u30ea\u30a8\u30fc\u30b7\u30e7\u30f3\u306e\u6700\u4f4e\u4fa1\u683c\u3068\u6700\u9ad8\u4fa1\u683c\u3067\u3059\u3002"],"Prefix for the lowest price":["\u6700\u4f4e\u4fa1\u683c\u306e\u63a5\u982d\u8f9e"],"Click a variable to insert it.":["\u5909\u6570\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u3068\u633f\u5165\u3055\u308c\u307e\u3059\u3002"],"Subtotal":["\u5c0f\u8a08"],"Cart totals":["\u30ab\u30fc\u30c8\u5408\u8a08"],"Shipping":["\u914d\u9001"],"Proceed to checkout":["\u304a\u652f\u6255\u3044\u3078\u9032\u3080"],"Tiered pricing is switched off for shop and category pages.":["\u30b7\u30e7\u30c3\u30d7\u3068\u30ab\u30c6\u30b4\u30ea\u30fc\u30da\u30fc\u30b8\u3067\u306f\u6bb5\u968e\u7684\u4fa1\u683c\u8a2d\u5b9a\u304c\u30aa\u30d5\u306b\u306a\u3063\u3066\u3044\u307e\u3059\u3002"],"The tooltip layout adds an icon next to the price; the pricing table appears when the customer hovers over it.":["\u30c4\u30fc\u30eb\u30c1\u30c3\u30d7\u30ec\u30a4\u30a2\u30a6\u30c8\u306f\u4fa1\u683c\u306e\u6a2a\u306b\u30a2\u30a4\u30b3\u30f3\u3092\u8ffd\u52a0\u3057\u3001\u9867\u5ba2\u304c\u30de\u30a6\u30b9\u30aa\u30fc\u30d0\u30fc\u3059\u308b\u3068\u4fa1\u683c\u8868\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002"],"Not shown automatically: the pricing layout appears where you place the shortcode, block or widget.":["\u81ea\u52d5\u3067\u306f\u8868\u793a\u3055\u308c\u307e\u305b\u3093: \u4fa1\u683c\u8a2d\u5b9a\u30ec\u30a4\u30a2\u30a6\u30c8\u306f\u30b7\u30e7\u30fc\u30c8\u30b3\u30fc\u30c9\u3001\u30d6\u30ed\u30c3\u30af\u3001\u307e\u305f\u306f\u30a6\u30a3\u30b8\u30a7\u30c3\u30c8\u3092\u914d\u7f6e\u3057\u305f\u5834\u6240\u306b\u8868\u793a\u3055\u308c\u307e\u3059\u3002"],"Shop & category pages":["\u30b7\u30e7\u30c3\u30d7\u3068\u30ab\u30c6\u30b4\u30ea\u30fc\u30da\u30fc\u30b8"],"Cart & Checkout":["\u30ab\u30fc\u30c8\u3068\u304a\u652f\u6255\u3044"],"Product page":["\u5546\u54c1\u30da\u30fc\u30b8"],"Layout preview":["\u30ec\u30a4\u30a2\u30a6\u30c8\u30d7\u30ec\u30d3\u30e5\u30fc"],"The real product page may look a bit different, depending on your theme.":["\u5b9f\u969b\u306e\u5546\u54c1\u30da\u30fc\u30b8\u306f\u3001\u30c6\u30fc\u30de\u306b\u3088\u3063\u3066\u591a\u5c11\u898b\u305f\u76ee\u304c\u7570\u306a\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002"],"You can try it here; the store shows the columns with premium only.":["\u3053\u3053\u3067\u8a66\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c8\u30a2\u3067\u306f\u30d7\u30ec\u30df\u30a2\u30e0\u7248\u3067\u306e\u307f\u5217\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002"],"Extra columns for every tier: total price, saving per item, price including tax or your own values. Columns are saved with their own button and show up in the preview once saved.":["\u5404\u968e\u5c64\u306b\u8ffd\u52a0\u306e\u5217\u3092\u8868\u793a\u3057\u307e\u3059: \u5408\u8a08\u4fa1\u683c\u30011 \u500b\u3042\u305f\u308a\u306e\u7bc0\u7d04\u984d\u3001\u7a0e\u8fbc\u4fa1\u683c\u3001\u307e\u305f\u306f\u72ec\u81ea\u306e\u5024\u3002\u5217\u306f\u5c02\u7528\u306e\u30dc\u30bf\u30f3\u3067\u4fdd\u5b58\u3055\u308c\u3001\u4fdd\u5b58\u3059\u308b\u3068\u30d7\u30ec\u30d3\u30e5\u30fc\u306b\u8868\u793a\u3055\u308c\u307e\u3059\u3002"]}}}