{"translation-revision-date":"2026-10-28T13:31:01+00:00","generator":"WP-CLI\/2.12.0","source":"src\/Addons\/Tools\/js-source\/components\/PricingTest.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ru_RU","plural-forms":"nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);"},"Quantity":["\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e"],"Discount":["\u0421\u043a\u0438\u0434\u043a\u0430"],"Rule":["\u041f\u0440\u0430\u0432\u0438\u043b\u043e"],"Priority %d":["\u041f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442 %d"],"Not published":["\u041d\u0435 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043e"],"Suspended":["\u041f\u0440\u0438\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0439"],"Expired":["\u0418\u0441\u0442\u0435\u043a\u043b\u043e"],"Scheduled":["\u0417\u0430\u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043e"],"Global pricing rules":["\u0413\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0446\u0435\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f"],"Product":["\u041f\u0440\u043e\u0434\u0443\u043a\u0442"],"Total":["\u041e\u0431\u0449\u0438\u0439"],"Customer":["\u041a\u043b\u0438\u0435\u043d\u0442"],"Pick a product first.":["\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0442\u043e\u0432\u0430\u0440."],"Visitor (not logged in)":["\u041f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u043b\u044c (\u0431\u0435\u0437 \u0432\u0445\u043e\u0434\u0430)"],"Selected":["\u0412\u044b\u0431\u0440\u0430\u043d\u043e"],"Matches and is applied":["\u041f\u043e\u0434\u0445\u043e\u0434\u0438\u0442 \u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f"],"Matches, but product pricing is applied":["\u041f\u043e\u0434\u0445\u043e\u0434\u0438\u0442, \u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u0446\u0435\u043d\u044b \u0442\u043e\u0432\u0430\u0440\u0430"],"Matches, but a higher-priority rule is applied":["\u041f\u043e\u0434\u0445\u043e\u0434\u0438\u0442, \u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0430\u0432\u0438\u043b\u043e \u0441 \u0431\u043e\u043b\u0435\u0435 \u0432\u044b\u0441\u043e\u043a\u0438\u043c \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u043e\u043c"],"Matches, but changes nothing":["\u041f\u043e\u0434\u0445\u043e\u0434\u0438\u0442, \u043d\u043e \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043c\u0435\u043d\u044f\u0435\u0442"],"Would match":["\u041f\u043e\u0434\u043e\u0448\u043b\u043e \u0431\u044b"],"Does not match":["\u041d\u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442"],"%1$s matches, but the prices come from %2$s because of the rule's priority settings.":["%1$s \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442, \u043d\u043e \u0438\u0437-\u0437\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0430 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0446\u0435\u043d\u044b \u0437\u0430\u0434\u0430\u0435\u0442 %2$s."],"The prices come from %s.":["\u0426\u0435\u043d\u044b \u0437\u0430\u0434\u0430\u0435\u0442 \u043f\u0440\u0430\u0432\u0438\u043b\u043e \u00ab%s\u00bb."],"No global pricing rule matches this product for this customer.":["\u041d\u0438 \u043e\u0434\u043d\u043e \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u043e\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u043e \u0446\u0435\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u043d\u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442 \u044d\u0442\u043e\u043c\u0443 \u0442\u043e\u0432\u0430\u0440\u0443 \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043a\u043b\u0438\u0435\u043d\u0442\u0430."],"No global pricing rule takes part: the Global pricing rules add-on is switched off.":["\u0413\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0446\u0435\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u043d\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u044e\u0442: \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u00ab\u0413\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0446\u0435\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\u00bb \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u043e."],"Source of the prices: %s.":["\u0418\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u0446\u0435\u043d: %s."],"Quantity limits: %s.":["\u041e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430: %s."],"No quantity limits.":["\u0411\u0435\u0437 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0439 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430."],"Price per item":["\u0426\u0435\u043d\u0430 \u0437\u0430 \u0448\u0442\u0443\u043a\u0443"],"Verdict":["\u0412\u0435\u0440\u0434\u0438\u043a\u0442"],"Why":["\u041f\u043e\u0447\u0435\u043c\u0443"],"The rule you came from":["\u041f\u0440\u0430\u0432\u0438\u043b\u043e, \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0432\u044b \u043f\u0440\u0438\u0448\u043b\u0438"],"for":["\u0434\u043b\u044f"],"What the customer pays":["\u0421\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u043b\u0430\u0442\u0438\u0442 \u043a\u043b\u0438\u0435\u043d\u0442"],"Rules are matched in priority order: the lowest number first, and the newer rule first when numbers are equal. The first active rule that matches is applied.":["\u041f\u0440\u0430\u0432\u0438\u043b\u0430 \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0432 \u043f\u043e\u0440\u044f\u0434\u043a\u0435 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0430: \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0438\u0439 \u043d\u043e\u043c\u0435\u0440, \u0430 \u043f\u0440\u0438 \u0440\u0430\u0432\u043d\u044b\u0445 \u043d\u043e\u043c\u0435\u0440\u0430\u0445 \u2014 \u0431\u043e\u043b\u0435\u0435 \u043d\u043e\u0432\u043e\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u043e. \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u0435\u0440\u0432\u043e\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442."],"The Global pricing rules add-on is switched off (see the modules above), so no rule takes part in pricing.":["\u0414\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u00ab\u0413\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0446\u0435\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\u00bb \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u043e (\u0441\u043c. \u043c\u043e\u0434\u0443\u043b\u0438 \u0432\u044b\u0448\u0435), \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043d\u0438 \u043e\u0434\u043d\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u043e \u043d\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442 \u0432 \u0446\u0435\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0438."],"There are no global pricing rules yet.":["\u0413\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u044b\u0445 \u043f\u0440\u0430\u0432\u0438\u043b \u0446\u0435\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u043a\u0430 \u043d\u0435\u0442."],"Add a pricing rule":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043f\u0440\u0430\u0432\u0438\u043b\u043e \u0446\u0435\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f"],"Pricing log":["\u0416\u0443\u0440\u043d\u0430\u043b \u0446\u0435\u043d"],"Pricing Test":["\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0446\u0435\u043d"],"See what a customer pays for a product without opening the storefront: which global pricing rule applies and why, which one wins when several match, and the prices per quantity.":["\u0423\u0437\u043d\u0430\u0439\u0442\u0435, \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043a\u043b\u0438\u0435\u043d\u0442 \u043f\u043b\u0430\u0442\u0438\u0442 \u0437\u0430 \u0442\u043e\u0432\u0430\u0440, \u043d\u0435 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044f \u0432\u0438\u0442\u0440\u0438\u043d\u0443: \u043a\u0430\u043a\u043e\u0435 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u043e\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u043e \u0446\u0435\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0438 \u043f\u043e\u0447\u0435\u043c\u0443, \u043a\u0430\u043a\u043e\u0435 \u043f\u043e\u0431\u0435\u0436\u0434\u0430\u0435\u0442, \u0435\u0441\u043b\u0438 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e, \u0438 \u0446\u0435\u043d\u044b \u043f\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0443."],"Checking the rule":["\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u043f\u0440\u0430\u0432\u0438\u043b\u0430"],"Pick a product and a customer; the rule is highlighted in the results.":["\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0442\u043e\u0432\u0430\u0440 \u0438 \u043a\u043b\u0438\u0435\u043d\u0442\u0430; \u043f\u0440\u0430\u0432\u0438\u043b\u043e \u0431\u0443\u0434\u0435\u0442 \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u043e \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u0445."],"Type to search products and variations.":["\u041d\u0430\u0447\u043d\u0438\u0442\u0435 \u0432\u0432\u043e\u0434\u0438\u0442\u044c \u0434\u043b\u044f \u043f\u043e\u0438\u0441\u043a\u0430 \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0438 \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u0439."],"A customer":["\u041a\u043b\u0438\u0435\u043d\u0442"],"Which customer":["\u041a\u0430\u043a\u043e\u0439 \u043a\u043b\u0438\u0435\u043d\u0442"],"Type a name or an email address.":["\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0438\u043c\u044f \u0438\u043b\u0438 \u0430\u0434\u0440\u0435\u0441 e-mail."],"The test could not run. Reload the page and try again.":["\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443. \u041f\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0435 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u0438 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0435 \u0440\u0430\u0437."],"Testing\u2026":["\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430\u2026"],"Run the test":["\u0417\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443"],"Rules are tested as they are saved.":["\u041f\u0440\u0430\u0432\u0438\u043b\u0430 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u044e\u0442\u0441\u044f \u0432 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043d\u043e\u043c \u0432\u0438\u0434\u0435."]}}}