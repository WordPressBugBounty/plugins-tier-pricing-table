msgid "Maximum order quantity for the product is %s"
msgstr "La quantité maximale de commande pour le produit est %s"

#: src/Addons/CartUpsells/CartUpsellsAddon.php:9
msgid "Next tier message in the cart"
msgstr "Message du niveau suivant dans le panier"

#: src/Addons/CartUpsells/CartUpsellsAddon.php:13
msgid "\"Add 13 more to get $14.50 each\" under cart items, with a one-click quantity link and a progress bar."
msgstr "« Ajoutez-en 13 de plus pour 14,50 $ l'unité » sous les articles du panier, avec un lien de quantité en un clic et une barre de progression."

#: src/Addons/CartUpsells/CartUpsellsService.php:235 src/Addons/CartUpsells/UpsellsSubsection.php:43 src/Addons/LayoutConfigurator/LayoutConfigurator.php:411
msgid "Add <b>{tp_required_quantity}</b> more to get <b>{tp_next_price}</b> each"
msgstr "Ajoutez-en <b>{tp_required_quantity}</b> de plus pour obtenir <b>{tp_next_price}</b> l'unité"

#: src/Addons/CartUpsells/UpsellsSubsection.php:11
msgid "Cart Upsell Messages"
msgstr "Messages de vente incitative du panier"

#: src/Addons/CartUpsells/UpsellsSubsection.php:15
msgid "Display targeted messages in the cart to encourage customers to reach the next discount tier."
msgstr "Affichez des messages ciblés dans le panier pour encourager les clients à atteindre le niveau de remise suivant."

#: src/Addons/CartUpsells/UpsellsSubsection.php:26
msgid "Enable cart upsells"
msgstr "Activer les ventes incitatives de panier"

#: src/Addons/CartUpsells/UpsellsSubsection.php:34 src/Addons/ProductCatalogLoop/Settings/ProductCatalogLoopSettingsSection.php:468
msgid "Template"
msgstr "Modèle"

#: src/Addons/CartUpsells/UpsellsSubsection.php:49
msgid "Quantity link"
msgstr "Lien sur la quantité"

#: src/Addons/CartUpsells/UpsellsSubsection.php:54
msgid "The required quantity in the message is a link: one click sets the cart line to the next tier and updates the cart."
msgstr "La quantité requise dans le message est un lien : un clic passe la ligne du panier au niveau suivant et met à jour le panier."

#: src/Addons/CartUpsells/UpsellsSubsection.php:58 src/Addons/GlobalTieredPricing/CPT/Form/Tabs/OrderShipping.php:82
msgid "Progress bar"
msgstr "Barre de progression"

#: src/Addons/CartUpsells/UpsellsSubsection.php:63
msgid "Show a bar under the message that fills up as the quantity approaches the next tier."
msgstr "Affiche sous le message une barre qui se remplit à mesure que la quantité approche du niveau suivant."

#: src/Addons/CartUpsells/UpsellsSubsection.php:67
msgid "Upsell text color"
msgstr "Couleur du texte de vente incitative"

#: src/Addons/CartUpsells/UpsellsSubsection.php:73
msgid "Note: This feature is not compatible with the Gutenberg Cart/Checkout blocks."
msgstr "Remarque : Cette fonctionnalité n'est pas compatible avec les blocs Gutenberg Cart/Checkout."

