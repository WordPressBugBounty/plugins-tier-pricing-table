msgstr "Текст, отображаемый перед самой низкой ценой (например, <b>От 10 долларов США</b>)."

#: src/Addons/CatalogPrices/CatalogPricesSubsection.php:89 src/Addons/LayoutConfigurator/LayoutConfigurator.php:846 src/Addons/ProductCatalogLoop/ProductCatalogLoop.php:461
msgid "Lowest price"
msgstr "Самая низкая цена"

#: src/Addons/CatalogPrices/CatalogPricesSubsection.php:90
msgid "{tp_lowest_price} - lowest available tier price."
msgstr "{tp_lowest_price} — самая низкая доступная цена уровня."

#: src/Addons/CatalogPrices/CatalogPricesSubsection.php:94
msgid "Prices range"
msgstr "Диапазон цен"

#: src/Addons/CatalogPrices/CatalogPricesSubsection.php:95
msgid "{tp_prices_range} - price range from lowest tier to original price."
msgstr "{tp_prices_range} — диапазон цен от самого низкого уровня до исходной цены."

#: src/Addons/CatalogPrices/CatalogPricesSubsection.php:99
msgid "Original price"
msgstr "Исходная цена"

#: src/Addons/CatalogPrices/CatalogPricesSubsection.php:100
