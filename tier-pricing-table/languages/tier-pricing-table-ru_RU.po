#: src/Addons/CartUpsells/CartUpsellsAddon.php:9
msgid "Cart Upsells"
msgstr "Корзина"

#: src/Addons/CartUpsells/CartUpsellsAddon.php:13
msgid "Display an upsell message in the cart indicating how many items are needed to reach the next pricing tier."
msgstr "Отобразите в корзине сообщение о допродаже, указывающее, сколько товаров необходимо для перехода на следующий ценовой уровень."

#: src/Addons/CartUpsells/CartUpsellsService.php:229 src/Addons/CartUpsells/UpsellsSubsection.php:43 src/Addons/LayoutConfigurator/LayoutConfigurator.php:407
msgid "Add <b>{tp_required_quantity}</b> more to get <b>{tp_next_price}</b> each"
msgstr "Добавьте еще <b>{tp_required_quantity}</b>, чтобы получить цену <b>{tp_next_price}</b> за шт."

#: src/Addons/CartUpsells/UpsellsSubsection.php:11
msgid "Cart Upsell Messages"
msgstr "Сообщения о допродаже корзины"

#: src/Addons/CartUpsells/UpsellsSubsection.php:15
msgid "Display targeted messages in the cart to encourage customers to reach the next discount tier."
msgstr "Отображайте целевые сообщения в корзине, чтобы побудить клиентов перейти на следующий уровень скидки."

#: src/Addons/CartUpsells/UpsellsSubsection.php:26
msgid "Enable cart upsells"
msgstr "Включить дополнительные продажи в корзине"

#: src/Addons/CartUpsells/UpsellsSubsection.php:34 src/Addons/ProductCatalogLoop/Settings/ProductCatalogLoopSettingsSection.php:468
msgid "Template"
msgstr "Шаблон"

#: src/Addons/CartUpsells/UpsellsSubsection.php:49
msgid "Quantity link"
msgstr "Ссылка на количестве"

#: src/Addons/CartUpsells/UpsellsSubsection.php:54
msgid "The required quantity in the message is a link: one click sets the cart line to the next tier and updates the cart."
msgstr "Нужное количество в сообщении — ссылка: один клик переводит строку корзины на следующий уровень и обновляет корзину."

#: src/Addons/CartUpsells/UpsellsSubsection.php:58
msgid "Progress bar"
msgstr "Индикатор прогресса"

#: src/Addons/CartUpsells/UpsellsSubsection.php:63
msgid "Show a bar under the message that fills up as the quantity approaches the next tier."
msgstr "Показывать под сообщением полосу, которая заполняется по мере приближения количества к следующему уровню."

#: src/Addons/CartUpsells/UpsellsSubsection.php:67
msgid "Upsell text color"
msgstr "Цвет текста допродажи"

#: src/Addons/CartUpsells/UpsellsSubsection.php:73
msgid "Note: This feature is not compatible with the Gutenberg Cart/Checkout blocks."
msgstr "Примечание. Эта функция несовместима с блоками корзины/оформления заказа Gutenberg."

