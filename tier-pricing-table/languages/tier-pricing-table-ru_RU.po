#: src/Addons/CatalogPrices/CatalogPricesSubsection.php:57 src/Addons/LayoutConfigurator/LayoutConfigurator.php:848
#, php-format
msgid "e.g. From %s"
msgstr "напр. От %s"

#. translators: 1: lowest example price, 2: highest example price
#: src/Addons/CatalogPrices/CatalogPricesSubsection.php:59 src/Addons/LayoutConfigurator/LayoutConfigurator.php:853
#, php-format
msgid "e.g. %1$s - %2$s"
msgstr "напр. %1$s - %2$s"

#: src/Addons/CatalogPrices/CatalogPricesSubsection.php:60
