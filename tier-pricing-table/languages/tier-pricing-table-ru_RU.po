msgid "Show lowest price"
msgstr "Показать самую низкую цену"

#: src/Addons/CatalogPrices/CatalogPricesSubsection.php:52
msgid "Show range (lowest to highest)"
msgstr "Показать диапазон (от низшего к высшему)"

#: src/Addons/CatalogPrices/CatalogPricesSubsection.php:53 src/Addons/CatalogPrices/CatalogPricesSubsection.php:65 src/Addons/LayoutConfigurator/LayoutConfigurator.php:856 src/Addons/LayoutConfigurator/build/index.js:1 src/Addons/LayoutConfigurator/js-source/components/Controls.js:1225
msgid "Custom template"
msgstr "Пользовательский шаблон"

