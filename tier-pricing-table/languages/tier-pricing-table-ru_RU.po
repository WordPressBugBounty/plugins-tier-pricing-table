#: src/Integrations/Plugins/WPAllImport.php:105 src/Integrations/Plugins/WPAllImport.php:211
msgid "Fixed Tiered prices"
msgstr "Фиксированные многоуровневые цены"

#: src/Integrations/Plugins/WPAllImport.php:108 src/Integrations/Plugins/WPAllImport.php:216
msgid "The format for the rules must be the following: quantity:price,quantity:price. For example: \"10:5,20:15\" where 10 and 20 are quantities and 5 and 15 are prices for those quantities."
msgstr "Формат правил должен быть следующий: количество:цена,количество:цена. Например: «10:5,20:15», где 10 и 20 — количество, а 5 и 15 — цены на это количество."

#: src/Integrations/Plugins/WPAllImport.php:112 src/Integrations/Plugins/WPAllImport.php:221
msgid "Percentage Tiered prices"
msgstr "Процентные многоуровневые цены"

#: src/Integrations/Plugins/WPAllImport.php:115 src/Integrations/Plugins/WPAllImport.php:226
msgid "Format for the rules must be the following: quantity:percent_discount,quantity:percent_discount. For example: \"10:5,20:15\" where 10 and 20 are quantities and 5 and 15 are amounts of discount."
msgstr "Формат правил должен быть следующий: количество:процент_скидка,количество:процент_скидка. Например: «10:5,20:15», где 10 и 20 — количество, а 5 и 15 — суммы скидки."

#: src/Integrations/Plugins/WPAllImport.php:119 src/Integrations/Plugins/WPAllImport.php:231
msgid "Amount-off Tiered prices"
msgstr "Многоуровневые цены со скидкой суммой"

#: src/Integrations/Plugins/WPAllImport.php:122 src/Integrations/Plugins/WPAllImport.php:236
msgid "Format for the rules must be the following: quantity:amount_off,quantity:amount_off. For example: \"10:5,20:15\" where 10 and 20 are quantities and 5 and 15 are the amounts taken off the price of each unit."
msgstr "Формат правил должен быть следующим: количество:сумма_скидки,количество:сумма_скидки. Например: «10:5,20:15», где 10 и 20 — количества, а 5 и 15 — суммы, вычитаемые из цены каждой единицы."

#: src/Integrations/Plugins/WPAllImport.php:134 src/Integrations/Plugins/WPAllImport.php:250
msgid "The field must be \"fixed\", \"percentage\" or \"amount\"."
msgstr "Поле должно содержать «fixed», «percentage» или «amount»."

#: src/Integrations/Plugins/WPAllImport.php:137 src/Integrations/Plugins/WPAllImport.php:254
msgid "Minimum product quantity"
msgstr "Минимальное количество товара"

#: src/Integrations/Plugins/WPAllImport.php:142 src/Integrations/Plugins/WPAllImport.php:261
