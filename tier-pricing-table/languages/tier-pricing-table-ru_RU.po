#. Plugin Name of the plugin
#: tier-pricing-table.php
msgid "WooCommerce Tiered Price Table"
msgstr "Многоуровневая таблица цен WooCommerce"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: tier-pricing-table.php
msgid "https://tiered-pricing.com/"
msgstr "https://tiered-pricing.com/"

#. Description of the plugin
#: tier-pricing-table.php
msgid "Quantity-based discounts with nice-looking reflection on the product page."
msgstr "Скидки в зависимости от количества с красивым отражением на странице продукта."

#. Author of the plugin
#: tier-pricing-table.php
msgid "U2Code"
msgstr "U2Код"

#: src/Addons/AdvancedQuantityOptions/AdvancedQuantityOptionsAddon.php:13
msgid "Maximum and quantity step"
msgstr "Максимум и шаг количества"

#: src/Addons/AdvancedQuantityOptions/AdvancedQuantityOptionsAddon.php:17
msgid "Adds a maximum order quantity and a quantity step, such as packs of 10, to products and rules."
msgstr "Добавляет к товарам и правилам максимальное количество в заказе и шаг количества, например упаковки по 10."

#: src/Addons/AdvancedQuantityOptions/AdvancedQuantityOptionsForm.php:111
msgid "Additional quantity options"
msgstr "Дополнительные параметры количества"

#: src/Addons/AdvancedQuantityOptions/AdvancedQuantityOptionsForm.php:131 src/Addons/AdvancedQuantityOptions/AdvancedQuantityOptionsForm.php:147 views/admin/components/minimum-order-quantity-form.php:19
msgid "Leave blank for no restrictions"
msgstr "Оставьте пустым, чтобы не было ограничений"

#: src/Addons/AdvancedQuantityOptions/AdvancedQuantityOptionsForm.php:133
msgid "Maximum order quantity"
msgstr "Максимальный объем заказа"

#: src/Addons/AdvancedQuantityOptions/AdvancedQuantityOptionsForm.php:134
msgid "The maximum quantity of the product a customer can order in a single transaction."
msgstr "Максимальное количество товара, которое клиент может заказать за одну транзакцию."

#: src/Addons/AdvancedQuantityOptions/AdvancedQuantityOptionsForm.php:146
msgid "Quantity step"
msgstr "Количественный шаг"

#: src/Addons/AdvancedQuantityOptions/AdvancedQuantityOptionsForm.php:149
msgid "Requires the product to be purchased in multiples of X."
msgstr "Требуется, чтобы продукт был приобретен в количестве, кратном X."

#. translators: %1$s: item name, %2$s: minimum quantity
#: src/Addons/AdvancedQuantityOptions/QuantityManager.php:51
#, php-format
msgid "Maximum quantity for the %1$s is %2$d"
msgstr "Максимальное количество для %1$s — %2$d."

#. translators: %s: quantity step
#: src/Addons/AdvancedQuantityOptions/QuantityManager.php:60 src/Addons/AdvancedQuantityOptions/QuantityManager.php:136 src/Addons/AdvancedQuantityOptions/QuantityManager.php:215 src/Addons/AdvancedQuantityOptions/QuantityManager.php:250
#, php-format
msgid "Order quantity must be multiple of %s"
msgstr "Количество заказа должно быть кратно %s."

#. translators: %s: maximum quantity
#: src/Addons/AdvancedQuantityOptions/QuantityManager.php:125 src/Addons/AdvancedQuantityOptions/QuantityManager.php:203 src/Addons/AdvancedQuantityOptions/QuantityManager.php:244
#, php-format
msgid "Maximum order quantity for the product is %s"
msgstr "Максимальный объем заказа продукта составляет %s."

#: src/Addons/CartUpsells/CartUpsellsAddon.php:9
msgid "Next tier message in the cart"
msgstr "Сообщение о следующем уровне в корзине"

#: src/Addons/CartUpsells/CartUpsellsAddon.php:13
msgid "\"Add 13 more to get $14.50 each\" under cart items, with a one-click quantity link and a progress bar."
msgstr "«Добавьте ещё 13 и получите по 14,50 $ за штуку» под товарами в корзине, со ссылкой для изменения количества в один клик и индикатором выполнения."

#: src/Addons/CartUpsells/CartUpsellsService.php:235 src/Addons/CartUpsells/UpsellsSubsection.php:43 src/Addons/LayoutConfigurator/LayoutConfigurator.php:411
msgid "Add <b>{tp_required_quantity}</b> more to get <b>{tp_next_price}</b> each"
msgstr "Добавьте еще <b>{tp_required_quantity}</b>, чтобы получить цену <b>{tp_next_price}</b> за шт."

#: src/Addons/CartUpsells/UpsellsSubsection.php:11
msgid "Cart Upsell Messages"
msgstr "Сообщения о допродаже корзины"

#: src/Addons/CartUpsells/UpsellsSubsection.php:15
msgid "Display targeted messages in the cart to encourage customers to reach the next discount tier."
msgstr "Отображайте целевые сообщения в корзине, чтобы побудить клиентов перейти на следующий уровень скидки."

#: src/Addons/CartUpsells/UpsellsSubsection.php:26
msgid "Enable cart upsells"
msgstr "Включить дополнительные продажи в корзине"

#: src/Addons/CartUpsells/UpsellsSubsection.php:34 src/Addons/ProductCatalogLoop/Settings/ProductCatalogLoopSettingsSection.php:468
msgid "Template"
msgstr "Шаблон"

#: src/Addons/CartUpsells/UpsellsSubsection.php:49
msgid "Quantity link"
msgstr "Ссылка на количестве"

#: src/Addons/CartUpsells/UpsellsSubsection.php:54
msgid "The required quantity in the message is a link: one click sets the cart line to the next tier and updates the cart."
msgstr "Нужное количество в сообщении — ссылка: один клик переводит строку корзины на следующий уровень и обновляет корзину."

#: src/Addons/CartUpsells/UpsellsSubsection.php:58 src/Addons/GlobalTieredPricing/CPT/Form/Tabs/OrderShipping.php:82
msgid "Progress bar"
msgstr "Индикатор прогресса"

#: src/Addons/CartUpsells/UpsellsSubsection.php:63
msgid "Show a bar under the message that fills up as the quantity approaches the next tier."
msgstr "Показывать под сообщением полосу, которая заполняется по мере приближения количества к следующему уровню."

#: src/Addons/CartUpsells/UpsellsSubsection.php:67
msgid "Upsell text color"
msgstr "Цвет текста допродажи"

#: src/Addons/CartUpsells/UpsellsSubsection.php:73
msgid "Note: This feature is not compatible with the Gutenberg Cart/Checkout blocks."
msgstr "Примечание. Эта функция несовместима с блоками корзины/оформления заказа Gutenberg."

#: src/Addons/CatalogPrices/CatalogPricesAddon.php:9
msgid "Lowest price and price range"
msgstr "Минимальная цена и диапазон цен"

#: src/Addons/CatalogPrices/CatalogPricesAddon.php:13
msgid "Shows \"From $19.80\" or a price range for products with tiers, in the shop and as the product page price."
msgstr "Показывает «От 19,80 $» или диапазон цен для товаров с уровнями в магазине и в качестве цены на странице товара."

#: src/Addons/CatalogPrices/CatalogPricesService.php:41 src/Addons/CatalogPrices/CatalogPricesService.php:46 src/Addons/CatalogPrices/CatalogPricesSubsection.php:68 src/Addons/LayoutConfigurator/LayoutConfigurator.php:402 src/Addons/LayoutConfigurator/LayoutPreview.php:436 src/Managers/FormatPriceManager.php:281
msgid "From {tp_lowest_price} instead of {tp_original_price}"
msgstr "От {tp_lowest_price} вместо {tp_original_price}"

#: src/Addons/CatalogPrices/CatalogPricesSubsection.php:13
msgid "Shop & Categories Price Format"
msgstr "Магазин и категории Формат цен"

#: src/Addons/CatalogPrices/CatalogPricesSubsection.php:18
msgid "Manage how the main product price string is formatted in shop pages, categories, and widgets."
msgstr "Управляйте форматированием основной строки цены продукта на страницах магазина, в категориях и виджетах."

#: src/Addons/CatalogPrices/CatalogPricesSubsection.php:29
msgid "Override default price display"
msgstr "Переопределить отображение цены по умолчанию"

#: src/Addons/CatalogPrices/CatalogPricesSubsection.php:33
msgid "Replace the standard WooCommerce price with a custom lowest price or price range."
msgstr "Замените стандартную цену WooCommerce на пользовательскую самую низкую цену или диапазон цен."

